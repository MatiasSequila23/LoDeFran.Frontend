@page "/Cocina/Preparacion"
@inject Services.PedidoService PedidoService
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.DetallePedidoServicie DetallePedidoServicie
@inject NavigationManager Nav
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Services
@using LoDeFran.Frontend.Utlis

<div class="container mt-3">
    <div class="card shadow-sm">
        <div class="card-header bg-dark  d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white">🍳 Pedidos en Cocina</h4>
            <button class="btn btn-light btn-sm" @onclick="CargarPedidos" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    @:Actualizando...
                }
                else
                {
                    @:🔄 Actualizar
                }
            </button>
        </div>

        <div class="card-body">
            @if (!pedidosCargados)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando pedidos...</p>
                </div>
            }
            else if (Pedidos == null || !Pedidos.Any())
            {
                <div class="alert alert-info text-center text-white">
                    No hay pedidos pendientes en cocina.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var pedido in Pedidos)
                    {
                        <div class="col-md-6">
                            <div class="card mb-3 shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>
                                            @if (pedido.TipoPedidoNombre?.ToLower() == "mesa")
                                            {
                                                <text>Mesa @pedido.Mesa?.Numero</text>
                                            }
                                            else
                                            {
                                                <text>@pedido.TipoPedidoNombre</text>
                                            }
                                        </strong>
                                        <span class="text-muted">- Pedido #@pedido.Id</span>
                                    </div>
                                    <span class="badge bg-secondary">
                                        Estado: @((Enums.EstadoPedido)pedido.EstadoId)
                                    </span>
                                </div>
                                <div class="card-body">
                                    <ul class="mb-3">
                                        @foreach (var item in pedido.DetallePedido)
                                        {
                                            <li>@item.Producto.Nombre x @item.Cantidad</li>
                                        }

                                        @foreach (var item in pedido.PedidoCombos)
                                        {
                                            foreach (var prod in item.Items)
                                            {
                                                <li>
                                                    @prod.NombreProducto
                                                    @if (!string.IsNullOrWhiteSpace(item.Nombre))
                                                    {
                                                        <span class="text-muted">(de combo @item.Nombre)</span>
                                                    }
                                                    x @prod.Cantidad
                                                </li>
                                            }
                                        }
                                    </ul>

                                    @if (pedido.EstadoId == (int)Enums.EstadoPedido.EnPreparacion)
                                    {
                                        <button class="btn btn-success btn-sm" @onclick="() => CambiarEstado(pedido.Id, Enums.EstadoPedido.ListoParaEntregar)">
                                            ✅ Marcar como Listo para Entregar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PedidoViewModel>? Pedidos;
    private bool isLoading = false;
    private bool pedidosCargados = false;

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("destroyDataTable", "tablaPedidos");
        await JS.InvokeVoidAsync("destroyDataTable", "tablaCaja");
        await CargarPedidos();
    }

    private async Task CargarPedidos()
    {
        isLoading = true;
        pedidosCargados = false;

        try
        {
            Pedidos = await ServicioDeMesaService.ObtenerPedidoCocina();
            pedidosCargados = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CambiarEstado(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);

        var pedidoSel = Pedidos?.FirstOrDefault(z => z.Id == idPedido);
        if (pedidoSel != null)
        {
            foreach (var det in pedidoSel.DetallePedido)
            {
                if (det.EstadoCocinaId == (int)Enums.EstadoDetallePedidoCocina.EnPreparacion)
                {
                    await DetallePedidoServicie.ActualizarEstadoCocinaAsync(det.Id, (int)Enums.EstadoDetallePedidoCocina.Preparado);
                }
            }
        }

        await CargarPedidos();
    }
}
