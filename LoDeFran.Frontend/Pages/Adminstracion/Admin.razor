@page "/Administracion/admin"
@inject Services.ServicioDeMesaService ServicioDeMesaService
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Services
@using LoDeFran.Frontend.Pages.Pedido

<h3>Panel de Administración</h3>

<ul class="nav nav-tabs mt-4">
    <li class="nav-item">
        <button class="nav-link @(vistaActual == "mesas" ? "active" : "")" @onclick=@(() => vistaActual = "mesas")>Mesas</button>
    </li>
   
    <li class="nav-item">
        <button class="nav-link @(vistaActual == "mostrador" ? "active" : "")" @onclick=@(() => vistaActual = "mostrador")>Pedidos mostrador</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(vistaActual == "delivery" ? "active" : "")" @onclick=@(() => vistaActual = "delivery")>Pedidos delivery</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(vistaActual == "cocina" ? "active" : "")" @onclick=@(() => vistaActual = "cocina")>Cocina</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(vistaActual == "caja" ? "active" : "")" @onclick=@(() => vistaActual = "caja")>Caja</button>
    </li>
</ul>

<div class="mt-4">
   
    @if (vistaActual == "mesas")
    {
        <LoDeFran.Frontend.Pages.Mesa.MesasAdmin />
    }
    else if (vistaActual == "mostrador")
    {
        <PedidoMostrador />
    }
    else if (vistaActual == "delivery")
    {
        <PedidoDelivery />
    }
    else if (vistaActual == "cocina")
    {
    <LoDeFran.Frontend.Pages.Cocina.Preparacion />
    }
    else if (vistaActual == "caja")
    {
    <LoDeFran.Frontend.Pages.Caja.Cobranza />
    }
</div>

@code {
    private string vistaActual = "mesas";
}
