@page "/cliente/clientes"
@inject Services.ClienteService ClienteService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<h3 class="mt-4 mb-4">Gestión de Clientes</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo"><i class="fas fa-user-plus"></i> Nuevo Cliente</button>

@if (!clientesCargados)
{
    <div class="text-center">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    @* En tu HTML *@
    <table class="table table-striped table-hover" id="tablaClientes" @key="claveTabla">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Fidelidad</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.Apellido</td>
                    <td>@c.Telefono</td>
                    <td>@c.Email</td>
                    <td>@($"{c.Calle} {c.Altura}, {c.Piso}")</td>
                    <td>@(c.PuntosFidelidad ?? 0)</td>
                    <td>@(c.FechaCreacion?.ToShortDateString())</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Editar(c)"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(c.Id)"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modal Nuevo Cliente -->
<div class="modal fade" id="modalNuevoCliente" tabindex="-1" aria-labelledby="modalNuevoClienteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNuevoClienteLabel">@((clienteEditar.Id == 0) ? "Agregar Cliente" : "Editar Cliente")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input class="form-control mb-2" placeholder="Nombre" @bind="clienteEditar.Nombre" />
                <input class="form-control mb-2" placeholder="Apellido" @bind="clienteEditar.Apellido" />
                <input class="form-control mb-2" placeholder="Teléfono" @bind="clienteEditar.Telefono" />
                <input class="form-control mb-2" placeholder="Email" @bind="clienteEditar.Email" />

                <select id="selectCalle" class="form-control mb-2" style="width: 100%"></select>

                <input class="form-control mb-2" placeholder="Altura" @bind="clienteEditar.Altura" />
                <input class="form-control mb-2" placeholder="Piso" @bind="clienteEditar.Piso" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

@code {
    Guid claveTabla = Guid.NewGuid();
    List<ClienteViewModel> clientes = new();
    ClienteViewModel clienteEditar = new();
    bool clientesCargados = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    async Task CargarClientes()
    {
        clientesCargados = false;

        await JS.InvokeVoidAsync("destroyDataTable", "tablaClientes");

        clientes = await ClienteService.GetClientesAsync();
        clientesCargados = true;

        claveTabla = Guid.NewGuid(); // 🔁 Forzamos recreación del DOM

        await InvokeAsync(StateHasChanged);

        await JS.InvokeVoidAsync("initializeDataTable", "tablaClientes");
    }

    async Task MostrarModalNuevo()
    {
        clienteEditar = new();
        await JS.InvokeVoidAsync("mostrarModal", "#modalNuevoCliente");
        await Task.Delay(300);
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    async Task Editar(ClienteViewModel cliente)
    {
        clienteEditar = new()
            {
                Id = cliente.Id,
                Nombre = cliente.Nombre,
                Apellido = cliente.Apellido,
                Telefono = cliente.Telefono,
                Email = cliente.Email,
                Calle = cliente.Calle,
                Altura = cliente.Altura,
                Piso = cliente.Piso,
                PuntosFidelidad = cliente.PuntosFidelidad,
                FechaCreacion = cliente.FechaCreacion
            };

        await JS.InvokeVoidAsync("mostrarModal", "#modalNuevoCliente");
        await Task.Delay(300);
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    async Task Guardar()
    {
        try
        {
            if (clienteEditar.Id == 0)
                await ClienteService.CrearClienteAsync(clienteEditar);
            else
                await ClienteService.EditarClienteAsync(clienteEditar.Id, clienteEditar);

            await JS.InvokeVoidAsync("cerrarModal", "#modalNuevoCliente");
            await CargarClientes();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error al guardar cliente: {ex.Message}");
        }
    }

    async Task Eliminar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar este cliente?");
        if (confirmar)
        {
            await ClienteService.EliminarClienteAsync(id);
            await CargarClientes();
        }
    }

    [JSInvokable]
    public void SetCalleDesdeJS(string calleId)
    {
        if (int.TryParse(calleId, out var id))
        {
            clienteEditar.CalleId = id;
        }
    }
}
