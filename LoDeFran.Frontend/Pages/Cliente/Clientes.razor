@page "/cliente/clientes"

@inject Services.ClienteService ClienteService
@inject IJSRuntime JS

@using LoDeFran.Frontend.Models

<h3 class="mt-4 mb-4">Gestión de Clientes</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo"><i class="fas fa-user-plus"></i> Nuevo Cliente</button>

@if (clientes is null)
{
    <div class="text-center">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover" id="tablaClientes">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Fidelidad</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.Apellido</td>
                    <td>@c.Telefono</td>
                    <td>@c.Email</td>
                    <td>@($"{c.Calle} {c.Altura}, {c.Piso}")</td>
                    <td>@(c.PuntosFidelidad ?? 0)</td>
                    <td>@(c.FechaCreacion?.ToShortDateString())</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Editar(c)"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(c.Id)"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((clienteEditar.Id == 0) ? "Agregar Cliente" : "Editar Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Nombre</label>
                            <input class="form-control" @bind="clienteEditar.Nombre" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Apellido</label>
                            <input class="form-control" @bind="clienteEditar.Apellido" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Teléfono</label>
                            <input class="form-control" @bind="clienteEditar.Telefono" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Email</label>
                            <input class="form-control" @bind="clienteEditar.Email" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Calle</label>
                            <input class="form-control" @bind="clienteEditar.Calle" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Altura</label>
                            <input class="form-control" @bind="clienteEditar.Altura" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Piso</label>
                            <input class="form-control" @bind="clienteEditar.Piso" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<ClienteViewModel> clientes = new();
    ClienteViewModel clienteEditar = new();
    bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    async Task CargarClientes()
    {
        clientes = await ClienteService.GetClientesAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("initializeDataTable", "tablaClientes");
    }

    void MostrarModalNuevo()
    {
        clienteEditar = new();
        mostrarModal = true;
    }

    void Editar(ClienteViewModel cliente)
    {
        clienteEditar = new()
            {
                Id = cliente.Id,
                Nombre = cliente.Nombre,
                Apellido = cliente.Apellido,
                Telefono = cliente.Telefono,
                Email = cliente.Email,
                Calle = cliente.Calle,
                Altura = cliente.Altura,
                Piso = cliente.Piso,
                PuntosFidelidad = cliente.PuntosFidelidad,
                FechaCreacion = cliente.FechaCreacion
            };
        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    async Task Guardar()
    {
        try
        {
            if (clienteEditar.Id == 0)
                await ClienteService.CrearClienteAsync(clienteEditar);
            else
                await ClienteService.EditarClienteAsync(clienteEditar.Id, clienteEditar);

            mostrarModal = false;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error al guardar cliente: {ex.Message}");
        }
    }

    async Task Eliminar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar este cliente?");
        if (confirmar)
        {
            await ClienteService.EliminarClienteAsync(id);
            await CargarClientes();
        }
    }
}
