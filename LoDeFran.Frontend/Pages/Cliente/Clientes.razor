@page "/cliente/clientes"
@inject Services.ClienteService ClienteService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <!-- Header -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-users me-2"></i> Gestión de Clientes</h4>
            <button class="btn btn-sm btn-light text-white shadow-sm" @onclick="MostrarModalNuevo">
                <i class="fas fa-user-plus me-2"></i> Nuevo Cliente
            </button>
        </div>
    </div>

    <!-- Tabla de Clientes -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            @if (!clientesCargados)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando clientes...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle shadow-sm" id="tablaClientes" @key="claveTabla">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th>Fidelidad</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in clientes)
                            {
                                <tr>
                                    <td>@c.Nombre</td>
                                    <td>@c.Apellido</td>
                                    <td>@c.Telefono</td>
                                    <td>@c.Email</td>
                                    <td>@($"{c.Calle} {c.Altura}, {c.Piso}")</td>
                                    <td>
                                        <span class="badge bg-info text-dark px-3 py-2">
                                            @(c.PuntosFidelidad ?? 0)
                                        </span>
                                    </td>
                                    <td>@(c.FechaCreacion?.ToShortDateString())</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-2" title="Editar" @onclick="() => Editar(c)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(c.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Nuevo/Editar Cliente -->
<div class="modal fade" id="modalNuevoCliente" tabindex="-1" aria-labelledby="modalNuevoClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- más ancho -->
        <div class="modal-content shadow-lg rounded-3 border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title text-white" id="modalNuevoClienteLabel">
                    <i class="fas fa-user me-2"></i>
                    @((clienteEditar.Id == 0) ? "Agregar Cliente" : "Editar Cliente")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <div class="input-group input-group-outline">
                            <input class="form-control" @bind="clienteEditar.Nombre" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Apellido</label>
                        <div class="input-group input-group-outline">
                            <input class="form-control" @bind="clienteEditar.Apellido" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <div class="input-group input-group-outline">
                            <input class="form-control" @bind="clienteEditar.Telefono" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <div class="input-group input-group-outline">
                            <input type="email" class="form-control" @bind="clienteEditar.Email" />
                        </div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Calle</label>
                        <div class="input-group input-group-outline">
                            <select id="selectCalle" class="form-control" style="width: 100%"></select>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Altura</label>
                        <div class="input-group input-group-outline">
                            <input class="form-control" @bind="clienteEditar.Altura" />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Piso</label>
                        <div class="input-group input-group-outline">
                            <input class="form-control" @bind="clienteEditar.Piso" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary shadow-sm" @onclick="Guardar">
                    <i class="fas fa-save me-2"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>


@code {
    Guid claveTabla = Guid.NewGuid();
    List<ClienteViewModel> clientes = new();
    ClienteViewModel clienteEditar = new();
    bool clientesCargados = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    async Task CargarClientes()
    {
        clientesCargados = false;

        await JS.InvokeVoidAsync("destroyDataTable", "tablaClientes");

        clientes = await ClienteService.GetClientesAsync();
        clientesCargados = true;

        claveTabla = Guid.NewGuid(); // 🔁 Forzamos recreación del DOM

        await InvokeAsync(StateHasChanged);

        await JS.InvokeVoidAsync("initializeDataTable", "tablaClientes");
    }

    async Task MostrarModalNuevo()
    {
        clienteEditar = new();
        await JS.InvokeVoidAsync("mostrarModal", "#modalNuevoCliente");
        await Task.Delay(300);
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    async Task Editar(ClienteViewModel cliente)
    {
        clienteEditar = new()
            {
                Id = cliente.Id,
                Nombre = cliente.Nombre,
                Apellido = cliente.Apellido,
                Telefono = cliente.Telefono,
                Email = cliente.Email,
                Calle = cliente.Calle,
                Altura = cliente.Altura,
                Piso = cliente.Piso,
                PuntosFidelidad = cliente.PuntosFidelidad,
                FechaCreacion = cliente.FechaCreacion
            };

        await JS.InvokeVoidAsync("mostrarModal", "#modalNuevoCliente");
        await Task.Delay(300);
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    async Task Guardar()
    {
        try
        {
            if (clienteEditar.Id == 0)
                await ClienteService.CrearClienteAsync(clienteEditar);
            else
                await ClienteService.EditarClienteAsync(clienteEditar.Id, clienteEditar);

            await JS.InvokeVoidAsync("cerrarModal", "#modalNuevoCliente");
            await CargarClientes();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error al guardar cliente: {ex.Message}");
        }
    }

    async Task Eliminar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar este cliente?");
        if (confirmar)
        {
            await ClienteService.EliminarClienteAsync(id);
            await CargarClientes();
        }
    }

    [JSInvokable]
    public void SetCalleDesdeJS(string calleId)
    {
        if (int.TryParse(calleId, out var id))
        {
            clienteEditar.CalleId = id;
        }
    }
}
