@page "/GestionMesas/servicio-de-mesa"
@inject Services.ServicioDeMesaService ServicioDeMesaService
@using LoDeFran.Frontend.Models

<h3>Servicio de Mesa - Selección de Piso y Mesa</h3>
<style>
    .mesas-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .mesa-icon {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        transition: all 0.2s ease-in-out;
        position: relative;
    }

    .mesa-icon:hover {
        transform: scale(1.05);
        background-color: #e2e6ea;
    }

    .mesa-num {
        font-weight: bold;
        font-size: 14px;
    }

    .badge {
        font-size: 10px;
        padding: 2px 6px;
    }
</style>

@if (Pisos?.Any() == true)
{
    <div class="btn-group mt-3" role="group">
        @foreach (var piso in Pisos)
        {
            <button class="btn btn-outline-primary @(PisoSeleccionado?.IdPiso == piso.IdPiso ? "active" : "")"
                    @onclick="() => CambiarPiso(piso)">
                @piso.Nombre
            </button>
        }
        <button class="btn btn-secondary" @onclick="VerTodasLasMesas">Todas</button>
    </div>


    @if (Mesas?.Any() == true)
    {
        <div class="mesas-grid mt-3">
            @foreach (var mesa in Mesas)
            {
                <button class="mesa-icon btn m-2 position-relative"
                        @onclick="() => SeleccionarMesa(mesa)"
                        title="Mesa @mesa.Numero">
                    <i class="fas fa-table fa-2x d-block"></i>
                    <span class="mesa-num">@mesa.Numero</span>
                    <span class="badge bg-@ObtenerClaseBadge(mesa.EstadoId) position-absolute top-0 start-100 translate-middle">@mesa.EstadoNombre</span>
                </button>
            }
        </div>
    }
    else if (PisoSeleccionado != null)
    {
        <p>No hay mesas disponibles en este piso.</p>
    }

}
else
{
    <p>Cargando pisos...</p>
}

@if (MesaSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mesa @MesaSeleccionada.Numero</h5>
                    <button type="button" class="btn-close" @onclick="() => MesaSeleccionada = null"></button>
                </div>
                <div class="modal-body">
                    <p>ID: <strong>@MesaSeleccionada.Id</strong></p>
                    <p>Estado: <strong>@MesaSeleccionada.EstadoNombre</strong></p>

                    @if (PedidoIniciado)
                    {
                        <p class="text-success">✅ Pedido ya iniciado</p>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="IniciarPedido">Iniciar Pedido</button>
                    }

                    @if (!string.IsNullOrWhiteSpace(ErrorMensaje))
                    {
                        <div class="alert alert-danger mt-2">@ErrorMensaje</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => MesaSeleccionada = null">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}


@if (PedidoIniciado)
{
    <hr />
    <h5>Agregar Productos al Pedido</h5>

    <ul class="nav nav-tabs mt-4" role="tablist">
        @foreach (var categoriaId in ProductosPorCategoria.Keys)
        {
            var nombreCategoria = CategoriasDisponibles.FirstOrDefault(c => c.Id == categoriaId)?.Nombre ?? "Sin nombre";
            <li class="nav-item">
                <a class="nav-link @(CategoriaSeleccionada == categoriaId ? "active" : "")"
                   @onclick="() => CategoriaSeleccionada = categoriaId"
                   href="javascript:void(0)">
                    @nombreCategoria
                </a>
            </li>
        }
    </ul>


    @if (CategoriaSeleccionada.HasValue && ProductosPorCategoria.TryGetValue(CategoriaSeleccionada.Value, out var productos))
    {
        <div class="row mt-3">
            @foreach (var producto in productos)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <h6 class="card-title">@producto.Nombre</h6>
                            <p class="card-text">@producto.Precio.ToString("C")</p>
                            <button class="btn btn-sm btn-primary" @onclick="() => AgregarProductoDesdeUI(producto.Id)">
                                Agregar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(AgregarProductoMensaje))
    {
        <p class="mt-2 text-info">@AgregarProductoMensaje</p>
    }

    @if (PedidoActual?.DetallePedido?.Any() == true)
    {
        <h5 class="mt-4">Detalle del Pedido</h5>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in PedidoActual.DetallePedido)
                {
                    <tr>
                        <td>@item.Producto.Nombre</td>
                        <td>@item.Cantidad</td>
                        <td>@item.PrecioUnitario.ToString("C")</td>
                        <td>@(item.Cantidad * item.PrecioUnitario).ToString("C")</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="@(() => EliminarItem(item.Id))">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<style>
    .mesas-grid {
        display: flex;
        flex-wrap: wrap;
    }

        .mesas-grid button {
            width: 120px;
            height: 80px;
            font-size: 14px;
            text-align: center;
        }
</style>

@code {
    private List<PisoViewModel> Pisos = new();
    private PisoViewModel? PisoSeleccionado;
    private List<MesaViewModel> Mesas = new();
    private MesaViewModel? MesaSeleccionada;
    private List<CategoriaProductoViewModel> CategoriasDisponibles = new();

    private bool PedidoIniciado = false;
    private string? ErrorMensaje;
    private PedidoViewModel? PedidoActual;

    private List<ProductoViewModel> ProductosDisponibles = new();
    private int ProductoSeleccionadoId;
    private string? AgregarProductoMensaje;

    protected override async Task OnInitializedAsync()
    {
        Pisos = await ServicioDeMesaService.GetPisosAsync();
    }

    private async Task OnPisoChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idPiso))
        {
            PisoSeleccionado = Pisos.FirstOrDefault(p => p.IdPiso == idPiso);
            Mesas = await ServicioDeMesaService.GetMesasPorPisoAsync(idPiso);
        }
        else
        {
            PisoSeleccionado = null;
            Mesas.Clear();
        }

        MesaSeleccionada = null;
        PedidoIniciado = false;
        PedidoActual = null;
    }
    private async Task SeleccionarMesa(MesaViewModel mesa)
    {
        MesaSeleccionada = mesa;

        try
        {
            // Intentar obtener un pedido existente para esta mesa
            var pedidoExistente = await ServicioDeMesaService.ObtenerPedidoPorMesaIdAsync(mesa.Id);

            PedidoActual = pedidoExistente;
            PedidoIniciado = true;
            ErrorMensaje = null;

            await CargarProductos();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // La mesa no tiene un pedido activo
            PedidoActual = null;
            PedidoIniciado = false;
            ErrorMensaje = null; // No es un error, solo no hay pedido
        }
        catch (Exception ex)
        {
            // Otro error (ej: red, servidor, etc.)
            ErrorMensaje = $"Error al consultar pedido existente: {ex.Message}";
            PedidoActual = null;
            PedidoIniciado = false;
        }
    }



    private async Task IniciarPedido()
    {
        if (MesaSeleccionada == null) return;

        try
        {
            PedidoActual = await ServicioDeMesaService.IniciarPedidoAsync(MesaSeleccionada.Id);
            if (PedidoActual != null)
            {
                PedidoIniciado = true;
                ErrorMensaje = null;
                await CargarProductos();
                // Refrescar la lista de mesas para actualizar su estado visual
                if (PisoSeleccionado != null)
                {
                    Mesas = await ServicioDeMesaService.GetMesasPorPisoAsync(PisoSeleccionado.IdPiso);
                }
            }
            else
            {
                ErrorMensaje = "No se pudo iniciar el pedido.";
            }
        }
        catch (Exception ex)
        {
            ErrorMensaje = $"Ocurrió un error: {ex.Message}";
        }
    }

    private async Task CargarProductos()
    {
        ProductosDisponibles = await ServicioDeMesaService.GetProductosAsync();
        CategoriasDisponibles = await ServicioDeMesaService.GetCategoriasProductosAsync();

    }

    private async Task AgregarProductoAlPedido()
    {
        if (ProductoSeleccionadoId == 0 || PedidoActual == null)
        {
            AgregarProductoMensaje = "Seleccione un producto válido.";
            return;
        }

        try
        {
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(PedidoActual.Id, ProductoSeleccionadoId);
            AgregarProductoMensaje = "Producto agregado correctamente.";
            ProductoSeleccionadoId = 0;

            // Recargar detalle actualizado
            PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        }
        catch (Exception ex)
        {
            AgregarProductoMensaje = $"Error: {ex.Message}";
        }
    }

    private async Task EliminarItem(int idDetalle)
    {
        if (PedidoActual == null) return;

        try
        {
            await ServicioDeMesaService.DeleteAsync(PedidoActual.Id, idDetalle);
            PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        }
        catch (Exception ex)
        {
            AgregarProductoMensaje = $"Error al eliminar producto: {ex.Message}";
        }
    }
    private string ObtenerIconoMesa(int idEstado) => idEstado switch
    {
        1 => "🟩", // disponible
        2 => "🟥", // ocupada
        3 => "🟨", // reservada
        4 => "🛠", // fuera de servicio
        _ => "❓"
    };

    private string ObtenerColorMesa(int idEstado) => idEstado switch
    {
        1 => "#28a745", // verde
        2 => "#dc3545", // rojo
        3 => "#ffc107", // amarillo
        4 => "#6c757d", // gris
        _ => "#007bff"
    };

    private void MostrarModalMesa(MesaViewModel mesa)
    {
        MesaSeleccionada = mesa;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;
        _ = SeleccionarMesa(mesa);
    }

    private void CerrarModalMesa()
    {
        MesaSeleccionada = null;
    }
    private string ObtenerClaseBadge(int? idEstado) => idEstado switch
    {
        1 => "success",    // disponible
        2 => "danger",     // ocupada
        3 => "warning",    // reservada
        4 => "secondary",  // fuera de servicio
        _ => "dark"
    };
    private Dictionary<int, List<ProductoViewModel>> ProductosPorCategoria =>
        ProductosDisponibles
            .Where(p => p.CategoriaProductoId.HasValue)
            .GroupBy(p => p.CategoriaProductoId.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());

    private int? CategoriaSeleccionada { get; set; } = null;


    private async Task AgregarProductoDesdeUI(int productoId)
    {
        ProductoSeleccionadoId = productoId;
        await AgregarProductoAlPedido();
    }
    private async Task CambiarPiso(PisoViewModel piso)
    {
        PisoSeleccionado = piso;
        Mesas = await ServicioDeMesaService.GetMesasPorPisoAsync(piso.IdPiso);
    }

    private async Task VerTodasLasMesas()
    {
        PisoSeleccionado = null;
        Mesas = await ServicioDeMesaService.GetMesasAsync(); // Debes tener este método en el servicio
    }


}
