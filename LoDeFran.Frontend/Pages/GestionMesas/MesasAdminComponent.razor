@if (Pisos?.Any() == true)
{
    <div class="row g-2 align-items-center mt-3 mb-2">
        <div class="col-12 col-md">
            <div class="btn-group w-100" role="group">
                @foreach (var piso in Pisos)
                {
                    <button class="btn btn-default @(PisoSeleccionado?.IdPiso == piso.IdPiso ? "active" : "")" @onclick="() => CambiarPiso(piso)">@piso.Nombre</button>
                }
                <button class="btn btn-default" @onclick="VerTodasLasMesas">Todas</button>
            </div>
        </div>
        <div class="col-12 col-md-auto">
            <div class="d-flex flex-wrap justify-content-start gap-3 mt-2 mt-md-0">
                <div class="d-flex align-items-center gap-1"><div class="color-circulo bg-success"></div><span>Libre</span></div>
                <div class="d-flex align-items-center gap-1"><div class="color-circulo bg-warning"></div><span>Ocupada</span></div>
                <div class="d-flex align-items-center gap-1"><div class="color-circulo bg-danger"></div><span>Reservada</span></div>
            </div>
        </div>
    </div>

    <div class="mesas-grid mt-3">
        @foreach (var mesa in Mesas)
        {
            <button class="mesa-icon btn" @onclick="() => MostrarDetalleMesa(mesa)">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 44.999 44.999" width="40" height="40"
                     class="mesa-svg @ObtenerClaseColorSvg(mesa.EstadoId)">
