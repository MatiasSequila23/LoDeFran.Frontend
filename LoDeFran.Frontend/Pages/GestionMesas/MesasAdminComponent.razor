else
{
    <p>Cargando pisos...</p>
}

@if (MesaSeleccionada != null)
{
    <div class="modal-backdrop" @onclick="CerrarModal"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content animated-modal">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title"><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Detalle Mesa @MesaSeleccionada.Numero</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="text-center shadow-sm rounded bg-white h-100">
                                <div class="h5 text-primary mb-1"><i class="bi bi-info-circle-fill me-2"></i>@MesaSeleccionada.EstadoNombre</div>
                                <p class="fw-semibold mb-1">Estado actual de la mesa</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-center shadow-sm rounded bg-white h-100">
                                <div class="h5 text-warning mb-1"><i class="bi bi-box-seam me-2"></i>@PedidoActual?.EstadoId</div>
                                <p class="fw-semibold mb-1">Estado del pedido</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-center shadow-sm rounded bg-white h-100">
                                <div class="h5 text-secondary mb-1"><i class="bi bi-person me-2"></i>(no asignado)</div>
                                <p class="fw-semibold mb-1">Mozo asignado</p>
                            </div>
                        </div>
                    </div>

                    @if (PedidoIniciado)
                    {
                        <div class="alert alert-success text-center"><p><i class="bi bi-check-circle-fill"></i> Pedido ya iniciado</p></div>
                        <button class="btn btn-success w-100 " @onclick='() => Nav.NavigateTo($"/GestionMesas/pedido/{PedidoActual?.Id}")'><i class="bi bi-eye me-1"></i> Ver Pedido</button>

                        @if (EstadoPedidoActualId == (int)Enums.EstadoPedido.ListoParaEntregar)
                        {
                            <button class="btn btn-info w-100 mb-2" @onclick="() => CambiarEstado(PedidoActual.Id, Enums.EstadoPedido.Entregado)"><i class="bi bi-box-arrow-in-down me-1"></i> Pedido Entregado</button>
                        }
                        else if (EstadoPedidoActualId == (int)Enums.EstadoPedido.Entregado)
                        {
                            <button class="btn btn-warning w-100 mb-2" @onclick="() => CambiarEstado(PedidoActual.Id, Enums.EstadoPedido.A_Cobrar)"><i class="bi bi-cash-coin me-1"></i> Generar Cuenta</button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-primary w-100 mb-2" @onclick="IniciarPedido"><i class="bi bi-plus-circle me-1"></i> Iniciar Pedido</button>
                    }

                    @if (!string.IsNullOrWhiteSpace(ErrorMensaje))
                    {
                        <div class="alert alert-danger mt-2">@ErrorMensaje</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-secondary w-100" @onclick="CerrarModal"><i class="bi bi-x-circle me-1"></i> Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PisoViewModel> Pisos = new();
    private PisoViewModel? PisoSeleccionado;
    private List<MesaViewModel> Mesas = new();
    private MesaViewModel? MesaSeleccionada;
    private PedidoViewModel? PedidoActual;
    private bool PedidoIniciado = false;
    private string? ErrorMensaje;
    private int? EstadoPedidoActualId => PedidoActual?.EstadoId;


    protected override async Task OnInitializedAsync()
    {
        await clearDataTable();
        Pisos = await ServicioDeMesaService.GetPisosAsync();
        PisoSeleccionado = null;
        Mesas.Clear();
        Mesas = await ServicioDeMesaService.GetMesasAsync();
        

    }
    private async Task clearDataTable()
    {
        await JS.InvokeVoidAsync("destroyDataTable", "tablaPedidos");
        await JS.InvokeVoidAsync("destroyDataTable", "tablaCaja");
    }
    private async Task CambiarPiso(PisoViewModel piso)
    {
        PisoSeleccionado = piso;
        Mesas = await ServicioDeMesaService.GetMesasPorPisoAsync(piso.IdPiso);

    }

    private async Task VerTodasLasMesas()
    {
        PisoSeleccionado = null;
        Mesas.Clear();
        Mesas = await ServicioDeMesaService.GetMesasAsync();
    }

    private async Task MostrarDetalleMesa(MesaViewModel mesa)
    {
        MesaSeleccionada = mesa;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;

        try
        {
            PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorMesaIdAsync(mesa.Id);
            PedidoIniciado = true;
        }
        catch
        {
            PedidoIniciado = false;
            PedidoActual = null;
        }
    }

    private async Task CambiarEstado(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        CerrarModal(); // opcional
    }

    private void CerrarModal()
    {
        MesaSeleccionada = null;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;
    }

    private async Task IniciarPedido()
    {
        if (MesaSeleccionada == null)
            return;

        try
        {
            PedidoActual = await ServicioDeMesaService.IniciarPedidoAsync(MesaSeleccionada.Id);
            PedidoIniciado = true;
            ErrorMensaje = null;
            Nav.NavigateTo($"/GestionMesas/pedido/{PedidoActual.Id}");
        }
        catch (Exception ex)
        {
            ErrorMensaje = $"Error: {ex.Message}";
        }
    }
   
    private void VerPedido()
    {
        if (PedidoActual != null)
            Nav.NavigateTo($"/GestionMesas/pedido/{PedidoActual.Id}");
    }

    private string ObtenerClaseBadge(int? estadoId) => estadoId switch
    {
        1 => "success",
        2 => "warning",
        3 => "danger",
        _ => "secondary"
    };

    private string ObtenerClaseColorSvg(int? estadoId) => estadoId switch
    {
        1 => "svg-verde",     // Disponible
        2 => "svg-amarillo",  // Ocupada
        3 => "svg-rojo",      // Reservada
        _ => "svg-gris"
    };

    private string ObtenerClaseEstadoTexto(int? estadoId) => estadoId switch
    {
        1 => "estado-verde",     // Disponible
        2 => "estado-amarillo",  // Ocupada
        3 => "estado-rojo",      // Reservada
        _ => "estado-gris"
    };

}