@inject Services.ServicioDeMesaService ServicioDeMesaService
@using LoDeFran.Frontend.Models

<h3>Seleccionar Mesa</h3>

<select @onchange="OnPisoChanged">
    <option value="">-- Seleccionar Piso --</option>
    @foreach (var piso in Pisos)
    {
        <option value="@piso.IdPiso">@piso.Nombre</option>
    }
</select>

<div class="mesas-grid mt-3">
    @if (Mesas?.Any() == true)
    {
        @foreach (var mesa in Mesas)
        {
            <button class="mesa @(mesa.EstadoNombre?.ToLower())"
                    @onclick="@(() => MesaSeleccionada.InvokeAsync(mesa))">
                Mesa @mesa.Numero <br />
                <small>@mesa.EstadoNombre</small>
            </button>
        }
    }
    else if (PisoSeleccionadoId != 0)
    {
        <p>No hay mesas para este piso.</p>
    }
</div>

@code {
    [Parameter] public EventCallback<MesaViewModel> MesaSeleccionada { get; set; }

    private List<PisoViewModel> Pisos = new();
    private List<MesaViewModel> Mesas = new();
    private int PisoSeleccionadoId;

    protected override async Task OnInitializedAsync()
    {
        Pisos = await ServicioDeMesaService.GetPisosAsync();
    }

    private async Task OnPisoChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pisoId))
        {
            PisoSeleccionadoId = pisoId;
            Mesas = await ServicioDeMesaService.GetMesasPorPisoAsync(pisoId);
        }
        else
        {
            PisoSeleccionadoId = 0;
            Mesas.Clear();
        }
    }
}
