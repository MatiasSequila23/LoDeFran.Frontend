@page "/Pedido/PedidoDelivery"
@implements IDisposable
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ClienteService ClienteService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Utlis
@using LoDeFran.Frontend.Services
<style>
    .custom-nav-link {
        border: 1px solid #e91e63; /* borde azul fijo */
        border-radius: 6px; /* redondear esquinas */
        background-color: white; /* fondo inicial */
        color: #e91e63; /* texto azul inicial */
        transition: all 0.2s ease; /* transición suave */
    }

        .custom-nav-link:hover {
            background-color: #e91e63; /* cambia fondo al pasar mouse */
            color: white; /* cambia el texto al blanco */
            transform: translateY(-2px); /* pequeño efecto de “elevación” */
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); /* sombra sutil */
        }
</style>
<!-- Header -->
<div class="card shadow-lg mb-2 border-0 rounded-3">
    <div class="card-header bg-gradient bg-success text-white d-flex justify-content-between align-items-center rounded-top">
        <h4 class="mb-0 text-white">
            <i class="fas fa-truck me-2"></i> Pedido Delivery
        </h4>
        <div class="d-flex gap-2">
            <!-- Nuevo Cliente -->
            <button class="btn btn-success d-flex align-items-center px-3 py-1 custom-nav-link"
                    @onclick="abrirmodalcliente">
                <i class="material-symbols-rounded me-1">person_add</i>
                Nuevo cliente
            </button>

            <!-- Crear Pedido -->
            <button class="btn btn-warning d-flex align-items-center px-3 py-1 custom-nav-link"
                    @onclick="CrearPedido"
                    disabled="@isCreandoPedido">
                <i class="material-symbols-rounded me-1">shopping_cart</i>
                Crear pedido
            </button>

            <!-- Buscar Cliente -->
            <button class="btn btn-primary d-flex align-items-center px-3 py-1 custom-nav-link"
                    @onclick="abrirmodalclienteselect">
                <i class="fas fa-search me-1"></i>
                Buscar cliente
            </button>
        </div>
    </div>
</div>


<!-- Modal de búsqueda de clientes -->
<div class="modal fade" id="modalBuscarCliente" tabindex="-1" aria-labelledby="modalBuscarClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalBuscarClienteLabel">Buscar Cliente</h5>
                <button type="button" class="btn-close text-dark" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Lista de clientes -->
                    <div class="col-md-6">
                        <div class="card blur shadow-blur h-100 max-height-vh-70 overflow-auto overflow-x-hidden">
                            <div class="card-header p-3">
                                <h6>Clientes</h6>
                                <label class="form-label">Buscar cliente</label>
                                <div class="input-group input-group-outline">
                                    <input class="form-control" placeholder="Teléfono, email, calle..."
                                           @bind="BusquedaCliente" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="card-body p-2">
                                @if (isLoadingClientes)
                                {
                                    <div class="text-center my-3">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <p class="mt-2 text-muted">Buscando clientes...</p>
                                    </div>
                                }
                                else if (ClientesEncontrados.Any())
                                {
                                    @foreach (var cliente in ClientesEncontrados)
                                    {
                                        <a href="javascript:;" class="d-block p-2 @(ClienteSeleccionadoId == cliente.Id ? "bg-gradient-dark border-radius-lg" : "")"
                                           @onclick="() => SeleccionarCliente(cliente.Id)">
                                            <div class="d-flex p-2">
                                                <img alt="Image" src="../../assets/img/team-5.jpg" class="avatar shadow">
                                                <div class="ms-3">
                                                    <h6 class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0" : "mb-0")">
                                                        @cliente.Nombre @cliente.Apellido
                                                    </h6>
                                                    <p class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0 text-sm" : "text-muted text-xs mb-0")">
                                                        @cliente.Telefono
                                                    </p>
                                                    <span class="text-muted text-sm d-block">@cliente.Calle @cliente.Altura</span>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <div class="text-center">
                                        <p class="text-muted">No se encontraron clientes</p>
                                        <button class="btn btn-success mt-2" @onclick="abrirmodalcliente">
                                            <i class="material-symbols-rounded me-1">person_add</i>
                                            Crear nuevo cliente
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Información del cliente seleccionado -->
                    <div class="col-md-6">
                        <div class="card blur shadow-blur h-100 max-height-vh-70 overflow-auto overflow-x-hidden">
                            <div class="card-header p-3">
                                <h6 class="mb-0">Información del cliente</h6>
                            </div>
                            @if (ClienteSeleccionado != null)
                            {
                                <div class="card-body p-3">
                                    <ul class="list-group mb-3">
                                        <li class="list-group-item border-0 ps-0 pt-0 text-sm">
                                            <strong class="text-dark">Nombre completo:</strong> @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Teléfono:</strong> @ClienteSeleccionado.Telefono
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Email:</strong> @ClienteSeleccionado.Email
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Dirección:</strong> @ClienteSeleccionado.Calle @ClienteSeleccionado.Altura
                                            @(string.IsNullOrWhiteSpace(ClienteSeleccionado.Piso) ? "" : $", Piso {ClienteSeleccionado.Piso}")
                                        </li>
                                    </ul>

                                    <!-- Botón para crear pedido si hay cliente seleccionado -->
                                    <div class="text-center">
                                        <button class="btn btn-primary" @onclick="CrearPedido" disabled="@isCreandoPedido">
                                            <i class="material-symbols-rounded me-1">shopping_cart</i>
                                            Crear pedido
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card-body p-3 text-center text-muted">
                                    <p class="mt-2 mb-0">Ningún cliente seleccionado</p>
                                    <small>Usa el buscador para elegir uno</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@if (mensajeExito is not null)
{
    <div class="alert alert-success mt-3">@mensajeExito</div>
}
@if (isLoadingPedidos)
{
    <div class="text-center my-4">
        <div class="spinner-border text-secondary" role="status"></div>
        <p class="mt-2">Cargando pedidos delivery...</p>
    </div>
}
else if (Pedidos == null || !Pedidos.Any())
{
    <div class="alert alert-info text-white">No hay pedidos delivery registrados.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h4 class="">Pedidos Delivery</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered" id="tablaPedidos" @key="claveTabla">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Pedidos)
                    {
                        <tr>
                            <td>@pedido.Id</td>
                            <td>@pedido.ClienteNombre</td>
                            <td>@pedido.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@((Enums.EstadoPedido)pedido.EstadoId)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => VerPedido(pedido.Id)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => MostrarCliente(pedido.ClienteId)">
                                    <i class="fas fa-user"></i>
                                </button>

                                @if (pedido.EstadoId == (int)Enums.EstadoPedido.ListoParaEntregar)
                                {
                                    <button class="btn btn-sm btn-info me-1" @onclick="() => CambiarEstado(pedido.Id, Enums.EstadoPedido.Entregado)">
                                        Entregado
                                    </button>
                                }
                                else if (pedido.EstadoId == (int)Enums.EstadoPedido.Entregado)
                                {
                                    <button class="btn btn-sm btn-warning me-1" @onclick="() => CambiarEstado(pedido.Id, Enums.EstadoPedido.A_Cobrar)">
                                        Generar Cuenta
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal muestra el datos del cliente del pedido -->
<div class="modal fade" id="modalCliente" tabindex="-1" aria-labelledby="modalClienteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Información del Cliente</h5>
                <button type="button" class="btn-close text-dark" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (ClienteSeleccionado != null)
                {
                    <p><strong>Nombre:</strong> @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido</p>
                    <p><strong>Teléfono:</strong> @ClienteSeleccionado.Telefono</p>
                    <p><strong>Email:</strong> @ClienteSeleccionado.Email</p>
                    <p><strong>Dirección:</strong> @ClienteSeleccionado.Calle @ClienteSeleccionado.Altura, Piso @ClienteSeleccionado.Piso</p>
                }
                else
                {
                    <p>Cargando datos del cliente...</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="ImprimirCliente">Imprimir</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAsignarCliente" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Crear Nuevo Cliente</h5>
                <button type="button" class="btn-close text-dark" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>

            </div>
            <div class="modal-body">
                
                <div class="row">
                    <div class="col-12 col-md-6">
                        <!-- Nombre -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Nombre" @bind="NuevoCliente.Nombre" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <!-- Apellido -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Apellido" @bind="NuevoCliente.Apellido" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <!-- telefono -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Teléfono" @bind="NuevoCliente.Telefono" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <!-- email -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Email" @bind="NuevoCliente.Email" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-12">
                        <!-- Calle -->
                        <div class="input-group input-group-static mb-3">
                            <select id="selectCalle" class="form-control mb-2" style="width: 100%"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <!-- Altura -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Altura" @bind="NuevoCliente.Altura" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <!-- Piso -->
                        <div class="input-group input-group-static mb-3">
                            <input class="form-control mb-2" placeholder="Piso" @bind="NuevoCliente.Piso" />
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" @onclick="AsignarOCrearCliente">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private PedidoViewModel nuevoPedido = new();
    private List<PedidoViewModel> Pedidos = new();
    private string? mensajeExito;
    private string _busquedaCliente = "";
    Guid claveTabla = Guid.NewGuid();
    private bool isLoadingClientes = false;
    private bool isCreandoPedido = false;
    private bool isLoadingPedidos = false;
    private string BusquedaCliente
    {
        get => _busquedaCliente;
        set
        {
            if (_busquedaCliente != value)
            {
                _busquedaCliente = value;
                _ = BuscarClienteAutomaticamente();
            }
        }
    }

    private bool BuscoCliente = false;
    private List<ClienteViewModel> ClientesEncontrados = new();
    private int? ClienteSeleccionadoId;
    private ClienteViewModel NuevoCliente = new();
    private ClienteViewModel? ClienteSeleccionado;
    private DotNetObjectReference<PedidoDelivery>? _dotNetRef;

    private bool PuedeCrear =>
        ClienteSeleccionadoId.HasValue ||
        (!string.IsNullOrWhiteSpace(NuevoCliente.Nombre) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Telefono) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Calle) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Altura));

    protected override async Task OnInitializedAsync()
    {
        nuevoPedido.TipoPedidoId = 3;
        await CargarPedidos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registrarInstanciaBlazor", _dotNetRef);
            await JS.InvokeVoidAsync("inicializarSelectCalle");
        }
    }

    [JSInvokable]
    public Task SetCalleDesdeJS(string calle)
    {
        NuevoCliente.Calle = calle;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private async Task BuscarClienteAutomaticamente()
    {
        if (BusquedaCliente.Trim().Length >= 3)
        {
            isLoadingClientes = true;
            StateHasChanged();

            ClientesEncontrados = await ServicioDeMesaService.BuscarClientesAsync(BusquedaCliente.Trim());
            BuscoCliente = true;

            isLoadingClientes = false;
            StateHasChanged();
        }
        else
        {
            ClientesEncontrados.Clear();
            BuscoCliente = false;
        }
    }

    private async Task GuardarNuevoCliente()
    {
        if (string.IsNullOrWhiteSpace(NuevoCliente.Nombre) || string.IsNullOrWhiteSpace(NuevoCliente.Telefono))
            return;

        var clienteCreado = await ClienteService.CrearClienteAsync(NuevoCliente);
        ClienteSeleccionadoId = clienteCreado.Id;
        await JS.InvokeVoidAsync("cerrarModal", "#modalNuevoCliente");

        BusquedaCliente = $"{clienteCreado.Nombre} {clienteCreado.Apellido}";
        ClientesEncontrados = new List<ClienteViewModel> { clienteCreado };

        LimpiarNuevoCliente();
    }

    private async Task CrearPedido()
    {
        // Verificamos si hay un cliente seleccionado
        if (ClienteSeleccionadoId == null)
        {
            await JS.InvokeVoidAsync("mostrarAlerta", "Atención", "Debe seleccionar un cliente antes de crear el pedido", "warning");
            return;
        }

        isCreandoPedido = true;
        StateHasChanged();

        try
        {
            int clienteId = ClienteSeleccionadoId.Value;

            // Si se está creando un nuevo cliente, ya debería estar guardado
            if (!string.IsNullOrWhiteSpace(NuevoCliente.Nombre) && clienteId == 0)
            {
                var clienteCreado = await ClienteService.CrearClienteAsync(NuevoCliente);
                clienteId = clienteCreado.Id;
            }

            var pedido = await ServicioDeMesaService.CrearPedidoPorClienteAsync(clienteId, 3);

            // Cerrar modal de búsqueda de clientes
            await JS.InvokeVoidAsync("eval", "var modal = bootstrap.Modal.getInstance(document.getElementById('modalBuscarCliente')); if(modal) modal.hide();");

            // Redirigir al builder del pedido
            Nav.NavigateTo($"/Pedido/PedidoBuilder/{pedido.Id}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error al crear pedido: {ex.Message}");
        }
        finally
        {
            isCreandoPedido = false;
        }
    }

    private async Task CargarPedidos()
    {
        isLoadingPedidos = true;
        StateHasChanged();

        await JS.InvokeVoidAsync("destroyDataTable", "tablaPedidos");
        await JS.InvokeVoidAsync("destroyDataTable", "tablaCaja");

        Pedidos = (await ServicioDeMesaService.PedidosFueraDeSalon())
            .Where(p => p.TipoPedidoNombre?.ToLower().Contains("delivery") == true)
            .ToList();

        claveTabla = Guid.NewGuid();

        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("initializeDataTable", "tablaPedidos");

        isLoadingPedidos = false;
    }

    private void VerPedido(int id) => Nav.NavigateTo($"/Pedido/PedidoBuilder/{id}");

    private async Task CambiarEstado(int pedidoId, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(pedidoId, nuevoEstado);
        await CargarPedidos();
    }

    private async Task MostrarCliente(int? clienteId)
    {
        if (clienteId == null) return;
        ClienteSeleccionado = await ClienteService.GetClienteAsync(clienteId.Value);
        await JS.InvokeVoidAsync("mostrarModal", "#modalCliente");
    }

    private async Task ImprimirCliente()
    {
        await JS.InvokeVoidAsync("imprimirModal", "#modalCliente");
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    private async void MostrarModalNuevo()
    {
        await JS.InvokeVoidAsync("mostrarModal", "#modalNuevoCliente");
        await Task.Delay(300);
        await JS.InvokeVoidAsync("inicializarSelectCalle");
    }

    private void desplegarSelectClientes()
    {
        JS.InvokeVoidAsync("expandSelect", "selectClientes");
    }
    private void LimpiarNuevoCliente()
    {
        NuevoCliente = new ClienteViewModel(); // Reinicia el objeto
    }
    private async Task AsignarOCrearCliente()
    {
        int clienteId;

        if (ClienteSeleccionadoId.HasValue)
        {
            clienteId = ClienteSeleccionadoId.Value;
        }
        else
        {
            var clienteCreado = await ClienteService.CrearClienteAsync(NuevoCliente);
            clienteId = clienteCreado.Id;
            ClienteSeleccionadoId = clienteCreado.Id;
        }

        // // Crear pedido con clienteId opcional (puede ser null)
        // var pedido = await ServicioDeMesaService.CrearPedidoPorClienteAsync(clienteId, 3);

        // // Navegar al builder del pedido
        // Nav.NavigateTo($"/Pedido/PedidoBuilder/{pedido.Id}");
    }
    private async Task abrirmodalcliente()
    {
        await JS.InvokeVoidAsync("mostrarModal", "#modalAsignarCliente");

    }

    private async Task SeleccionarCliente(int clienteId)
    {
        if (clienteId > 0)
        {
            ClienteSeleccionado = ClientesEncontrados.FirstOrDefault(c => c.Id == clienteId);
            ClienteSeleccionadoId = clienteId; // lo seguís guardando si querés
        }
        else
        {
            ClienteSeleccionado = null;
            ClienteSeleccionadoId = null;
        }

        //await JS.InvokeVoidAsync("cerrarModal", "#modalAsignarCliente");
    }

    private async Task abrirmodalclienteselect()
    {
        await JS.InvokeVoidAsync("mostrarModal", "#modalBuscarCliente");
    }

}
