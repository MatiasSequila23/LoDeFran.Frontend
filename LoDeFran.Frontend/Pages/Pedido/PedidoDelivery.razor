@page "/Pedido/PedidoDelivery"
@implements IDisposable
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ClienteService ClienteService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Utlis
@using LoDeFran.Frontend.Services
<style>
    .custom-nav-link {
        border: 1px solid #e91e63; /* borde azul fijo */
        border-radius: 6px; /* redondear esquinas */
        background-color: white; /* fondo inicial */
        color: #e91e63; /* texto azul inicial */
        transition: all 0.2s ease; /* transición suave */
    }

        .custom-nav-link:hover {
            background-color: #e91e63; /* cambia fondo al pasar mouse */
            color: white; /* cambia el texto al blanco */
            transform: translateY(-2px); /* pequeño efecto de “elevación” */
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); /* sombra sutil */
        }
</style>
<div class="">
    <div class="page-header min-height-300 border-radius-xl mt-4"
         style="background-image: url('../../assets/img/aerea_obelisco.jpg');">
        <span class="mask bg-gradient-dark opacity-6"></span>
    </div>
    <div class="card card-body mx-2 mx-md-2 mt-n9">
        <div class="row gx-4 mb-2">
            <div class="col-auto">
                <div class="avatar avatar-xl position-relative">
                    <img src="../../assets/img/delivery-moto.jpg" alt="profile_image" class="w-100 border-radius-lg shadow-sm">
                </div>
            </div>
            <div class="col-auto my-auto">
                <div class="h-100">
                    <h3 class="mb-1">
                        Pedidos Delivery
                    </h3>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 my-sm-auto ms-sm-auto me-sm-0 mx-auto mt-3">
                <div class="nav-wrapper position-relative end-0">
                    <ul class="nav nav-pills nav-fill p-1" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link mb-0 px-0 py-1 custom-nav-link" style="cursor:pointer;"
                               role="tab"
                               aria-selected="true"
                               @onclick="abrirmodalcliente">
                                <i class="material-symbols-rounded text-lg position-relative">home</i>
                                <span class="ms-1">Nuevo cliente</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link mb-0 px-0 py-1 custom-nav-link btn btn-link text-decoration-none"
                                    @onclick="CrearPedido"
                                    disabled="@isCreandoPedido">
                                <i class="material-symbols-rounded text-lg position-relative">email</i>
                                <span class="ms-1">Crear pedido</span>
                            </button>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="row mt-4">
                <div class="col-md-6 col-lg-6">
                    <div class="card blur shadow-blur h-100 max-height-vh-70 overflow-auto overflow-x-hidden mb-5 mb-lg-0">
                        <div class="card-header p-3">
                            <h6>Clientes</h6> <label class="form-label">Buscar cliente</label>
                            <div class="input-group input-group-outline">

                                <input class="form-control" placeholder="Teléfono, email, calle..."
                                       @bind="BusquedaCliente" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="card-body p-2">
                            @if (isLoadingClientes)
                            {
                                <div class="text-center my-3">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted">Buscando clientes...</p>
                                </div>
                            }
                            else if (ClientesEncontrados.Any())
                            {
                                @foreach (var cliente in ClientesEncontrados)
                                {
                                    <a href="javascript:;" class="d-block p-2 @(ClienteSeleccionadoId == cliente.Id ? "bg-gradient-dark border-radius-lg" : "")"
                                       @onclick="() => SeleccionarCliente(cliente.Id)">
                                        <div class="d-flex p-2">
                                            @*  <img alt="Cliente"
                                    src="@(string.IsNullOrEmpty(cliente.FotoUrl) ? "/images/default-avatar.png" : cliente.FotoUrl)"
                                    class="avatar shadow"> *@
                                            <img alt="Image" src="../../assets/img/team-5.jpg" class="avatar shadow">
                                            <div class="ms-3">
                                                <h6 class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0" : "mb-0")">
                                                    @cliente.Nombre @cliente.Apellido
                                                </h6>
                                                <p class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0 text-sm" : "text-muted text-xs mb-0")">
                                                    @cliente.Telefono
                                                </p>
                                                <span class="text-muted text-sm d-block">@cliente.Calle @cliente.Altura</span>
                                            </div>
                                        </div>
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="text-center text-muted">No se encontraron clientes</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6">
                    <div class="card blur shadow-blur h-100 max-height-vh-70 overflow-auto overflow-x-hidden mb-5 mb-lg-0">
                        <div class="card-header p-3">
                            <div class="row">
                                <div class="col-md-8 d-flex align-items-center">
                                    <h6 class="mb-0">Informacion del cliente</h6>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a href="javascript:;">
                                        <i class="fas fa-user-edit text-secondary text-sm" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Edit Profile" data-bs-original-title="Edit Profile"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        @if (ClienteSeleccionado != null)
                        {
                            <div class="card-body p-3">

                                <div class="card-body p-3">
                                    <h6 class="mb-3">Cliente seleccionado</h6>
                                    <hr class="horizontal gray-light my-2">

                                    <ul class="list-group">
                                        <li class="list-group-item border-0 ps-0 pt-0 text-sm">
                                            <strong class="text-dark">Nombre completo:</strong> &nbsp;
                                            @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Teléfono:</strong> &nbsp;
                                            @ClienteSeleccionado.Telefono
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Email:</strong> &nbsp;
                                            @ClienteSeleccionado.Email
                                        </li>
                                        <li class="list-group-item border-0 ps-0 text-sm">
                                            <strong class="text-dark">Dirección:</strong> &nbsp;
                                            @ClienteSeleccionado.Calle @ClienteSeleccionado.Altura
                                            @(string.IsNullOrWhiteSpace(ClienteSeleccionado.Piso) ? "" : $", Piso {ClienteSeleccionado.Piso}")
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-body p-3 text-center text-muted">
                                <p class="mt-2 mb-0">Ningún cliente seleccionado</p>
                                <small>Usa el buscador para elegir uno</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




