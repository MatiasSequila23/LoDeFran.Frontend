        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar combo: @ComboEditando.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditarCombo"></button>
                </div>
