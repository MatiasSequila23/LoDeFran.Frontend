@page "/Pedido/PedidoBuilderMesa/{idPedido:int}"
@layout LayoutMesasSalon
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ComboService ComboService
@inject Services.PedidoService PedidoService
@inject Services.PromocionService PromocionService
@inject Services.DetallePedidoServicie DetallePedidoServicie
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Globalization
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Utlis

<!-- CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-..." crossorigin="anonymous" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .pedido-container {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        height: calc(100vh - 180px);
    }

    .productos-panel {
        flex: 2 1 300px;
        border-right: 2px solid #eee;
        padding-right: 0.5rem;
        height: 100%;
    }

    .productos-scroll {
        max-height: 70vh;
        overflow-y: auto;
        padding-right: 5px;
    }

    .pedido-panel {
        flex: 1 1 250px;
        overflow-y: auto;
        padding-left: 0.5rem;
        background: #fafafa;
        border-left: 2px solid #eee;
        height: 100%;
    }

    .card.producto {
        min-height: 130px;
    }

    .card.stock-disponible {
        background-color: #e9f9e9;
    }

    .card.stock-bajo {
        background-color: #fffbe6;
    }

    .card.sin-stock {
        background-color: #fdecea;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Pedido - Agregar Productos</h4>
    <button class="btn btn-outline-primary" @onclick="VolverPantallaPrincipal">
        <i class="bi bi-house-door me-1"></i> Volver
    </button>
</div>


@if (PedidoActual?.Mesa != null)
{
    <h5>Mesa Nº @PedidoActual.Mesa.Numero</h5>
}

@if (PedidoActual == null)
{
    <p>Cargando pedido...</p>
}
else
{
    <div class="pedido-container">
        <!-- Panel de productos -->
        <div class="productos-panel">
            <!-- Categorías -->
            <ul class="nav nav-tabs" role="tablist" style="white-space: nowrap;">
                @foreach (var categoriaId in ProductosPorCategoria.Keys)
                {
                    var nombreCategoria = CategoriasDisponibles.FirstOrDefault(c => c.Id == categoriaId)?.Nombre ?? "Sin nombre";
                    <li class="nav-item" style="display: inline-block;">
                        <a class="nav-link @(CategoriaSeleccionada == categoriaId ? "active" : "")"
                           @onclick="() => CategoriaSeleccionada = categoriaId"
                           href="javascript:void(0)">
                            @nombreCategoria
                        </a>
                    </li>
                }
            </ul>

            <!-- Lista de productos con scroll -->
            <div class="productos-scroll">
                @if (CategoriaSeleccionada.HasValue && ProductosPorCategoria.TryGetValue(CategoriaSeleccionada.Value, out var productos))
                {
                    <div class="row mt-3">
                        @foreach (var producto in productos)
                        {
                            <div class="col-6 col-md-4 col-lg-3 mb-3">
                                <div class="card producto @(ObtenerClaseStock(producto.Stock))">
                                    <div class="card-body text-center">
                                        <h5>@producto.Nombre</h5>
                                        <p>@producto.Precio.ToString("C", new CultureInfo("es-AR"))</p>
                                        @if (producto.Stock > 0)
                                        {
                                            <button class="btn btn-primary btn-sm w-100" @onclick="() => AgregarItem(producto)">
                                                Agregar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm w-100" disabled>
                                                Sin stock
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Agregar por lista -->
     @*        @if (CategoriaSeleccionada.HasValue && ProductosPorCategoria.TryGetValue(CategoriaSeleccionada.Value, out var listaProductos))
            {
                <div class="mt-3">
                    <label><strong>Agregar por lista - @CategoriasDisponibles.FirstOrDefault(c => c.Id == CategoriaSeleccionada)?.Nombre</strong></label>
                    <select class="form-select" @onchange="async e => await AgregarProductoDesdeSelect(int.Parse(e.Value.ToString()))">
                        <option value="">-- Seleccionar producto --</option>
                        @foreach (var producto in listaProductos)
                        {
                            <option value="@producto.Id">@producto.Nombre (@producto.Precio.ToString("C", new CultureInfo("es-AR")))</option>
                        }
                    </select>
                </div>
            } *@
        </div>

        <!-- Panel de pedido actual -->
        <div class="pedido-panel">
            <h5>Detalle del Pedido</h5>
            @if (PedidoActual != null)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 p-2 bg-light border rounded" style="font-size:0.85rem;">
                    <div>Total sin descuento: <strong>@PedidoActual.TotalSinDescuento?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                    <div>Descuento: <strong>@PedidoActual.MontoDescuento?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                    <div>Total: <strong>@PedidoActual.Total?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                </div>
            }

            @if (PedidoActual.DetallePedido.Any() || PedidoActual.PedidoCombos.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var item in PedidoActual.DetallePedido)
                    {
                        var total = item.Cantidad * item.PrecioUnitario;
                        <div class="card p-2 d-flex flex-row align-items-center justify-content-between">
                            <div>
                                <div><strong>@item.Producto.Nombre</strong> x @item.Cantidad</div>
                                <div>Total: @total.ToString("C", new CultureInfo("es-AR"))</div>
                                @if (!string.IsNullOrWhiteSpace(item.Comentario))
                                {
                                    <div class="text-muted small">💬 @item.Comentario</div>
                                }
                            </div>
                            <div class="">
                                <a class="btn btn-sm btn-outline-danger text-danger px-3 mb-0" @onclick="() => EliminarItem(item.Id)">
                                    <i class="bi bi-trash me-2"></i>Eliminar
                                </a>
                                <a class="btn btn-sm btn-outline-warning text-warning px-3 mb-0" @onclick="() => EditarItem(item.Id)">
                                    <i class="bi bi-pencil me-2"></i>Editar
                                </a>
                            </div>
                        </div>
                    }

                    @foreach (var combo in PedidoActual.PedidoCombos)
                    {
                        var total = combo.Cantidad * combo.Precio;
                        <div class="card p-2 d-flex flex-row align-items-center justify-content-between" style="background-color: #fff8dc;">
                            <div>
                                <strong>[Combo]</strong> @combo.Nombre x @combo.Cantidad
                                <div>Total: @total.ToString("C", new CultureInfo("es-AR"))</div>
                                @if (!string.IsNullOrWhiteSpace(combo.Comentario))
                                {
                                    <div class="text-muted small">💬 @combo.Comentario</div>
                                }
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <a class="btn btn-sm btn-outline-info px-3 mb-0" @onclick="() => MostrarDetalleCombo(combo)">
                                    <i class="bi bi-eye me-2"></i>Productos
                                </a>
                                <a class="btn btn-sm btn-outline-warning text-warning px-3 mb-0" @onclick="() => AbrirModalEditarCombo(combo)">
                                    <i class="bi bi-pencil me-2"></i>Editar
                                </a>
                                <a class="btn btn-sm btn-outline-danger text-danger px-3 mb-0" @onclick="() => EliminarCombo(combo.Id)">
                                    <i class="bi bi-trash me-2"></i>Eliminar
                                </a>
                            </div>
                        </div>
                    }

                </div>

                @if (PedidoActual?.EstadoId == (int)Enums.EstadoPedido.Abierto && PedidoActual.DetallePedido.Count > 0)
                {
                    <button class="btn btn-success btn-lg mt-3 w-100" @onclick="ConfirmarPedido">
                        Confirmar pedido y enviar a cocina
                    </button>
                }
                @if (PromocionesDisponibles.Any())
                {
                    <button class="btn btn-secondary btn-lg w-100" @onclick="AbrirModalPromociones">
                        Ver promociones disponibles
                    </button>
                }
            }
            else
            {
                <p class="text-muted">No hay productos en el pedido</p>
            }
        </div>
    </div>
}



<!-- Modal Agregar Producto -->
@if (ModalAgregarVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar: @ProductoSeleccionado?.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalAgregar"></button>
                </div>
                <div class="modal-body">
                    <label>Cantidad</label>
                    <input type="number" min="1" class="form-control" @bind="CantidadAgregar" />

                    <label class="mt-2">Comentario</label>
                    <textarea class="form-control" rows="2" @bind="ComentarioAgregar"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalAgregar">Cancelar</button>
                    <button class="btn btn-primary" @onclick="ConfirmarAgregar">Agregar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para mostrar detalle del combo -->
@if (ComboDetalleVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@ComboDetalleSeleccionado?.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalDetalleCombo"></button>
                </div>
                <div class="modal-body">
                    <ul>
                        @foreach (var item in ComboDetalleSeleccionado?.Items ?? new List<PedidoComboItemViewModel>())
                        {
                            <li>@item.NombreProducto x @item.Cantidad</li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalDetalleCombo">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
