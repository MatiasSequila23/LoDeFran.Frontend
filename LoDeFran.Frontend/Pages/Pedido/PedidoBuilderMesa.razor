                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalEditarCombo">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarEdicionCombo">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}
<!-- Modal Editar Producto -->
@if (ModalEditarVisible && ItemEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar: @ItemEditando.Producto?.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditar"></button>
                </div>
                <div class="modal-body">
                    <label>Cantidad</label>
                    <div class="input-group mb-2" style="max-width:220px;">
                        <button class="btn btn-dark" @onclick="DecrementarCantidad"><i class="bi bi-dash-lg"></i></button>
                        <input type="text" class="form-control text-center" @bind="EditCantidad" />
                        <button class="btn btn-dark" @onclick="IncrementarCantidad"><i class="bi bi-plus-lg"></i></button>
                    </div>
                    <label>Comentario</label>
                    <textarea class="form-control" rows="2" @bind="EditComentario"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalEditar">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarEdicionItem">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}
<div style="display:none">
    <div id="ticket-to-print">
        <h3>🍽️ Pedido #@PedidoActual.Id</h3>

        <p>
            @* Solo salón muestra mesa y mozo *@
            @if (PedidoActual.TipoPedidoId == 1 && PedidoActual.Mesa != null)
            {
                <span><strong>Mesa:</strong> @PedidoActual.Mesa.Numero</span>

                <br />
                <span><strong>Mozo:</strong> @PedidoActual.NombreMozo</span>

                <br />
            }

            @* Tipo y hora siempre *@
            <span><strong>Tipo:</strong> @PedidoActual.TipoPedidoNombre</span><br />
            <span><strong>Hora:</strong> @PedidoActual.FechaPedido?.ToString("HH:mm")</span><br />
        </p>

        <hr />

        <ul style="list-style-type:none; padding:0; margin:0;">
            @foreach (var item in PedidoActual.DetallePedido)
            {
                <li style="margin-bottom:8px;">
                    <strong>@item.Cantidad x @item.Producto.Nombre</strong>
                    <small>(@item.Producto.CategoriaProductoNombre)</small><br />

                    @if (!string.IsNullOrEmpty(item.Comentario))
                    {
                        <small>📝 @item.Comentario</small>
                    }
                </li>
            }

            @if (PedidoActual.PedidoCombos.Any())
            {
                <li>
                    <strong>Combos:</strong>
                    <ul style="list-style-type:circle; padding-left:15px;">
                        @foreach (var combo in PedidoActual.PedidoCombos)
                        {
                            <li>@combo.Nombre (x@combo.Cantidad)</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>
</div>

<div style="display:none">
    <iframe id="print-frame"></iframe>
</div>
@code {
    [Parameter] public int idPedido { get; set; }

    private PedidoViewModel? PedidoActual;
    private List<ProductoViewModel> ProductosDisponibles = new();
    private List<CategoriaProductoViewModel> CategoriasDisponibles = new();
    private int? CategoriaSeleccionada;
    private int? SubcategoriaSeleccionada;
    private List<CategoriaProductoViewModel> Menu;

    // Modal para agregar producto
    private bool ModalAgregarVisible = false;
    private bool ModalComentarioComboVisible  = false;
    private ProductoViewModel? ProductoSeleccionado;
    private int CantidadAgregar = 1;
    private string ComentarioAgregar = "";
    private string ComentarioCombo = "";

    // Modal para editar producto
    private bool ModalEditarVisible = false;
    private DetallePedidoViewModel? ItemEditando;
    private int EditCantidad = 1;
    private int EditSubtotal = 0;
    private string? EditComentario = "";

    // Combos
    private bool ComboDetalleVisible = false;
    private PedidoComboViewModel? ComboDetalleSeleccionado;

    // Promociones
    private List<PromocionViewModel> PromocionesDisponibles = new();
    private int? PromocionSeleccionadaId;

    protected override async Task OnInitializedAsync()
    {
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        PromocionSeleccionadaId = PedidoActual?.PromocionId;
        ProductosDisponibles = await ServicioDeMesaService.GetProductosAsync();
        CategoriasDisponibles = await ServicioDeMesaService.GetCategoriasProductosAsync();

        // Cargar menú completo con subcategorías y productos
        Menu = await CategoriaProductoService.GetMenuAsync();

        // Buscar la categoría Genérica (Id = 6)
        var categoriaGenerica = Menu.FirstOrDefault(c => c.Id == 6);
        if (categoriaGenerica != null)
        {
            // Crear subcategoría "Combos" si no existe
            var subcategoriaCombos = categoriaGenerica.Subcategorias
                .FirstOrDefault(sc => sc.Nombre == "Combos");
            if (subcategoriaCombos == null)
            {
                subcategoriaCombos = new SubcategoriaProductoViewModel
                    {
                        Id = -1, // Id temporal
                        Nombre = "Combos",
                        Productos = new List<ProductoViewModel>()
                    };
                categoriaGenerica.Subcategorias.Add(subcategoriaCombos);
            }

            // Obtener combos y agregarlos como productos a la subcategoría
            var combos = await ComboService.GetAllAsync();
            foreach (var combo in combos)
            {
                subcategoriaCombos.Productos.Add(new ProductoViewModel
                    {
                        Id = combo.Id,
                        Nombre = combo.Nombre,
                        Precio = combo.Precio,
                        Stock = Convert.ToInt32(combo.Stock),
                        CategoriaProductoId = 6 // Genérica
                    });
            }
        }

        // Seleccionar primera categoría y subcategoría por defecto
        CategoriaSeleccionada = Menu.FirstOrDefault()?.Id;
        SubcategoriaSeleccionada = Menu.FirstOrDefault()?.Subcategorias.FirstOrDefault()?.Id;

        // Cargar promociones disponibles
        PromocionesDisponibles = await PromocionService.ObtenerPromocionesParaPedidoAsync(idPedido);
    }

    private void SeleccionarCategoria(int id)
    {
        CategoriaSeleccionada = id;
        SubcategoriaSeleccionada = Menu.FirstOrDefault(c => c.Id == id)?.Subcategorias.FirstOrDefault()?.Id;
    }
    private Dictionary<int, List<ProductoViewModel>> ProductosPorCategoria =>
        ProductosDisponibles
            .Where(p => p.CategoriaProductoId.HasValue)
            .GroupBy(p => p.CategoriaProductoId.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());

    // --- Abrir modal agregar ---
    private void AbrirModalAgregar(ProductoViewModel producto)
    {
        ProductoSeleccionado = producto;
        CantidadAgregar = 1;
        ComentarioAgregar = "";
        ModalAgregarVisible = true;
    }
    private void CerrarModalAgregar() => ModalAgregarVisible = false;

    private async Task ConfirmarAgregar()
    {
        if (ProductoSeleccionado == null) return;

        if (ProductoSeleccionado.CategoriaProductoId == -1)
        {
            await PedidoService.AgregarComboAlPedidoAsync(idPedido, ProductoSeleccionado.Id, CantidadAgregar);
        }
        else
        {
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(idPedido, ProductoSeleccionado.Id, CantidadAgregar);
        }

        if (!string.IsNullOrEmpty(ComentarioAgregar))
        {
            var nuevoPedido = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
            var detalle = nuevoPedido.DetallePedido.LastOrDefault(d =>
                d.Producto.Id == ProductoSeleccionado.Id ||
                (ProductoSeleccionado.CategoriaProductoId == -1 && d.Id == ProductoSeleccionado.Id));

            if (detalle != null)
            {
                if (ProductoSeleccionado.CategoriaProductoId == -1)
                    await ComboService.ModificarComentarioComboAsync(detalle.Id, ComentarioAgregar);
                else
                    await DetallePedidoServicie.ModificarComentarioProductoAsync(detalle.Id, ComentarioAgregar);
            }
        }

        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        ModalAgregarVisible = false;
    }
    private async Task AgregarItem(ProductoViewModel producto)
    {
        if (producto.CategoriaProductoId == -1)
        {
            await JS.InvokeVoidAsync("console.log", "Enviando combo:", idPedido, "prod:", producto);
            await PedidoService.AgregarComboAlPedidoAsync(idPedido, producto.Id, 1);
        }
        else
        {
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(idPedido, producto.Id, 1);
        }

        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }
    // --- Editar item ---
    private void EditarItem(int idDetalle)
    {
        ItemEditando = PedidoActual?.DetallePedido.FirstOrDefault(d => d.Id == idDetalle);
        if (ItemEditando is null) return;
        EditCantidad = ItemEditando.Cantidad;
        EditSubtotal = Convert.ToInt32(ItemEditando.PrecioUnitario) * EditCantidad;
        EditComentario = ItemEditando.Comentario ?? "";
        ModalEditarVisible = true;
    }
    private void CerrarModalEditar()
    {
        ModalEditarVisible = false;
        ItemEditando = null;
        EditCantidad = 1;
        EditComentario = "";
    }
    private async Task GuardarEdicionItem()
    {
        if (ItemEditando is null) return;
        if (EditCantidad < 1) EditCantidad = 1;

        if (EditCantidad != ItemEditando.Cantidad)
            await ServicioDeMesaService.ModificarCantidadProductoAsync(ItemEditando.Id, EditCantidad);

        await DetallePedidoServicie.ModificarComentarioProductoAsync(ItemEditando.Id, EditComentario ?? "");
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        CerrarModalEditar();
    }
    private void IncrementarCantidad() => EditCantidad++;
    private void DecrementarCantidad() { if (EditCantidad > 1) EditCantidad--; }

