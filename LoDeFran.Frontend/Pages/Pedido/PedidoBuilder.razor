<div style="display:none">
    @foreach (var area in areas)
    {
        // 1️⃣ Filtrar productos para el área actual
        var productosArea = PedidoActual.DetallePedido
        .Where(p => p.Producto.CategoriaProductoId.HasValue &&
        area.Value.Contains(p.Producto.CategoriaProductoId.Value))
        .ToList();

        // 🚩 Ajuste especial para Barra: solo subcategorías 6 y 28
        if (area.Key == "Barra")
        {
            productosArea = productosArea
            .Where(p => p.Producto.SubcategoriaProductoId == 6 ||
            p.Producto.SubcategoriaProductoId == 28)
            .ToList();
        }

        // 2️⃣ Quedarse solo con productos pendientes (no confirmados)
        var productosPendientes = productosArea
        .Where(p => p.Cantidad > p.CantidadConfirmada)
        .ToList();

        // ⚠️ Si no hay nada pendiente en esta área, no se imprime ticket
        if (!productosPendientes.Any())
        {
            continue;
        }

        // 3️⃣ Detectar otras áreas combinadas
        var otrasAreas = areas
        .Where(a => a.Key != area.Key &&
        PedidoActual.DetallePedido.Any(p =>
        p.Producto.CategoriaProductoId.HasValue &&
        a.Value.Contains(p.Producto.CategoriaProductoId.Value)))
        .Select(a => a.Key)
        .ToList();

        // 4️⃣ Renderizar ticket SOLO con pendientes
            <div class="ticket-area" id="ticket-to-print-@area.Key">
                <h2>@area.Key</h2>

            @if (otrasAreas.Any())
            {
                        <h4 style="font-weight:bold; color:red;">
                            👉 Combina con: @string.Join(", ", otrasAreas)
                        </h4>
            }

                <h3>Pedido #@PedidoActual.Id</h3>

            @if (PedidoActual.TipoPedidoId == 1 && PedidoActual.Mesa != null)
            {
                        <p>
                            <span><strong>Mesa:</strong> @PedidoActual.Mesa.Numero</span><br />
                            <span><strong>Mozo:</strong> @PedidoActual.NombreMozo</span><br />
                        </p>
            }

                <p>
                    <span><strong>Tipo:</strong> @PedidoActual.TipoPedidoNombre</span><br />
                    <span><strong>Fecha - Hora:</strong> @PedidoActual.FechaPedido</span><br />
                </p>
                <hr />

                <ul style="list-style-type:none; padding:0; margin:0;">
                @foreach (var item in productosPendientes)
                {
                    int cant = item.Cantidad - item.CantidadConfirmada;

                            <li style="margin-bottom:8px;">
                                <strong>@cant x @item.Producto.Nombre</strong>
                        @if (!string.IsNullOrEmpty(item.Comentario))
                        {
                                        <small>(@item.Comentario)</small>
                        }
                            </li>
                }
                </ul>
            </div>
    }
</div>
<div id="ticket-cuenta" style="display:none; font-family: monospace; width:260px;">

    <!-- Encabezado -->
    <h3 style="text-align:center; margin:0;">🍕 Bar-Pizzería Lo De Fran</h3>
    <p style="text-align:center; font-size:11px; margin:0;">
        📞 Tel: 011-1234-5678<br />
        📍 Potosí 3800
    </p>

    <h4 style="text-align:center; margin:4px 0;">🧾 Cuenta - Pedido #@PedidoActual.Id</h4>

    <!-- Datos del cliente solo en Delivery (tipo 3) -->
    @if (PedidoActual.TipoPedidoId == 3)
    {
        <p style="margin:0; font-size:12px;">
            <strong>Cliente:</strong> @PedidoActual.ClienteNombre <br />
            <strong>Tel:</strong> @PedidoActual.Telefono <br />
            <strong>Dirección:</strong> @PedidoActual.Calle @PedidoActual.Altura
            @if (!string.IsNullOrWhiteSpace(PedidoActual.Piso))
            {
                <span>, Piso/Depto: @PedidoActual.Piso</span>
            }
        </p>
    }

    <!-- Fecha -->
    <p style="margin:5px 0; font-size:12px;">
        <strong>Fecha:</strong> @PedidoActual.FechaPedido?.ToString("dd/MM/yyyy HH:mm")
    </p>

    <hr />

    <!-- Detalle de productos -->
    <ul style="list-style:none; padding:0; margin:0; font-size:13px;">
        @foreach (var item in PedidoActual.DetallePedido)
        {
            <li style="display:flex; justify-content:space-between;">
                <span>@item.Cantidad x @item.Producto.Nombre</span>
                <span>@((item.Cantidad * item.PrecioUnitario).ToString("C", new CultureInfo("es-AR")))</span>
            </li>
        }

        @if (PedidoActual.PedidoCombos.Any())
        {
            <li><strong>Combos:</strong></li>
            @foreach (var combo in PedidoActual.PedidoCombos)
            {
                <li style="display:flex; justify-content:space-between; margin-left:10px;">
                    <span>@combo.Cantidad x @combo.Nombre</span>
                    <span>@((combo.Cantidad * combo.Precio).ToString("C", new CultureInfo("es-AR")))</span>
                </li>
            }
        }
    </ul>

    <hr />

    <!-- Totales -->
    @{
        var subtotal = PedidoActual.DetallePedido.Sum(x => x.Cantidad * x.PrecioUnitario)
        + PedidoActual.PedidoCombos.Sum(c => c.Cantidad * c.Precio);

        var descuento = PedidoActual.MontoDescuento ?? 0;
        var total = subtotal - descuento;
    }

    <p style="display:flex; justify-content:space-between; font-size:12px;">
        <strong>Subtotal:</strong> <span>@subtotal.ToString("C", new CultureInfo("es-AR"))</span>
    </p>

    @if (descuento > 0)
    {
        <p style="display:flex; justify-content:space-between; font-size:12px; color:#D81B60;">
            <strong>Descuento:</strong> <span>-@descuento.ToString("C", new CultureInfo("es-AR"))</span>
        </p>
    }

    <p style="display:flex; justify-content:space-between; font-size:14px;">
        <strong>Total:</strong> <span>@total.ToString("C", new CultureInfo("es-AR"))</span>
    </p>

    <hr />

    <!-- Mensaje de cortesía -->
    <p style="text-align:center; font-size:11px; margin-top:4px;">
        🙏 ¡Gracias por su compra! <br />
        Propina no incluida, se recomienda dejar 10% <br />
        *** Documento no válido como factura ***
    </p>
</div>



<div style="display:none">
    <iframe id="print-frame"></iframe>
</div>


@code {
    private Dictionary<string, int[]> areas = new()
    {
        { "Pizzería", new int[] { 1 ,6} }, // Pizzería y Combos
        { "Cocina", new int[] { 2, 5 } },  // Cocina y Postres
        { "Barra", new int[] { 3, 4 } }    // Bebidas y Cafetería
    };

    private async Task ImprimirTicketsPorArea()
    {
        var ticketIds = areas.Keys.ToList();

        foreach (var area in ticketIds)
        {
            var ticketDivId = $"ticket-to-print-{area}";
            await JS.InvokeVoidAsync("imprimirTicket", ticketDivId);
        }
    }
}


@code {
    [Parameter] public int idPedido { get; set; }

    private PedidoViewModel? PedidoActual;
    private List<ProductoViewModel> ProductosDisponibles = new();
    private List<CategoriaProductoViewModel> CategoriasDisponibles = new();
    private int? CategoriaSeleccionada;
    private int? SubcategoriaSeleccionada;
    private List<CategoriaProductoViewModel> Menu;
    private int? EstadoPedidoActualId => PedidoActual?.EstadoId;
    // Modal para agregar producto
    private bool ModalAgregarVisible = false;
    private bool ModalComentarioComboVisible = false;
    private ProductoViewModel? ProductoSeleccionado;
    private int CantidadAgregar = 1;
    private string ComentarioAgregar = "";
    private string ComentarioCombo = "";

    // Modal para editar producto
    private bool ModalEditarVisible = false;
    private DetallePedidoViewModel? ItemEditando;
    private int EditCantidad = 1;
    private int EditSubtotal = 0;
    private string? EditComentario = "";

    // Combos
    private bool ComboDetalleVisible = false;
    private PedidoComboViewModel? ComboDetalleSeleccionado;
    private bool combosCargados = false;

    // Promociones
    private List<PromocionViewModel> PromocionesDisponibles = new();
    private int? PromocionSeleccionadaId;
    private bool ModalPromocionesVisible = false;

    protected override async Task OnInitializedAsync()
    {
        // Cargar datos principales en paralelo
        var pedidoTask = ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        var productosTask = ServicioDeMesaService.GetProductosAsync();
        var categoriasTask = ServicioDeMesaService.GetCategoriasProductosAsync();
        var menuTask = CategoriaProductoService.GetMenuAsync();
        var promocionesTask = PromocionService.ObtenerPromocionesParaPedidoAsync(idPedido);

        await Task.WhenAll(pedidoTask, productosTask, categoriasTask, menuTask, promocionesTask);

        PedidoActual = await pedidoTask;
        ProductosDisponibles = await productosTask;
        CategoriasDisponibles = await categoriasTask;
        Menu = await menuTask;
        PromocionesDisponibles = await promocionesTask;

        PromocionSeleccionadaId = PedidoActual?.PromocionId;

        // Seleccionar primera categoría y subcategoría por defecto
        CategoriaSeleccionada = Menu.FirstOrDefault()?.Id;
        SubcategoriaSeleccionada = Menu.FirstOrDefault()?.Subcategorias.FirstOrDefault()?.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarCombos();
            combosCargados = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);

        }
    }

    private async Task CargarCombos()
    {
        var categoriaGenerica = Menu.FirstOrDefault(c => c.Id == 6);
        if (categoriaGenerica == null) return;

        var subcategoriaCombos = categoriaGenerica.Subcategorias
            .FirstOrDefault(sc => sc.Nombre == "Combos") ?? new SubcategoriaProductoViewModel
                {
                    Id = -1,
                    Nombre = "Combos",
                    Productos = new List<ProductoViewModel>()
                };

        if (!categoriaGenerica.Subcategorias.Contains(subcategoriaCombos))
            categoriaGenerica.Subcategorias.Add(subcategoriaCombos);

        var combos = await ComboService.GetAllAsync();
        foreach (var combo in combos)
        {
            subcategoriaCombos.Productos.Add(new ProductoViewModel
                {
                    Id = combo.Id,
                    Nombre = combo.Nombre,
                    Precio = combo.Precio,
                    Stock = Convert.ToInt32(combo.Stock),
                    CategoriaProductoId = 6
                });
        }
    }

    private void SeleccionarCategoria(int id)
    {
        CategoriaSeleccionada = id;
        SubcategoriaSeleccionada = Menu.FirstOrDefault(c => c.Id == id)?.Subcategorias.FirstOrDefault()?.Id;
    }

    private Dictionary<int, List<ProductoViewModel>> ProductosPorCategoria =>
        ProductosDisponibles
            .Where(p => p.CategoriaProductoId.HasValue)
            .GroupBy(p => p.CategoriaProductoId.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());

    // --- Abrir modal agregar ---
    private void AbrirModalAgregar(ProductoViewModel producto)
    {
        ProductoSeleccionado = producto;
        CantidadAgregar = 1;
        ComentarioAgregar = "";
        ModalAgregarVisible = true;
    }

    private void CerrarModalAgregar() => ModalAgregarVisible = false;

    private async Task ConfirmarAgregar()
    {
        if (ProductoSeleccionado == null) return;

        if (ProductoSeleccionado.CategoriaProductoId == -1)
        {
            await PedidoService.AgregarComboAlPedidoAsync(idPedido, ProductoSeleccionado.Id, CantidadAgregar);
        }
        else
        {
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(idPedido, ProductoSeleccionado.Id, CantidadAgregar);
        }

        // Actualizar comentario si aplica
        if (!string.IsNullOrEmpty(ComentarioAgregar))
        {
            var detalle = PedidoActual.DetallePedido.LastOrDefault(d =>
                d.Producto.Id == ProductoSeleccionado.Id ||
                (ProductoSeleccionado.CategoriaProductoId == -1 && d.Id == ProductoSeleccionado.Id));

            if (detalle != null)
            {
                if (ProductoSeleccionado.CategoriaProductoId == -1)
                    await ComboService.ModificarComentarioComboAsync(detalle.Id, ComentarioAgregar);
                else
                    await DetallePedidoServicie.ModificarComentarioProductoAsync(detalle.Id, ComentarioAgregar);
            }
        }

        // Solo actualizar detalle agregado localmente
        await ActualizarPedidoParcial();
        ModalAgregarVisible = false;
    }

    private async Task AgregarItem(ProductoViewModel producto)
    {
        if (producto.CategoriaProductoId == -1)
            await PedidoService.AgregarComboAlPedidoAsync(idPedido, producto.Id, 1);
        else
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(idPedido, producto.Id, 1);

        await ActualizarPedidoParcial();
    }

    // --- Editar item ---
    private void EditarItem(int idDetalle)
    {
        ItemEditando = PedidoActual?.DetallePedido.FirstOrDefault(d => d.Id == idDetalle);
        if (ItemEditando is null) return;
        EditCantidad = ItemEditando.Cantidad;
        EditSubtotal = Convert.ToInt32(ItemEditando.PrecioUnitario) * EditCantidad;
        EditComentario = ItemEditando.Comentario ?? "";
        ModalEditarVisible = true;
    }

    private void CerrarModalEditar()
    {
        ModalEditarVisible = false;
        ItemEditando = null;
        EditCantidad = 1;
        EditComentario = "";
    }

    private async Task GuardarEdicionItem()
    {
        if (ItemEditando is null) return;
        if (EditCantidad < 1) EditCantidad = 1;

        if (EditCantidad != ItemEditando.Cantidad)
            await ServicioDeMesaService.ModificarCantidadProductoAsync(ItemEditando.Id, EditCantidad);

        await DetallePedidoServicie.ModificarComentarioProductoAsync(ItemEditando.Id, EditComentario ?? "");
        await ActualizarPedidoParcial();
        CerrarModalEditar();
    }

    private void IncrementarCantidad() => EditCantidad++;
    private void DecrementarCantidad() { if (EditCantidad > 1) EditCantidad--; }

    // --- Actualización parcial ---
    private async Task ActualizarPedidoParcial()
    {
        // Solo recargar detalles para no bloquear la UI
        var pedidoActualizado = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        PedidoActual.DetallePedido = pedidoActualizado.DetallePedido;
        PedidoActual.Total = pedidoActualizado.Total;
        StateHasChanged();
    }

    // --- Otros métodos similares al original ---
    private async Task EliminarItem(int idDetalle)
    {
        bool confirmacion = await JS.InvokeAsync<bool>(
                "mostrarConfirmacion",
                "Confirmar",
                "¿Seguro que deseas eliminar?"
            );
        if (!confirmacion) return;

        await ServicioDeMesaService.DeleteAsync(idPedido, idDetalle);
        await ActualizarPedidoParcial();
    }

    private string ObtenerClaseStock(int stock)
    {
        if (stock <= 0) return "sin-stock";
        if (stock < 5) return "stock-bajo";
        return "stock-disponible";
    }

    private void AbrirModalPromociones() => ModalPromocionesVisible = true;
    private void CerrarModalPromociones() => ModalPromocionesVisible = false;

    private async Task AplicarPromocion(int promoId)
    {
        await PromocionService.AsignarPromocionAlPedidoAsync(idPedido, promoId);
        PromocionSeleccionadaId = promoId;
        await ActualizarPedidoParcial();
        ModalPromocionesVisible = false;
    }

    private void AbrirModalComentarioCombo(PedidoComboViewModel combo)
    {
        ComboDetalleSeleccionado = combo;
        ComentarioCombo = combo.Comentario;
        ModalComentarioComboVisible = true;
    }

    private async Task GuardarComentarioCombo()
    {
        if (ComboDetalleSeleccionado != null)
        {
            await ComboService.ModificarComentarioComboAsync(ComboDetalleSeleccionado.Id, ComentarioCombo ?? "");
            await ActualizarPedidoParcial();
            ModalComentarioComboVisible = false;
        }
    }

    // --- Modales de combos, incrementos y ediciones ---
    private bool ModalEditarComboVisible = false;
    private PedidoComboViewModel ComboEditando;
    private int EditCantidadCombo;
    private string EditComentarioCombo;

    private void AbrirModalEditarCombo(PedidoComboViewModel combo)
    {
        ComboEditando = combo;
        EditCantidadCombo = combo.Cantidad;
        EditComentarioCombo = combo.Comentario;
        ModalEditarComboVisible = true;
    }

    private void CerrarModalEditarCombo()
    {
        ModalEditarComboVisible = false;
        ComboEditando = null;
    }

    private async Task GuardarEdicionCombo()
    {
        if (ComboEditando != null)
        {
            var request = new Utlis.ClassAux.ActualizarComboRequest
                {
                    PedidoId = idPedido,
                    ComboId = ComboEditando.Id,
                    Cantidad = EditCantidadCombo,
                    Comentario = EditComentarioCombo ?? ""
                };

            await PedidoService.ActualizarCombo(request);
            await ActualizarPedidoParcial();
            ModalEditarComboVisible = false;
            ComboEditando = null;
        }
    }
    private void MostrarDetalleCombo(PedidoComboViewModel combo)
    {
        ComboDetalleSeleccionado = combo;
        ComboDetalleVisible = true;
    }
    private async Task EliminarCombo(int comboId)
    {
        // var combo = PedidoActual.PedidoCombos.FirstOrDefault(c => c.Id == comboId);
        // if (combo != null)
        // {
        //     _context.PedidoCombos.Remove(combo);
        //     await _context.SaveChangesAsync();
        //     PedidoActual.PedidoCombos.Remove(combo);
        //     // Recalcular totales si querés
        // }
    }
    private async Task ConfirmarPedido()
    {
        bool confirmacion = await JS.InvokeAsync<bool>(
                "mostrarConfirmacion",
                "Confirmar pedido",
                "¿Seguro que deseas confirmar y enviar el pedido a cocina?"
            ); if (!confirmacion) return;

        foreach (var item in PedidoActual.DetallePedido)
        {
            if (item.EstadoCocinaId == (int)Enums.EstadoDetallePedidoCocina.Pendiente)
            {
                await DetallePedidoServicie.ActualizarEstadoCocinaAsync(item.Id, (int)Enums.EstadoDetallePedidoCocina.EnPreparacion);
            }
        }
        await PedidoService.CambiarEstadoAsync(idPedido, Utlis.Enums.EstadoPedido.EnPreparacion);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);


        foreach (var item in PedidoActual.DetallePedido)
        {
            await DetallePedidoServicie.ModificarCantidadConfirmProductoAsync(item.Id, item.Cantidad);
        }

        // Imprime el ticket
        var ticketIds = areas.Keys.ToList();

        foreach (var area in ticketIds)
        {
            var ticketDivId = $"ticket-to-print-{area}";
            await JS.InvokeVoidAsync("imprimirTicket", ticketDivId);
        }

    }
    private void CerrarModalDetalleCombo()
    {
        ComboDetalleVisible = false;
        ComboDetalleSeleccionado = null;
    }
    private void IncrementarCantidadCombo() => EditCantidadCombo++;
    private void DecrementarCantidadCombo() { if (EditCantidadCombo > 1) EditCantidadCombo--; }

    private async Task ImprimirCuenta()
    {
        await JS.InvokeVoidAsync("imprimirEnIframe", "ticket-cuenta");
    }

}
