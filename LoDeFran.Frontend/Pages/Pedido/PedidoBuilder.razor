@page "/Pedido/PedidoBuilder/{idPedido:int}"
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ComboService ComboService
@inject Services.PedidoService PedidoService
@inject Services.DetallePedidoServicie DetallePedidoServicie
@inject Services.CategoriaProductoService CategoriaProductoService
@inject Services.PromocionService PromocionService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Globalization
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Utlis
@using System.Linq

<!-- CSS y Scripts -->

<script src="../js/print.js"></script>
<link href="../css/imprimir.css" rel="stylesheet" />
<link href="../css/pedidomesa.css" rel="stylesheet" />

<style>
    .pedido-container {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        height: calc(100vh - 180px);
    }

    .productos-panel {
        flex: 2 1 300px;
        border-right: 2px solid #eee;
        padding-right: 0.5rem;
        height: 100%;
    }

    .productos-scroll {
        max-height: 70vh;
        overflow-y: auto;
        padding-right: 5px;
    }

    .pedido-panel {
        flex: 1 1 250px;
        overflow-y: auto;
        padding-left: 0.5rem;
        background: #fafafa;
        border-left: 2px solid #eee;
        height: 100%;
    }

    .card.producto {
        min-height: 130px;
    }

    .card.stock-disponible {
        background-color: #e9f9e9;
    }

    .card.stock-bajo {
        background-color: #fffbe6;
    }

    .card.sin-stock {
        background-color: #fdecea;
    }
</style>

<!-- Header -->
<div class="card shadow-lg mb-4 border-0 rounded-3">
    <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
        <h4 class="mb-0 text-white"><i class="fas fa-users me-2"></i> Pedido - Agregar Productos</h4>
    </div>
</div>

@if (PedidoActual == null)
{
        <p>Cargando pedido...</p>
}
else
{
        <div class="pedido-container">

            <!-- Panel de productos -->
            <div class="productos-panel">
            @if (Menu.Any())
            {
                        <!-- Categorías -->
                        <ul class="nav nav-tabs" role="tablist" style="white-space: nowrap;">
                    @foreach (var categoria in Menu)
                    {
                                    <li class="nav-item" style="display: inline-block;">
                                        <a class="nav-link @(CategoriaSeleccionada == categoria.Id ? "active" : "")"
                                           @onclick="() => SeleccionarCategoria(categoria.Id)"
                                           href="javascript:void(0)">
                                @categoria.Nombre
                                        </a>
                                    </li>
                    }
                        </ul>

                        <!-- Subcategorías -->
                @if (CategoriaSeleccionada.HasValue)
                {
                    var subcategorias = Menu.FirstOrDefault(c => c.Id == CategoriaSeleccionada.Value)?.Subcategorias;
                    if (subcategorias != null)
                    {
                                        <div class="subcategorias-scroll mt-2 mb-3" style="overflow-x: auto; white-space: nowrap; padding-bottom: 0.5rem;">
                            @foreach (var sub in subcategorias)
                            {
                                                    <button class="btn me-2"
                                                            style="border-radius:10px; background-color:@(SubcategoriaSeleccionada==sub.Id?"#CDE7FF":"#E6F2FF"); color:@(SubcategoriaSeleccionada==sub.Id?"#333":"#555");"
                                                            @onclick="() => SubcategoriaSeleccionada = sub.Id">
                                    @sub.Nombre
                                                    </button>
                            }
                                        </div>
                    }
                }

                        <!-- Lista de productos -->
                        <div class="productos-scroll mt-3">
                    @if (SubcategoriaSeleccionada.HasValue)
                    {
                        var productos = Menu
                        .FirstOrDefault(c => c.Id == CategoriaSeleccionada.Value)?
                        .Subcategorias
                        .FirstOrDefault(sc => sc.Id == SubcategoriaSeleccionada.Value)?
                        .Productos;

                        @if (productos != null && productos.Any())
                        {
                                            <div class="row">
                                @foreach (var producto in productos)
                                {
                                                        <div class="col-6 col-md-4 col-lg-3 mb-3">
                                                            <div class="card producto @(ObtenerClaseStock(producto.Stock)) h-100">
                                                                <div class="card-body text-center d-flex flex-column">
                                                                    <h5 class="card-title">@producto.Nombre</h5>
                                                                    <p class="card-text fw-bold">@producto.Precio.ToString("C", new CultureInfo("es-AR"))</p>
                                                                    <div class="mt-auto">
                                                    @if (producto.Stock > 0)
                                                    {
                                                                                <button class="btn btn-primary btn-sm w-100"
                                                                                        @onclick="() => AgregarItem(producto)">
                                                                                    Agregar
                                                                                </button>
                                                    }
                                                    else
                                                    {
                                                                                <button class="btn btn-secondary btn-sm w-100" disabled>Sin stock</button>
                                                    }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                }
                                            </div>
                        }
                        else
                        {
                                            <p class="text-muted mt-2">No hay productos en esta subcategoría</p>
                        }
                    }
                        </div>
            }
            else
            {
                        <p class="text-muted">No hay categorías disponibles</p>
            }
            </div>

            <!-- Panel de pedido actual -->
            <div class="pedido-panel">
                <h5>Detalle del Pedido</h5>
            @if (PedidoActual != null)
            {
                        <div class="d-flex justify-content-between align-items-center mt-2 p-2 bg-light border rounded" style="font-size:0.85rem;">
                            <div>Total sin descuento: <strong>@PedidoActual.TotalSinDescuento?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                            <div>Descuento: <strong>@PedidoActual.MontoDescuento?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                            <div>Total: <strong>@PedidoActual.Total?.ToString("C", new CultureInfo("es-AR"))</strong></div>
                        </div>
            }

            @if (PedidoActual.DetallePedido.Any() || PedidoActual.PedidoCombos.Any())
            {
                        <div class="d-flex flex-column gap-2">
                    @foreach (var item in PedidoActual.DetallePedido)
                    {
                        var totales = item.Cantidad * item.PrecioUnitario;
                                    <div class="card p-2 d-flex flex-row align-items-center justify-content-between">
                                        <div>
                                            <div><strong>@item.Producto.Nombre</strong> x @item.Cantidad</div>
                                            <div>Total: @totales.ToString("C", new CultureInfo("es-AR"))</div>
                                @if (!string.IsNullOrWhiteSpace(item.Comentario))
                                {
                                                    <div class="text-muted small">💬 @item.Comentario</div>
                                }
                                        </div>
                                        <div class="">
                                            <a class="btn btn-sm btn-outline-danger text-danger px-3 mb-0" @onclick="() => EliminarItem(item.Id)">
                                                <i class="bi bi-trash me-2"></i>Eliminar
                                            </a>
                                            <a class="btn btn-sm btn-outline-warning text-warning px-3 mb-0" @onclick="() => EditarItem(item.Id)">
                                                <i class="bi bi-pencil me-2"></i>Editar
                                            </a>
                                        </div>
                                    </div>
                    }

                    @foreach (var combo in PedidoActual.PedidoCombos)
                    {
                        var totalOtro = combo.Cantidad * combo.Precio;
                                    <div class="card p-2 d-flex flex-row align-items-center justify-content-between" style="background-color: #fff8dc;">
                                        <div>
                                            <strong>[Combo]</strong> @combo.Nombre x @combo.Cantidad
                                <div>Total: @totalOtro.ToString("C", new CultureInfo("es-AR"))</div>
                                @if (!string.IsNullOrWhiteSpace(combo.Comentario))
                                {
                                                    <div class="text-muted small">💬 @combo.Comentario</div>
                                }
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            <a class="btn btn-sm btn-outline-info px-3 mb-0" @onclick="() => MostrarDetalleCombo(combo)">
                                                <i class="bi bi-eye me-2"></i>Productos
                                            </a>
                                            <a class="btn btn-sm btn-outline-warning text-warning px-3 mb-0" @onclick="() => AbrirModalEditarCombo(combo)">
                                                <i class="bi bi-pencil me-2"></i>Editar
                                            </a>
                                            <a class="btn btn-sm btn-outline-danger text-danger px-3 mb-0" @onclick="() => EliminarCombo(combo.Id)">
                                                <i class="bi bi-trash me-2"></i>Eliminar
                                            </a>
                                        </div>
                                    </div>
                    }
                        </div>

                    <button class="btn btn-success btn-lg mt-3 w-100" @onclick="ConfirmarPedido">Confirmar pedido y enviar a cocina</button>
                @if (PromocionesDisponibles.Any())
                {
                                <button class="btn btn-secondary btn-lg w-100" @onclick="AbrirModalPromociones">Ver promociones disponibles</button>
                }
                @if (PedidoActual?.EstadoId != (int)Enums.EstadoPedido.Abierto && PedidoActual.DetallePedido.Count > 0)
                {
                    <button class="btn btn-warning btn-lg w-100" @onclick="ImprimirTicketsPorArea">
                        Volver a imprimir comanda
                    </button>
                }
                @if (EstadoPedidoActualId == (int)Utlis.Enums.EstadoPedido.Entregado)
                {
                    <button class="btn btn-danger btn-lg w-100"
                            @onclick="() => ImprimirCuenta()">
                        Generar cuenta
                    </button>
                }
            }
            else
            {
                        <p class="text-muted">No hay productos en el pedido</p>
            }
            </div>
        </div>
}
<!-- Modal Agregar Producto -->
