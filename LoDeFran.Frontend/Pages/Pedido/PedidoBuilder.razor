@page "/Pedido/PedidoBuilder/{idPedido:int}"
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ComboService ComboService
@inject Services.PedidoService PedidoService
@inject Services.PromocionService PromocionService
@inject Services.DetallePedidoServicie DetallePedidoServicie
@inject Services.ClienteService ClienteService

@inject IJSRuntime JS
@using System.Globalization
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Utlis
<style>
    .card.stock-disponible {
        background-color: #e9f9e9; /* verde pastel */
    }

    .card.stock-bajo {
        background-color: #fffbe6; /* amarillo pastel */
    }

    .card.sin-stock {
        background-color: #fdecea; /* rojo pastel */
    }

</style>
<h3 class="text-center d-flex justify-content-center align-items-center gap-2">
    Pedido - Agregar Productos

</h3>

@if (PedidoActual?.Mesa != null)
{
    <h4>Mesa Nº @PedidoActual.Mesa.Numero</h4>
}

@if (PedidoActual == null)
{
    <p>Cargando pedido...</p>
}
else
{


    @if (PedidoActual != null)
    {
        <div class="mt-3">
            <h6>Total sin descuento: @PedidoActual.TotalSinDescuento?.ToString("C", new CultureInfo("es-AR"))</h6>
            <h6>Descuento: @PedidoActual.MontoDescuento?.ToString("C", new CultureInfo("es-AR"))</h6>
            <h6>Total con descuento: @PedidoActual.Total?.ToString("C", new CultureInfo("es-AR"))</h6>
        </div>
    }



    <div>
        <ul class="nav nav-tabs mt-4" role="tablist">
            @foreach (var categoriaId in ProductosPorCategoria.Keys)
            {
                var nombreCategoria = CategoriasDisponibles.FirstOrDefault(c => c.Id == categoriaId)?.Nombre ?? "Sin nombre";
                <li class="nav-item">
                    <a class="nav-link @(CategoriaSeleccionada == categoriaId ? "active" : "")"
                       @onclick="() => CategoriaSeleccionada = categoriaId"
                       href="javascript:void(0)">
                        @nombreCategoria
                    </a>
                </li>
            }
        </ul>

        @if (CategoriaSeleccionada.HasValue && ProductosPorCategoria.TryGetValue(CategoriaSeleccionada.Value, out var productos))
        {
            <div class="row mt-3">
                @foreach (var producto in productos)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 @(ObtenerClaseStock(producto.Stock))">

                            <div class="card-body text-center">
                                <h6 class="card-title">@producto.Nombre</h6>
                                <p class="card-text">@producto.Precio.ToString("C", new CultureInfo("es-AR"))</p>
                                <p class="text-muted">Stock: @producto.Stock</p>

                                @if (producto.Stock > 0)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => AgregarItem(producto)">
                                        Agregar
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>
                                        Sin stock
                                    </button>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <label><strong>Agregar por lista - @CategoriasDisponibles.FirstOrDefault(c => c.Id == CategoriaSeleccionada)?.Nombre</strong></label>
                <select class="form-select" @onchange="async e => await AgregarProductoDesdeSelect(int.Parse(e.Value.ToString()))">
                    <option value="">-- Seleccionar producto --</option>
                    @foreach (var producto in productos)
                    {
                        <option value="@producto.Id">@producto.Nombre (@producto.Precio.ToString("C", new CultureInfo("es-AR")))</option>
                    }
                </select>
            </div>
        }

        @if (PedidoActual.DetallePedido.Any())
        {
            <h5 class="mt-4">Detalle del Pedido</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto / Combo</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Total</th>
                        <th>Comentario</th>
                        <th>Estado Cocina</th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PedidoActual.DetallePedido)
                    {
                        var total = item.PrecioUnitario * item.Cantidad;
                        <tr>
                            <td>@item.Producto.Nombre</td>
                            <td>@item.Cantidad</td>
                            <td>@item.PrecioUnitario.ToString("C", new CultureInfo("es-AR"))</td>
                            <td>@total.ToString("C", new CultureInfo("es-AR"))</td>
                            <td>
                                <textarea type="text" class="form-control"
                                          value="@item.Comentario"
                                          @onchange="async e => await ActualizarComentario(item.Id, e.Value?.ToString())" />
                            </td>
                            <td>@item.EstadoCocinaNombre</td>

                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarItem(item.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }

                    @foreach (var combo in PedidoActual.PedidoCombos)
                    {
                        var total = combo.Precio * combo.Cantidad;
                        <tr class="table-warning">
                            <td>
                                <strong>[Combo]</strong> @combo.Nombre
                            </td>
                            <td>@combo.Cantidad</td>
                            <td>@combo.Precio.ToString("C", new CultureInfo("es-AR"))</td>
                            <td>@total.ToString("C", new CultureInfo("es-AR"))</td>
                            <td>
                                <textarea type="text" class="form-control"
                                          value="@combo.Comentario"
                                          @onchange="async f => await ActualizarComentarioCombo(combo.Id, f.Value?.ToString())" />
                            </td>
                            <td>sin estado</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="() => MostrarDetalleCombo(combo)">Ver productos</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (PedidoActual.EstadoId == (int)Enums.EstadoPedido.Abierto && PedidoActual.DetallePedido.Count > 0)
            {
                <button class="btn btn-success mt-3" @onclick="ConfirmarPedido">
                    Confirmar pedido y enviar a cocina
                </button>
            }


        }

    </div>

    <!-- Modal para mostrar detalle del combo -->
    @if (ComboDetalleVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@ComboDetalleSeleccionado?.Nombre</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalDetalleCombo"></button>
                    </div>
                    <div class="modal-body">
                        <ul>
                            @foreach (var item in ComboDetalleSeleccionado?.Items ?? new List<PedidoComboItemViewModel>())
                            {
                                <li>@item.NombreProducto x @item.Cantidad</li>
                            }
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarModalDetalleCombo">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (PromocionesDisponibles.Any())
    {
        <div class="mt-4">
            <label for="promoSelect"><strong>Promociones disponibles</strong></label>
            <select id="promoSelect" class="form-select" value="@PromocionSeleccionadaId?.ToString()" @onchange="OnSeleccionarPromocion">
                <option value="">-- Seleccione una promoción --</option>
                @foreach (var promo in PromocionesDisponibles)
                {
                    <option value="@promo.Id">@promo.Nombre - @promo.ValorDescuento% (@promo.Descripcion)</option>
                }
            </select>


        </div>
    }



}
<div class="modal fade" id="modalAsignarCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Asignar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input class="form-control mb-2" placeholder="Buscar cliente (teléfono, email, calle...)" @bind="BusquedaCliente" @bind:event="oninput" />

                @if (ClientesEncontrados.Any())
                {
                    <select class="form-select" @bind="ClienteSeleccionadoId">
                        <option value="">-- Seleccionar cliente --</option>
                        @foreach (var cliente in ClientesEncontrados)
                        {
                            <option value="@cliente.Id">@cliente.Nombre @cliente.Apellido - @cliente.Telefono</option>
                        }
                    </select>
                }

                <hr />
                <h6>O crear nuevo cliente:</h6>
                <input class="form-control mb-2" placeholder="Nombre" @bind="NuevoCliente.Nombre" />
                <input class="form-control mb-2" placeholder="Apellido" @bind="NuevoCliente.Apellido" />
                <input class="form-control mb-2" placeholder="Teléfono" @bind="NuevoCliente.Telefono" />
                <input class="form-control mb-2" placeholder="Email" @bind="NuevoCliente.Email" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" @onclick="AsignarOCrearCliente">Guardar Cliente</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int idPedido { get; set; }

    private PedidoViewModel nuevoPedido = new();
    private List<PedidoViewModel> Pedidos = new();
    private string? mensajeExito;
    private string _busquedaCliente = "";
    Guid claveTabla = Guid.NewGuid();

    private string BusquedaCliente
    {
        get => _busquedaCliente;
        set
        {
            if (_busquedaCliente != value)
            {
                _busquedaCliente = value;
                _ = BuscarClienteAutomaticamente();
            }
        }
    }
    private async Task BuscarClienteAutomaticamente()
    {
        if (BusquedaCliente.Trim().Length >= 3)
        {
            ClientesEncontrados = await ServicioDeMesaService.BuscarClientesAsync(BusquedaCliente.Trim());
            BuscoCliente = true;
            StateHasChanged();
        }
        else
        {
            ClientesEncontrados.Clear();
            BuscoCliente = false;
        }
    }
    private async Task AsignarOCrearCliente()
    {
        int clienteId;

        if (ClienteSeleccionadoId.HasValue)
        {
            clienteId = ClienteSeleccionadoId.Value;
        }
        else
        {
            var clienteCreado = await ClienteService.CrearClienteAsync(NuevoCliente);
            clienteId = clienteCreado.Id;
        }

        // asignar cliente al pedido
        await PedidoService.AsignarClienteAsync(idPedido, clienteId);

        PedidoActual.ClienteId = clienteId;
        ClienteSeleccionadoId = clienteId;

        await JS.InvokeVoidAsync("cerrarModal", "#modalAsignarCliente");
    }

    private bool BuscoCliente = false;
    private List<ClienteViewModel> ClientesEncontrados = new();
    private int? ClienteSeleccionadoId;
    private ClienteViewModel NuevoCliente = new();
    private ClienteViewModel? ClienteSeleccionado;
    private DotNetObjectReference<PedidoBuilder>? _dotNetRef;

    private PedidoViewModel? PedidoActual;
    private List<ProductoViewModel> ProductosDisponibles = new();
    private List<CategoriaProductoViewModel> CategoriasDisponibles = new();
    private int? CategoriaSeleccionada;
    private bool ComboDetalleVisible = false;
    private PedidoComboViewModel? ComboDetalleSeleccionado;

    private List<PromocionViewModel> PromocionesDisponibles = new();
    private int? PromocionSeleccionadaId;


    protected override async Task OnInitializedAsync()
    {
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
        PromocionSeleccionadaId = PedidoActual?.PromocionId;
        ProductosDisponibles = await ServicioDeMesaService.GetProductosAsync();
        CategoriasDisponibles = await ServicioDeMesaService.GetCategoriasProductosAsync();

        // Obtener combos y agregarlos como productos ficticios (categoría -1)
        var combos = await ComboService.GetAllAsync();
        foreach (var combo in combos)
        {
            ProductosDisponibles.Add(new ProductoViewModel
                {
                    Id = combo.Id,
                    Nombre = $"[Combo] {combo.Nombre}",
                    Precio = combo.Precio,
                    CategoriaProductoId = -1,
                    Stock = Convert.ToInt32(combo.Stock)
                });
        }

        CategoriasDisponibles.Insert(0, new CategoriaProductoViewModel { Id = -1, Nombre = "Combos" });

        CategoriaSeleccionada = CategoriasDisponibles.FirstOrDefault()?.Id;

        PromocionesDisponibles = await PromocionService.ObtenerPromocionesParaPedidoAsync(idPedido);

    }

    private async Task AgregarItem(ProductoViewModel producto)
    {
        if (producto.CategoriaProductoId == -1)
        {
            await JS.InvokeVoidAsync("console.log", "Enviando combo:", idPedido, "prod:", producto);
            await PedidoService.AgregarComboAlPedidoAsync(idPedido, producto.Id, 1);
        }
        else
        {
            await ServicioDeMesaService.AgregarProductoAlPedidoAsync(idPedido, producto.Id, 1);
        }

        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }

    private async Task AgregarProductoDesdeSelect(int idProducto)
    {
        if (idProducto == 0)
            return;

        var cantidadStr = await JS.InvokeAsync<string>("prompt", "¿Cantidad a agregar?");
        if (int.TryParse(cantidadStr, out int cantidad) && cantidad > 0)
        {
            var producto = ProductosDisponibles.FirstOrDefault(p => p.Id == idProducto);
            if (producto != null)
            {
                // Clon manual
                var copia = new ProductoViewModel
                    {
                        Id = producto.Id,
                        Nombre = producto.Nombre,
                        Precio = producto.Precio,
                        CategoriaProductoId = producto.CategoriaProductoId
                    };

                await AgregarItem(copia);
            }
        }
    }

    private async Task EliminarItem(int idDetalle)
    {
        await ServicioDeMesaService.DeleteAsync(idPedido, idDetalle);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }

    private async Task CambiarCantidad(int idDetalle, int nuevaCantidad)
    {
        await ServicioDeMesaService.ModificarCantidadProductoAsync(idDetalle, nuevaCantidad);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }
    private void MostrarDetalleCombo(PedidoComboViewModel combo)
    {
        ComboDetalleSeleccionado = combo;
        ComboDetalleVisible = true;
    }

    private void CerrarModalDetalleCombo()
    {
        ComboDetalleVisible = false;
        ComboDetalleSeleccionado = null;
    }
    private Dictionary<int, List<ProductoViewModel>> ProductosPorCategoria =>
        ProductosDisponibles
            .Where(p => p.CategoriaProductoId.HasValue)
            .GroupBy(p => p.CategoriaProductoId.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());


    private async Task OnSeleccionarPromocion(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int promoId))
        {
            PromocionSeleccionadaId = promoId;
            await PromocionService.AsignarPromocionAlPedidoAsync(idPedido, promoId);
            PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
            StateHasChanged();
        }
    }
    private string ObtenerClaseStock(int stock)
    {
        if (stock == 0)
            return "sin-stock";
        if (stock < 5)
            return "stock-bajo";
        return "stock-disponible";
    }
    private async Task ActualizarComentario(int idDetalle, string? comentario)
    {
        await DetallePedidoServicie.ModificarComentarioProductoAsync(idDetalle, comentario ?? "");
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }
    private async Task ActualizarComentarioCombo(int idDetalle, string? comentario)
    {
        await ComboService.ModificarComentarioComboAsync(idDetalle, comentario ?? "");
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }
    private async Task ConfirmarPedido()
    {
        bool confirmacion = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas confirmar y enviar el pedido a cocina?");
        if (!confirmacion)
            return;
        if (PedidoActual.ClienteId == null)
        {
            // mostrar modal para asignar o crear cliente
            await JS.InvokeVoidAsync("mostrarModal", "#modalAsignarCliente");
        }
        foreach (var item in PedidoActual.DetallePedido)
        {
            if (item.EstadoCocinaId == (int)Enums.EstadoDetallePedidoCocina.Pendiente) // O según el nombre real en BD
            {
                await DetallePedidoServicie.ActualizarEstadoCocinaAsync(item.Id, (int)Enums.EstadoDetallePedidoCocina.EnPreparacion); // 2 = En cocina, por ejemplo
            }
        }
        await PedidoService.CambiarEstadoAsync(idPedido, Utlis.Enums.EstadoPedido.EnPreparacion);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(idPedido);
    }

}
