@page "/insumo/insumos"

@inject Services.InsumoService InsumoService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white">
                <i class="fas fa-boxes me-2"></i>Gestión de Insumos
            </h4>
            <button class="btn btn-light btn-sm" @onclick="MostrarModalNuevo">
                <i class="fas fa-plus me-1"></i>Nuevo Insumo
            </button>
        </div>

        <div class="card-body">
            @if (insumos == null)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-2">Cargando insumos...</p>
                </div>
            }
            else if (!insumos.Any())
            {
                <div class="alert alert-info text-center text-white">No hay insumos registrados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="tablaInsumos">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Unidad</th>
                                <th>Costo</th>
                                <th>Disponible</th>
                                <th>Proveedor</th>
                                <th>Últ. Ingreso</th>
                                <th>Stock Mínimo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in insumos)
                            {
                                <tr>
                                    <td>@i.Nombre</td>
                                    <td>@i.Descripcion</td>
                                    <td>@i.Abreviatura</td>
                                    <td>@i.Costo?.ToString("N2")</td>
                                    <td>@i.CantidadDisponible</td>
                                    <td>@i.ProveedorNombre</td>
                                    <td>@i.FechaUltimoIngreso?.ToShortDateString()</td>
                                    <td>@i.CantidadMinima</td>
                                    <td>@i.EstadoNombre</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Editar(i)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(i.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">@((insumoEditar.Id == 0) ? "Agregar Insumo" : "Editar Insumo")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <div class="input-group input-group-static mb-3">
                                <input class="form-control" @bind="insumoEditar.Nombre" placeholder="Nombre insumo" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Descripción</label>
                            <div class="input-group input-group-static mb-3">
                                <input class="form-control" @bind="insumoEditar.Descripcion" placeholder="Descripción"></input>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label">Unidad de Medida</label>
                            <div class="input-group input-group-static mb-3">
                                <select class="form-control" @bind="insumoEditar.UnidadMedidaId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var p in unidadMedida)
                                    {
                                        <option value="@p.Id">@p.Abreviatura</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Costo</label>
                            <div class="input-group input-group-static mb-3">
                                <input type="number" class="form-control" @bind="insumoEditar.Costo" placeholder="Costo" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cantidad Disponible</label>
                            <div class="input-group input-group-static mb-3">
                                <input type="number" class="form-control" @bind="insumoEditar.CantidadDisponible" placeholder="Disponible" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Proveedor</label>
                            <div class="input-group input-group-static mb-3">
                                <select class="form-control" @bind="insumoEditar.ProveedorId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var p in proveedores)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cantidad Mínima</label>
                            <div class="input-group input-group-static mb-3">
                                <input type="number" class="form-control" @bind="insumoEditar.CantidadMinima" placeholder="Stock mínimo" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <div class="input-group input-group-static mb-3">
                                <select class="form-control" @bind="insumoEditar.EstadoId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var estado in estados)
                                    {
                                        <option value="@estado.Id">@estado.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Guardar">💾 Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<InsumoViewModel> insumos = new();
    InsumoViewModel insumoEditar = new();
    List<ProveedorViewModel> proveedores = new();
    List<EstadoInsumoViewModel> estados = new();
    List<UnidadMedidaViewModel> unidadMedida = new();
    bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarInsumos();
        await CargarProveedores();
        await CargarEstados();
        await CargarUnidaddesMedidas();
    }

    async Task CargarInsumos()
    {
        insumos = await InsumoService.GetInsumosAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("initializeDataTable", "tablaInsumos");
    }

    async Task CargarProveedores() => proveedores = await InsumoService.GetProveedoresAsync();
    async Task CargarEstados() => estados = await InsumoService.GetEstadosAsync();
    async Task CargarUnidaddesMedidas() => unidadMedida = await InsumoService.GetUnidadesMedidaAsync();

    void MostrarModalNuevo()
    {
        insumoEditar = new InsumoViewModel();
        mostrarModal = true;
    }


    void Editar(InsumoViewModel insumo)
    {
        insumoEditar = new InsumoViewModel
            {
                Id = insumo.Id,
                Nombre = insumo.Nombre,
                Descripcion = insumo.Descripcion,
                UnidadMedidaId = insumo.UnidadMedidaId,
                Abreviatura = insumo.Abreviatura,
                Costo = insumo.Costo,
                CantidadDisponible = insumo.CantidadDisponible,
                ProveedorId = insumo.ProveedorId,
                ProveedorNombre = insumo.ProveedorNombre,
                CantidadMinima = insumo.CantidadMinima,
                EstadoId = insumo.EstadoId,
                EstadoNombre = insumo.EstadoNombre
            };
        mostrarModal = true;
    }

    void CerrarModal() => mostrarModal = false;

    async Task Guardar()
    {
        bool ok;
        if (insumoEditar.Id == 0)
        {
            ok = await InsumoService.CrearInsumoAsync(insumoEditar);
        }
        else
        {
            ok = await InsumoService.ActualizarInsumoAsync(insumoEditar);
            ok = await InsumoService.RecalcularPreciosPorInsumoAsync(insumoEditar.Id);
        }

        if (ok)
        {
            mostrarModal = false;
            await CargarInsumos();
        }
    }

    async Task Eliminar(int id)
    {
        var ok = await InsumoService.EliminarInsumoAsync(id);
        if (ok) await CargarInsumos();
    }
}
