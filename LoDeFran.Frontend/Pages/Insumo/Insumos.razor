<button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo"><i class="fas fa-plus"> </i>Nuevo Insumo</button>

@if (insumos == null)
{
    <div class="text-center">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover" id="tablaInsumos">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Unidad</th>
                <th>Costo</th>
                <th>Disponible</th>
                <th>Proveedor</th>
                <th>Últ. Ingreso</th>
                <th>Stock Mínimo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in insumos)
            {
                <tr>
                    <td>@i.Nombre</td>
                    <td>@i.Descripcion</td>
                    <td>@i.Abreviatura</td>
                    <td>@i.Costo?.ToString("N2")</td>
                    <td>@i.CantidadDisponible</td>
                    <td>@i.ProveedorNombre</td>
                    <td>@i.FechaUltimoIngreso?.ToShortDateString()</td>
                    <td>@i.CantidadMinima</td>
                    <td>@i.EstadoNombre</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Editar(i)"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(i.Id)"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((insumoEditar.Id == 0) ? "Agregar Insumo" : "Editar Insumo")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label>Nombre</label>
                        <input class="form-control" @bind="insumoEditar.Nombre" />
                    </div>
                    <div class="mb-2">
                        <label>Descripción</label>
                        <textarea class="form-control" @bind="insumoEditar.Descripcion"></textarea>
                    </div>
                    <div class="mb-2">
                        <label>Unidad de Medida</label>
                        <select class="form-control" @bind="insumoEditar.UnidadMedidaId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var p in unidadMedida)
                            {
                                <option value="@p.Id">@p.Abreviatura</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label>Costo</label>
                        <input type="number" class="form-control" @bind="insumoEditar.Costo" />
                    </div>
                    <div class="mb-2">
                        <label>Cantidad Disponible</label>
                        <input type="number" class="form-control" @bind="insumoEditar.CantidadDisponible" />
                    </div>
                    <div class="mb-2">
                        <label>Proveedor</label>
                        <select class="form-control" @bind="insumoEditar.ProveedorId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label>Cantidad Mínima</label>
                        <input type="number" class="form-control" @bind="insumoEditar.CantidadMinima" />
                    </div>
                    <div class="mb-2">
                        <label>Estado</label>
                        <select class="form-control" @bind="insumoEditar.EstadoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var estado in estados)
                            {
                                <option value="@estado.Id">@estado.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<InsumoViewModel> insumos = new();
    InsumoViewModel insumoEditar = new();
    List<ProveedorViewModel> proveedores = new();
    List<EstadoInsumoViewModel> estados = new();
    List<UnidadMedidaViewModel> unidadMedida = new();
    bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarInsumos();
        await CargarProveedores();
        await CargarEstados();
        await CargarUnidaddesMedidas();
    }

    async Task CargarInsumos()
    {
        insumos = await InsumoService.GetInsumosAsync();
        StateHasChanged(); // Fuerza renderizado
        await JS.InvokeVoidAsync("initializeDataTable", "tablaInsumos");
    }

    async Task CargarProveedores()
    {
        proveedores = await InsumoService.GetProveedoresAsync();
    }

    async Task CargarEstados()
    {
        estados = await InsumoService.GetEstadosAsync();
    }
    async Task CargarUnidaddesMedidas()
    {
        unidadMedida = await InsumoService.GetUnidadesMedidaAsync();
    }
    void MostrarModalNuevo()
    {
        insumoEditar = new();
        mostrarModal = true;
    }

    void Editar(InsumoViewModel insumo)
    {
        insumoEditar = new()
            {
                Id = insumo.Id,
                Nombre = insumo.Nombre,
                Descripcion = insumo.Descripcion,
                UnidadMedidaId = insumo.UnidadMedidaId,
                Abreviatura = insumo.Abreviatura,
                Costo = insumo.Costo,
                CantidadDisponible = insumo.CantidadDisponible,
                ProveedorId = insumo.ProveedorId,
                ProveedorNombre = insumo.ProveedorNombre,
                CantidadMinima = insumo.CantidadMinima,
                EstadoId = insumo.EstadoId,
                EstadoNombre = insumo.EstadoNombre
            };
        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    async Task Guardar()
    {
        bool ok;

        if (insumoEditar.Id == 0)
        {
            ok = await InsumoService.CrearInsumoAsync(insumoEditar);
        }
        else
        {
            ok = await InsumoService.ActualizarInsumoAsync(insumoEditar);
            ok = await InsumoService.RecalcularPreciosPorInsumoAsync(insumoEditar.Id);
        }
        if (ok)
        {
            mostrarModal = false;
            await CargarInsumos();
        }
    }

    async Task Eliminar(int id)
    {
        var ok = await InsumoService.EliminarInsumoAsync(id);
        if (ok)
        {
            await CargarInsumos();
        }
    }

}
