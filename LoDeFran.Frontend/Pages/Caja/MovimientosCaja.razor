@page "/caja/movimientos-caja/{CajaId:int}"
@inject IJSRuntime JS
@inject Services.MovimientosCajaService MovimientosCajaService
@inject Services.MetodoPagoService MetodoPagoService
@inject Services.MotivoMovimientoService MotivoMovimientoService
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <!-- Header -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-cash-register me-2"></i> Movimientos de Caja - Caja @CajaId</h4>
            <button class="btn btn-sm btn-light shadow-sm" @onclick="NuevoMovimiento">
                <i class="fas fa-plus"></i> Nuevo Movimiento
            </button>
        </div>
    </div>

    <!-- Tabla de movimientos -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            @if (Movimientos == null)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando movimientos...</p>
                </div>
            }
            else if (Movimientos.Count == 0)
            {
                <div class="alert alert-info text-center m-0">
                    <i class="fas fa-info-circle me-2"></i> No hay movimientos registrados en esta caja.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle shadow-sm" id="tablaMovimientos">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Motivo</th>
                                <th>Método Pago</th>
                                <th class="text-end">Monto</th>
                                <th>Descripción</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in Movimientos)
                            {
                                <tr>
                                    <td>@mov.FechaMovimiento.ToString("g")</td>
                                    <td>
                                        <span class="badge d-inline-flex align-items-center
                                                     @(mov.TipoMovimientoNombre == "Ingreso" ? "bg-success" : "bg-danger")">
                                            <i class="fas @(mov.TipoMovimientoNombre == "Ingreso" ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
                                            @mov.TipoMovimientoNombre
                                        </span>
                                    </td>
                                    <td>@mov.MotivoNombre</td>
                                    <td>@mov.MetodoPagoNombre</td>
                                    <td class="text-end fw-bold">$@mov.Monto</td>
                                    <td>@mov.Descripcion</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-warning me-1 shadow-sm"
                                                title="Editar"
                                                @onclick="() => EditarMovimiento(mov)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger shadow-sm"
                                                title="Eliminar"
                                                @onclick="() => EliminarMovimiento(mov.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para crear/editar movimiento -->
<div class="modal fade" id="modalMovimiento" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-3 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas @(Movimiento.Id == 0 ? "fa-plus" : "fa-edit") me-2"></i>
                    @((Movimiento.Id == 0) ? "Nuevo Movimiento" : "Editar Movimiento")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Fecha Movimiento</label>
                        <div class="input-group input-group-outline">
                            <input type="date" class="form-control" @bind="Movimiento.FechaMovimiento" />
                        </div>
                       
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Motivo Movimiento</label>
                        <select class="form-select" @bind="Movimiento.MotivoMovimientoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var motivo in Motivos)
                            {
                                <option value="@motivo.Id">@motivo.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Método de Pago</label>
                        <select class="form-select" @bind="Movimiento.MetodoPagoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var metodo in MetodosPago)
                            {
                                <option value="@metodo.Id">@metodo.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Monto</label>
                        <div class="input-group input-group-outline">
                            <input type="number" step="0.01" class="form-control" placeholder="Ej: 1500.50" @bind="Movimiento.Monto" />
                        </div>
                    </div>                    
                </div>
                   
                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <div class="input-group input-group-outline">
                        <textarea class="form-control" rows="3" placeholder="Detalle del movimiento..." @bind="Movimiento.Descripcion"></textarea>
                    </div>
                </div>
                
                <hr />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button class="btn btn-success" @onclick="GuardarMovimiento">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter] public int CajaId { get; set; }

    private List<MovimientoCajaViewModel>? Movimientos;
    private MovimientoCajaViewModel Movimiento = new() { CajaId = 0, FechaMovimiento = DateTime.Today };
    private List<MetodoPagoViewModel> MetodosPago = new();
    private List<MotivoMovimientoViewModel> Motivos = new();


    private IEnumerable<string> TiposMovimientoUnicos =>
        Motivos.Select(m => m.TipoMovimientoNombre).Distinct();

    protected override async Task OnInitializedAsync()
    {
        MetodosPago = await MetodoPagoService.GetAllAsync();
        Motivos = await MotivoMovimientoService.GetAllAsync();
        await CargarMovimientos();
    }

    private async Task CargarMovimientos()
    {
        Movimientos = await MovimientosCajaService.GetPorCajaAsync(CajaId);
        await JS.InvokeVoidAsync("initializeDataTable", "tablaMovimientos");
    }

    private void NuevoMovimiento()
    {
        Movimiento = new MovimientoCajaViewModel
            {
                CajaId = CajaId,
                FechaMovimiento = DateTime.Now
            };
        JS.InvokeVoidAsync("mostrarModal", "#modalMovimiento");
    }

    private void EditarMovimiento(MovimientoCajaViewModel mov)
    {
        Movimiento = new MovimientoCajaViewModel
            {
                Id = mov.Id,
                CajaId = mov.CajaId,
                FechaMovimiento = mov.FechaMovimiento,
                MotivoMovimientoId = mov.MotivoMovimientoId,
                MetodoPagoId = mov.MetodoPagoId,
                Monto = mov.Monto,
                Descripcion = mov.Descripcion
            };
        JS.InvokeVoidAsync("mostrarModal", "#modalMovimiento");
    }

    private async Task GuardarMovimiento()
    {
        // 👇 Serializa el objeto Movimiento a JSON
        var movimientoJson = System.Text.Json.JsonSerializer.Serialize(Movimiento);

        // 👇 Mostralo en la consola del navegador
        await JS.InvokeVoidAsync("console.log", movimientoJson);

        // Luego guardás normalmente
        if (Movimiento.Id == 0)
            await MovimientosCajaService.CrearAsync(Movimiento);
        else
            await MovimientosCajaService.ActualizarAsync(Movimiento.Id, Movimiento);

        await CargarMovimientos();
        await JS.InvokeVoidAsync("cerrarModal", "#modalMovimiento");
    }


    private async Task EliminarMovimiento(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "¿Confirma eliminar el movimiento?"))
        {
            await MovimientosCajaService.EliminarAsync(id);
            await CargarMovimientos();
        }
    }
}
