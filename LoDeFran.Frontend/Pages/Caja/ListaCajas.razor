@page "/caja/listado"
@inject Services.CajaService CajaService
@inject NavigationManager Nav
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <!-- Header -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-boxes me-2"></i> Listado de Cajas</h4>
        </div>
    </div>

    <!-- Tabla de cajas -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            @if (Cajas == null)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando cajas...</p>
                </div>
            }
            else if (Cajas.Count == 0)
            {
                <div class="alert alert-info text-center m-0">
                    <i class="fas fa-info-circle me-2"></i> No hay cajas registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle shadow-sm">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Usuario</th>
                                <th>Fecha Apertura</th>
                                <th>Fecha Cierre</th>
                                <th>Estado</th>
                                <th>Monto Inicial</th>
                                <th>Monto Final</th>
                                <th>Diferencia</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var caja in Cajas)
                            {
                                <tr>
                                    <td>@caja.NombreUsuario</td>
                                    <td>@caja.FechaApertura.ToString("g")</td>
                                    <td>@(caja.FechaCierre?.ToString("g") ?? "-")</td>
                                    <td>
                                        <span class="badge @(caja.Estado == "Abierta" ? "bg-success" : "bg-secondary") px-3 py-2">
                                            <i class="fas @(caja.Estado == "Abierta" ? "fa-unlock" : "fa-lock") me-1"></i>
                                            @caja.Estado
                                        </span>
                                    </td>
                                    <td class="fw-bold text-end">$@caja.MontoInicial</td>
                                    <td class="text-end">@(caja.MontoFinal.HasValue ? $"${caja.MontoFinal}" : "-")</td>
                                    <td class="text-end">@(caja.Diferencia.HasValue ? $"${caja.Diferencia}" : "-")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary shadow-sm"
                                                title="Ver movimientos"
                                                @onclick="@(() => VerMovimientos(caja.Id))">
                                            <i class="fas fa-list me-1"></i> Ver
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<CajaViewModel>? Cajas;

    protected override async Task OnInitializedAsync()
    {
        Cajas = await CajaService.ObtenerHistorialCajasAsync();
    }

    private void VerMovimientos(int cajaId)
    {
        Nav.NavigateTo($"/caja/movimientos-caja/{cajaId}");
    }
}
