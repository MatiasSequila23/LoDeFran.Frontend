@page "/caja/movimientos"
@inject Services.CajaService CajaService
@inject Services.MetodoPagoService MetodoPagoService
@inject Services.MovimientosCajaService MovimientosCajaService
@inject Services.MotivoMovimientoService MotivoMovimientoService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <!-- Header -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-cash-register me-2"></i> Movimientos de Caja</h4>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body">
            <h6 class="text-muted mb-3"><i class="fas fa-filter me-2"></i>Filtros</h6>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Caja</label>
                    <div class="input-group input-group-outline">
                        <select class="form-control" @bind="FiltroCajaId">
                            <option value="">-- Todas --</option>
                            @foreach (var caja in Cajas)
                            {
                                <option value="@caja.Id">@($"{caja.NombreUsuario} - {caja.FechaApertura:g}")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Método de Pago</label>
                    <div class="input-group input-group-outline">
                        <select class="form-control" @bind="FiltroMetodoPagoId">
                            <option value="">-- Todos --</option>
                            @foreach (var metodo in MetodosPago)
                            {
                                <option value="@metodo.Id">@metodo.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Motivo</label>
                    <div class="input-group input-group-outline">
                        <select class="form-control" @bind="FiltroMotivoId">
                            <option value="">-- Todos --</option>
                            @foreach (var motivo in Motivos)
                            {
                                <option value="@motivo.Id">@motivo.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Desde</label>
                    <div class="input-group input-group-outline">
                        <input type="date" class="form-control" @bind="FiltroDesde" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Hasta</label>
                    <div class="input-group input-group-outline">
                        <input type="date" class="form-control" @bind="FiltroHasta" />
                    </div>
                </div>
            </div>

            <button class="btn btn-primary shadow-sm" @onclick="FiltrarMovimientos">
                <i class="fas fa-search me-2"></i> Filtrar
            </button>
        </div>
    </div>

    <!-- Resultados -->
    @if (FiltrosAplicados)
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body">
                @if (Movimientosc == null)
                {
                    <div class="text-center my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-2">Cargando movimientos...</p>
                    </div>
                }
                else if (!Movimientosc.Any())
                {
                    <div class="alert alert-info text-center m-0">
                        <i class="fas fa-info-circle me-2"></i> No se encontraron movimientos con los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-bordered align-middle shadow-sm" id="tablaMovimientos">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Caja</th>
                                    <th>Tipo</th>
                                    <th>Motivo</th>
                                    <th>Método Pago</th>
                                    <th class="text-end">Monto</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in Movimientosc)
                                {
                                    <tr>
                                        <td>@mov.FechaMovimiento.ToString("dd/MM/yyyy")</td>
                                        <td>@mov.CajaId</td>
                                        <td>
                                            <span class="badge @(mov.TipoMovimientoNombre == "Ingreso" ? "bg-success" : "bg-danger") px-3 py-2">
                                                @mov.TipoMovimientoNombre
                                            </span>
                                        </td>
                                        <td>@mov.MotivoNombre</td>
                                        <td>@mov.MetodoPagoNombre</td>
                                        <td class="text-end fw-bold">$@mov.Monto</td>
                                        <td>@mov.Descripcion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<MovimientoCajaViewModel>? Movimientosc;
    private List<CajaViewModel> Cajas = new();
    private List<MetodoPagoViewModel> MetodosPago = new();
    private List<MotivoMovimientoViewModel> Motivos = new();

    private int? FiltroMotivoId;
    private int? FiltroCajaId;
    private int? FiltroMetodoPagoId;
    private DateTime? FiltroDesde;
    private DateTime? FiltroHasta;

    private bool FiltrosAplicados = false;

    protected override async Task OnInitializedAsync()
    {
        Cajas = await CajaService.ObtenerHistorialCajasAsync();
        MetodosPago = await MetodoPagoService.GetAllAsync();
        Motivos = await MotivoMovimientoService.GetAllAsync();
    }

    private async Task FiltrarMovimientos()
    {
        FiltrosAplicados = true;
        Movimientosc = null; // para mostrar el spinner
        StateHasChanged();

        Movimientosc = await MovimientosCajaService.GetFiltradosAsync(
            FiltroCajaId, FiltroMetodoPagoId, FiltroMotivoId, FiltroDesde, FiltroHasta
        );

        if (Movimientosc.Any())
        {
            await JS.InvokeVoidAsync("initDataTableConBotones", "tablaMovimientos");
        }
    }
}
