    Pedidos a Cobrar
</h3>

@if (Pedidos == null)
{
    <p>Cargando pedidos...</p>
}
else if (!Pedidos.Any())
{
    <div class="alert alert-info">No hay pedidos pendientes de cobro.</div>
}
else
{
    <table class="table table-bordered table-hover mt-3" id="tablaCaja" @key="claveTabla">
        <thead>
            <tr>
                <th>Mesa</th>
                <th>Fecha</th>
                <th>Total sin descuento</th>
                <th>Total con descuento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Pedidos)
            {
                <tr>
                    <td>@pedido.Mesa?.Numero</td>
                    <td>@pedido.FechaPedido?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        $@pedido.TotalSinDescuento?.ToString("C", new CultureInfo("es-AR"))
                    </td>
                    <td>
                        $@pedido.Total?.ToString("C", new CultureInfo("es-AR"))
                    </td>

                    <td>
                        <button class="btn btn-success btn-sm me-1" @onclick="() => AbrirModalCobro(pedido)">Cobrar</button>
                        <button class="btn btn-primary btn-sm me-1" @onclick="() => Imprimir(pedido)">Imprimir</button>
                        <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalPromocion(pedido)">Promo</button>
                        @if (pedido.PromocionId != null)
                        {

                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

@if (PedidoSeleccionado != null)
{
    <div class="modal fade show d-block" style="z-index:1050; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cobrar - Mesa @PedidoSeleccionado.Mesa?.Numero</h5>
                    <button class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Total:</strong> $@TotalPedido.ToString("0.00")</p>

                    <div class="mb-3">
                        <p><strong>Caja:</strong> @($"{CajaActual?.NombreUsuario} - {CajaActual?.FechaApertura:g}")</p>
                    </div>
                    <div class="mb-3">
                        <label>Método de pago</label>
                        <select class="form-control" @bind="MetodoPagoSeleccionado">
                            @foreach (var metodo in MetodosPago)
                            {
                                <option value="@metodo.Id">@metodo.Nombre</option>
                            }
                        </select>
                    </div>

                    @if (MetodoPagoSeleccionado == 1)
                    {
                        <div class="mb-3">
                            <label>Monto recibido</label>
                            <input class="form-control" type="number" @bind="MontoRecibido" />
                            @if (MontoRecibido > 0)
                            {
                                <p class="mt-2 text-success"><strong>Vuelto:</strong> $@(MontoRecibido - TotalPedido):0.00</p>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-success" @onclick="ConfirmarCobro">Confirmar Cobro</button>
                </div>
            </div>
        </div>
    </div>
}

@if (MostrarModalPromocion && PedidoSeleccionadoParaPromocion != null)
{
    <div class="modal fade show d-block" style="z-index:1051; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Promociones para Mesa @PedidoSeleccionadoParaPromocion.Mesa?.Numero</h5>
                    <button class="btn-close" @onclick="CerrarModalPromocion"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <button class="btn btn-danger  w-100 mb-2"
                                @onclick="() => SeleccionarPromocion(new PromocionViewModel { Id = 9999 })">
                            ❌ Sin promoción
                        </button>

                    </div>

                    @if (PromocionesDisponibles?.Any() == true)
                    {
                        @foreach (var promo in PromocionesDisponibles)
                        {
                            bool esSeleccionada = PedidoSeleccionadoParaPromocion?.PromocionId == promo.Id;

                            <button class="btn @(esSeleccionada ? "btn-primary" : "btn-outline-primary") w-100 mb-2"
                                    @onclick="() => SeleccionarPromocion(promo)">
                                @(esSeleccionada ? "✅ " : "")
                                @promo.Nombre (@(promo.TipoDescuentoId == 1 ? $"{promo.ValorDescuento}%" : $"${promo.ValorDescuento}"))
                            </button>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">No hay promociones disponibles.</div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalPromocion">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private CajaViewModel? CajaActual;
    private List<PedidoViewModel>? Pedidos;
    private PedidoViewModel? PedidoSeleccionado;
    private PedidoViewModel? PedidoSeleccionadoParaPromocion;

    private List<MetodoPagoViewModel> MetodosPago = new();
    private MovimientoCajaViewModel? nuevoMovimiento;
    Guid claveTabla = Guid.NewGuid();
    private bool MostrarModalPromocion = false;
    private List<PromocionViewModel>? PromocionesDisponibles;
    private List<PromocionViewModel>? PromocionSeleccionada;

    private int MetodoPagoSeleccionado = 1;
    private decimal MontoRecibido = 0;
    private decimal TotalPedido => PedidoSeleccionado?.DetallePedido.Sum(d => d.Cantidad * d.PrecioUnitario) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("destroyDataTable", "tablaPedidos");
        MetodosPago = await MetodoPagoService.GetAllAsync();
        var usuarioId = 1; // simulado o usar await Auth.GetUsuarioIdAsync()
        CajaActual = await CajaService.ObtenerCajaAbiertaPorUsuarioAsync(usuarioId);
        await CargarPedidos();
    }

    private async Task CargarPedidos()
    {

        Pedidos?.Clear();
        Pedidos = await ServicioDeMesaService.GetPedidosPorEstadoAsync((int)Enums.EstadoPedido.A_Cobrar);

        claveTabla = Guid.NewGuid(); // 🔁 Forzamos recreación del DOM


        await InvokeAsync(StateHasChanged);


        //await JS.InvokeVoidAsync("initializeDataTable", "tablaCaja");
    }



    private void AbrirModalCobro(PedidoViewModel pedido)
    {
        PedidoSeleccionado = pedido;
        MetodoPagoSeleccionado = 1;
        MontoRecibido = 0;
    }

    private void CerrarModal()
    {
        PedidoSeleccionado = null;
        MontoRecibido = 0;
    }

    private async Task ConfirmarCobro()
    {
        if (PedidoSeleccionado == null)
            return;

        // Opcional: podrías guardar método de pago y monto recibido en otra tabla (Pagos)
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(PedidoSeleccionado.Id, Enums.EstadoPedido.Cobrado);
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(PedidoSeleccionado.Id, Enums.EstadoPedido.Cerrado);
        await ServicioDeMesaService.CambiarEstadoMesaAsync(PedidoSeleccionado.MesaId, Enums.EstadoMesa.Disponible);

        crearMovimiento();
        await MovimientosCajaService.CrearAsync(nuevoMovimiento);


        var FacturaDto = new FacturaDto()
            {
                PedidoId = PedidoSeleccionado.Id,
                Total = Convert.ToDecimal(PedidoSeleccionado.TotalSinDescuento),
                ClienteId = PedidoSeleccionado.ClienteId,
                MetodoPagoId = MetodoPagoSeleccionado,
                UsuarioId = CajaActual.UsuarioId,
                DescuentoAplicado = PedidoSeleccionado.MontoDescuento,
                Observaciones = "Factura",
                TipoFactura = "C",
                CuitCliente = "",
                CajaId = CajaActual.Id
            };

        await FacturaService.CreateAsync(FacturaDto);

        await CargarPedidos();
        CerrarModal();
    }
    private string GenerarLineaVuelto(string total)
    {
        if (MetodoPagoSeleccionado != 1) return "";

        decimal totalDecimal = 0;
        decimal.TryParse(total, out totalDecimal);
        var vuelto = MontoRecibido - totalDecimal;

        return $"<p><strong>Recibido:</strong> ${MontoRecibido:0.00}</p><p><strong>Vuelto:</strong> ${vuelto:0.00}</p>";
    }
    private void Imprimir(PedidoViewModel pedido)
    {
        var total = pedido.DetallePedido.Sum(d => d.Cantidad * d.PrecioUnitario).ToString("0.00");
        var detalle = string.Join("<br>", pedido.DetallePedido.Select(d => $"- {d.Producto?.Nombre} x{d.Cantidad} = ${d.Cantidad * d.PrecioUnitario:0.00}"));
        var html = $@"  <html>
            <head>
                <title>Ticket Mesa {pedido.Mesa?.Numero}</title>
                <style>
                    body {{ font-family: Arial; padding: 20px; }}
                    h2 {{ margin-bottom: 10px; }}
                </style>
            </head>
            <body>
                <h2>Ticket - Mesa {pedido.Mesa?.Numero}</h2>
                <p><strong>Fecha:</strong> {pedido.FechaPedido?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")}</p> <p>{detalle}</p><hr><p><strong>Total: ${total}</strong></p>{GenerarLineaVuelto(total)}<script>window.print();</script>   </body>  </html> ";

        JS.InvokeVoidAsync("openTicketWindow", html);
    }
    private void crearMovimiento()
    {
        nuevoMovimiento = new MovimientoCajaViewModel
            {
                CajaId = CajaActual.Id,
                FechaMovimiento = DateTime.Now,
                MotivoMovimientoId = 1,
                MetodoPagoId = MetodoPagoSeleccionado,
                Monto = TotalPedido,
                Descripcion = "pedidos" // cambiar cuando separe si es delivery etc...
            };
    }
    private async Task AbrirModalPromocion(PedidoViewModel pedido)
    {
        PedidoSeleccionadoParaPromocion = pedido;

        // Traé las promociones disponibles para ese pedido desde tu API
        PromocionesDisponibles = await PromocionService.ObtenerPromocionesParaPedidoAsync(pedido.Id);

        MostrarModalPromocion = true;
    }

    private void CerrarModalPromocion()
    {
        MostrarModalPromocion = false;
        PedidoSeleccionadoParaPromocion = null;
        PromocionesDisponibles = null;
    }

    private async Task SeleccionarPromocion(PromocionViewModel? promo)
    {
        if (PedidoSeleccionadoParaPromocion == null)
            return;

        await PromocionService.AsignarPromocionAlPedidoAsync(PedidoSeleccionadoParaPromocion.Id, promo.Id);
        // Refrescar los pedidos para recalcular el total y cerrar modal
        await CargarPedidos();
        MostrarModalPromocion = false;
    }
    [Inject] private IJSRuntime JS { get; set; } = default!;
}
