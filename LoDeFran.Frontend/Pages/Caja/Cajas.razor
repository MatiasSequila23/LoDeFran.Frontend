@page "/caja/cajas"
@inject Services.CajaService CajaService
@inject IJSRuntime JS
@inject NavigationManager Nav
@using LoDeFran.Frontend.Models

<h3 class=" text-center">
    Gestión de Caja
</h3>

@if (isLoading)
{
    <div class="text-center mt-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (CajaActual == null)
{
    <div class="card mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h5 class="card-title">Abrir Caja</h5>
            <label class="form-label">Monto Inicial:</label>
            <input type="number" @bind="MontoInicial" class="form-control mb-3" />
            <button class="btn btn-success w-100" @onclick="AbrirCaja" disabled="@isLoading">
                <i class="fas fa-cash-register"></i> Abrir Caja
            </button>
        </div>
    </div>
}
else if (CajaActual.Estado == "abierta")
{
    <div class="row g-3">
        <!-- Card: Caja Abierta -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    Caja Abierta
                </div>
                <div class="card-body">
                    <p><strong>Usuario:</strong> @CajaActual.NombreUsuario</p>
                    <p><strong>Fecha Apertura:</strong> @CajaActual.FechaApertura.ToString("g")</p>
                    <p><strong>Monto Inicial:</strong> $@CajaActual.MontoInicial</p>
                </div>
            </div>
        </div>

        <!-- Card: Resumen de Caja -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    Resumen de Caja (Efectivo)
                </div>
                <div class="card-body">
                    <p>Ingresos: <strong class="text-success">$@EfectivoIngresos</strong></p>
                    <p>Egresos: <strong class="text-danger">$@EfectivoEgresos</strong></p>
                    <p>Total teórico: <strong>$@TotalEnCaja</strong></p>
                </div>
            </div>
        </div>

        <!-- Card: Conteo Final -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    Conteo Final
                </div>
                <div class="card-body">
                    <label class="form-label">Monto contado:</label>
                    <input type="number" class="form-control mb-2" @bind="MontoFinalIngresado" />
                    <p class="@DiferenciaCss"><strong>Diferencia:</strong> $@DiferenciaStr</p>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="col-12">
            <div class="row mt-3 g-2 justify-content-center">
                <div class="col-12 col-md-auto">
                    <button class="btn btn-danger w-100" @onclick="CerrarCaja" disabled="@isLoading">
                        <i class="fas fa-lock"></i> Cerrar Caja
                    </button>
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-outline-primary border-primary w-100" @onclick="IrAMovimientosCaja" disabled="@isLoading">
                        Movimientos de esta Caja
                    </button>
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-link w-100" @onclick="IrAlistadoCajas" disabled="@isLoading">
                        Historial de Cajas
                    </button>
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-outline-dark border-dark  w-100" @onclick="IrAlistadoMovi" disabled="@isLoading">
                        Todos los Movimientos
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center">No hay caja abierta.</div>
}


@code {
    private CajaViewModel? CajaActual;
    private decimal MontoInicial;
    private decimal MontoFinalIngresado;
    private decimal EfectivoIngresos;
    private decimal EfectivoEgresos;
    private decimal TotalEnCaja;
    private bool isLoading = false;

    private string DiferenciaCss => Diferencia == 0 ? "text-success" : "text-danger";
    private decimal Diferencia => MontoFinalIngresado - TotalEnCaja;
    private string DiferenciaStr => Diferencia.ToString("N2");

    protected override async Task OnInitializedAsync()
    {
        await RunWithLoading(async () =>
        {
            var usuarioId = 1; // simulado
            CajaActual = await CajaService.ObtenerCajaAbiertaPorUsuarioAsync(usuarioId);

            var movimientoJson = System.Text.Json.JsonSerializer.Serialize(CajaActual);
            await JS.InvokeVoidAsync("console.log", movimientoJson);

            if (CajaActual != null)
            {
                EfectivoIngresos = CajaActual.Movimientos
                    .Where(m => m.TipoMovimientoNombre?.ToLower() == "ingreso" && m.MetodoPagoId == 1)
                    .Sum(m => m.Monto);

                EfectivoEgresos = CajaActual.Movimientos
                    .Where(m => m.TipoMovimientoNombre?.ToLower() == "egreso" && m.MetodoPagoId == 1)
                    .Sum(m => m.Monto);

                TotalEnCaja = CajaActual.MontoInicial + EfectivoIngresos - EfectivoEgresos;
            }
        });
    }

    private Task AbrirCaja() => RunWithLoading(async () =>
    {
        var usuarioId = 1;
        await CajaService.AbrirCajaAsync(new CajaViewModel
            {
                UsuarioId = usuarioId,
                MontoInicial = MontoInicial
            });

        CajaActual = await CajaService.ObtenerCajaAbiertaPorUsuarioAsync(usuarioId);
    });

    private Task CerrarCaja() => RunWithLoading(async () =>
    {
        if (CajaActual != null)
        {
            await CajaService.CerrarCajaAsync(CajaActual.Id, MontoFinalIngresado);
            CajaActual = null;
        }
    });

    private void IrAMovimientosCaja()
    {
        if (CajaActual != null)
        {
            Nav.NavigateTo($"/caja/movimientos-caja/{CajaActual.Id}");
        }
    }
    private void IrAlistadoCajas() => Nav.NavigateTo($"/caja/listado");
    private void IrAlistadoMovi() => Nav.NavigateTo($"/caja/movimientos");

    private async Task RunWithLoading(Func<Task> action)
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            await action();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
