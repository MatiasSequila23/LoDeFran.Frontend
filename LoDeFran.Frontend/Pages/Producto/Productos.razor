@page "/producto/productos"

@inject Services.ProductoService ProductoService
@inject Services.SubcategoriaProductoService SubcategoriaProductoService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">

    <!-- Header -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-box me-2"></i> Gestión de Productos</h4>
            <button class="btn btn-sm btn-primary" @onclick="MostrarModalNuevo" data-bs-toggle="modal" data-bs-target="#exampleModal">
                <i class="fas fa-plus"></i> Nuevo Producto
            </button>
        </div>
    </div>
    <!-- Card Productos -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            @if (productos == null)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="tablaProductos" class="table table-striped table-hover" @key="claveTabla">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Categoría</th>
                                <th>Subcategoría</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in productos)
                            {
                                <tr>
                                    <td>@producto.Nombre</td>
                                    <td>@producto.Descripcion</td>
                                    <td>$@producto.Precio.ToString("N2")</td>
                                    <td>@producto.Stock</td>
                                    <td>@(producto.CategoriaProductoNombre ?? "Sin categoría")</td>
                                    <td>@(producto.SubcategoriaProductoNombre ?? "Sin subcategoría")</td>
                                    <td>@(producto.EstadoNombre ?? "Sin estado")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-2" title="Editar"
                                                @onclick="() => EditarProducto(producto)" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger me-2" title="Eliminar"
                                                @onclick="() => EliminarProducto(producto.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                        @if (producto.TieneInsumos)
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Insumos"
                                                    @onclick="() => GestionarInsumos(producto)">
                                                <i class="fas fa-boxes"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Insumos -->
@if (mostrarModalInsumos)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Insumos de @productoSeleccionado?.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalInsumos"></button>
                </div>
                <div class="modal-body">
                    <h6>Insumos asignados:</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Cantidad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (productoSeleccionado?.InsumosProducto != null && productoSeleccionado.InsumosProducto.Any())
                            {
                                @foreach (var insumo in productoSeleccionado.InsumosProducto)
                                {
                                    <tr>
                                        <td>@insumo.NombreInsumo</td>
                                        <td>@insumo.Cantidad</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarInsumo(insumo)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarInsumo(insumo)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3">Sin insumos asignados</td></tr>
                            }
                        </tbody>
                    </table>

                    <h6 class="mt-3">Agregar nuevo insumo</h6>
                    <div class="row">
                        <div class="col-8">
                            <select class="form-control" @bind="nuevoInsumo.InsumoId">
                                <option value="">-- Seleccionar Insumo --</option>
                                @foreach (var insumo in insumosDisponibles)
                                {
                                    <option value="@insumo.Id">@insumo.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <input type="number" class="form-control" placeholder="Cantidad" @bind="nuevoInsumo.Cantidad" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalInsumos">Cerrar</button>
                    <button class="btn btn-success" @onclick="AgregarInsumo">Agregar Insumo</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Producto -->
@if (mostrarModal)
{
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((productoEditar.Id == 0) ? "Agregar Producto" : "Editar Producto")</h5>
                    <button type="button" class="btn-close text-dark" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- FORM PRODUCTO -->
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-static mb-3">
                                <label>Nombre:</label>
                                <input type="text" class="form-control" @bind="productoEditar.Nombre" placeholder="Nombre del producto">
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Descripción:</label>
                            <div class="input-group input-group-static mb-3">
                                <input class="form-control" @bind="productoEditar.Descripcion" placeholder="Descripción del producto">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <label>Precio:</label>
                            <div class="input-group input-group-static mb-3">
                                <input type="number" class="form-control" @bind="productoEditar.Precio" placeholder="Precio">
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Stock:</label>
                            <div class="input-group input-group-static mb-3">
                                <input type="number" class="form-control" @bind="productoEditar.Stock" placeholder="Stock">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-static mb-3">
                                <label>Categoría:</label>
                                <select class="form-control" @bind="CategoriaSeleccionada" @bind:event="onchange">
                                    <option selected value="">-- Seleccionar --</option>
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.Id">@cat.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-static mb-3">
                                <label>Subcategoría:</label>
                                <select class="form-control" @bind="productoEditar.SubcategoriaProductoId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var sub in subCategoriasFiltradas)
                                    {
                                        <option value="@sub.Id">@sub.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-static mb-3">
                                <label>Estado:</label>
                                <select class="form-control" @bind="productoEditar.EstadoId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var estado in estados)
                                    {
                                        <option value="@estado.Id">@estado.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" role="switch" id="tieneInsumosSwitch"
                                       @bind="productoEditar.TieneInsumos" />
                                <label class="form-check-label" for="tieneInsumosSwitch">¿Tiene insumos?</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn bg-gradient-secondary" @onclick="CerrarModal" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarProducto" data-bs-dismiss="modal">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<ProductoViewModel> productos = new();
    ProductoViewModel productoEditar = new();
    List<CategoriaProductoViewModel> categorias = new();
    List<SubcategoriaProductoViewModel> subCategorias = new();
    List<EstadoProductoViewModel> estados = new();

    bool mostrarModal = false;
    bool mostrarModalInsumos = false;

    ProductoViewModel productoSeleccionado;
    List<InsumoViewModel> insumosDisponibles = new();
    InsumoProductoViewModel nuevoInsumo = new();

    List<SubcategoriaProductoViewModel> subCategoriasFiltradas = new();

    bool isLoading = false;
    bool productosCargados = false;
    Guid claveTabla = Guid.NewGuid();

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
        await CargarEstados();
        await CargarSubCategorias();
        await CargarProductos();
    }

    async Task CargarProductos()
    {
        try
        {
            isLoading = true;
            productosCargados = false;
            await JS.InvokeVoidAsync("destroyDataTable", "tablaProductos");

            productos = await ProductoService.GetProductosAsync();

            productosCargados = true;
            claveTabla = Guid.NewGuid(); // 🔁 fuerza recreación de tabla

            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos");
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task CargarCategorias()
    {
        categorias = await ProductoService.GetCategoriasProductosAsync();
    }

    async Task CargarSubCategorias()
    {
        subCategorias = await SubcategoriaProductoService.GetSubCategoriasProductosAsync();
    }

    async Task CargarEstados()
    {
        estados = await ProductoService.GetEstadosProductosAsync();
    }

    void MostrarModalNuevo()
    {
        productoEditar = new ProductoViewModel(); // nuevo
        mostrarModal = true;
    }

    void EditarProducto(ProductoViewModel p)
    {
        productoEditar = new ProductoViewModel
            {
                Id = p.Id,
                Nombre = p.Nombre,
                Descripcion = p.Descripcion,
                Precio = p.Precio,
                Stock = p.Stock,
                CategoriaProductoId = p.CategoriaProductoId,
                SubcategoriaProductoId = p.SubcategoriaProductoId,
                EstadoId = p.EstadoId,
                TieneInsumos = p.TieneInsumos
            };

        subCategoriasFiltradas = subCategorias
            .Where(s => s.CategoriaId == productoEditar.CategoriaProductoId)
            .ToList();

        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    async Task GuardarProducto()
    {
        bool ok;

        if (productoEditar.Id == 0)
        {
            productoEditar.FechaCreacion = DateTime.Now;
            productoEditar.EstadoId = 1;
            ok = await ProductoService.CrearProductoAsync(productoEditar);
        }
        else
        {
            ok = await ProductoService.ActualizarProductoAsync(productoEditar);
        }

        if (ok)
        {
            mostrarModal = false;
            await CargarProductos();
        }
    }

    async Task EliminarProducto(int id)
    {
        bool ok = await ProductoService.EliminarProductoAsync(id);
        if (ok)
        {
            await CargarProductos();
        }
    }

    ElementReference tablaProductosRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && productos.Any())
        {
            await InicializarDataTable();
        }
    }

    async Task InicializarDataTable()
    {
        await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos");
    }

    async Task GestionarInsumos(ProductoViewModel producto)
    {
        productoSeleccionado = producto;

        insumosDisponibles = await ProductoService.GetInsumosAsync();
        productoSeleccionado.InsumosProducto = await ProductoService.GetInsumosAsignadosAsync(producto.Id);

        nuevoInsumo = new InsumoProductoViewModel();
        mostrarModalInsumos = true;
    }

    void CerrarModalInsumos()
    {
        mostrarModalInsumos = false;
        productoSeleccionado = null;
        nuevoInsumo = new InsumoProductoViewModel();
    }

    async Task AgregarInsumo()
    {
        if (nuevoInsumo.InsumoId > 0 && nuevoInsumo.Cantidad > 0)
        {
            var insumo = insumosDisponibles.FirstOrDefault(i => i.Id == nuevoInsumo.InsumoId);
            if (insumo != null)
            {
                productoSeleccionado.InsumosProducto ??= new List<InsumoProductoViewModel>();
                var insumoExistente = productoSeleccionado.InsumosProducto
                    .FirstOrDefault(i => i.InsumoId == nuevoInsumo.InsumoId);

                if (insumoExistente != null)
                {
                    insumoExistente.Cantidad = nuevoInsumo.Cantidad;
                    await ProductoService.ActualizarInsumoProductoAsync(productoSeleccionado.Id, nuevoInsumo.InsumoId, nuevoInsumo);
                }
                else
                {
                    productoSeleccionado.InsumosProducto.Add(new InsumoProductoViewModel
                        {
                            InsumoId = nuevoInsumo.InsumoId,
                            NombreInsumo = insumo.Nombre,
                            Cantidad = nuevoInsumo.Cantidad
                        });

                    await ProductoService.AsociarInsumoAProducto(productoSeleccionado.Id, nuevoInsumo);
                }

                productoSeleccionado = await ProductoService.RecalcularPrecioProductoAsync(productoSeleccionado.Id);
                await CargarProductos();
            }

            nuevoInsumo = new InsumoProductoViewModel();
            CerrarModalInsumos();
        }
    }

    void EditarInsumo(InsumoProductoViewModel insumo)
    {
        nuevoInsumo = new InsumoProductoViewModel
            {
                ProductoId = insumo.ProductoId,
                InsumoId = insumo.InsumoId,
                Cantidad = insumo.Cantidad
            };
    }

    async Task EliminarInsumo(InsumoProductoViewModel insumo)
    {
        var exito = await ProductoService.EliminarInsumoProductoAsync(productoSeleccionado.Id, insumo.InsumoId);

        if (exito)
        {
            productoSeleccionado.InsumosProducto = await ProductoService.GetInsumosAsignadosAsync(productoSeleccionado.Id);
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("No se pudo eliminar el insumo.");
        }
    }

    async Task CategoriaCambiada(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int categoriaId))
        {
            subCategoriasFiltradas = subCategorias
                .Where(s => s.CategoriaId == categoriaId)
                .ToList();

            if (!subCategoriasFiltradas.Any(s => s.Id == productoEditar.SubcategoriaProductoId))
            {
                productoEditar.SubcategoriaProductoId = 0;
            }
        }
        else
        {
            subCategoriasFiltradas.Clear();
            productoEditar.SubcategoriaProductoId = 0;
        }
    }

    int? CategoriaSeleccionada
    {
        get => productoEditar.CategoriaProductoId ?? 0;
        set
        {
            productoEditar.CategoriaProductoId = value;
            if (value.HasValue)
            {
                subCategoriasFiltradas = subCategorias
                    .Where(s => s.CategoriaId == value.Value)
                    .ToList();

                if (!subCategoriasFiltradas.Any(s => s.Id == productoEditar.SubcategoriaProductoId))
                {
                    productoEditar.SubcategoriaProductoId = 0;
                }
            }
            else
            {
                subCategoriasFiltradas.Clear();
                productoEditar.SubcategoriaProductoId = 0;
            }
        }
    }
}