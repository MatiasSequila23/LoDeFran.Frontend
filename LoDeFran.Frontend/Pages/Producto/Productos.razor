@page "/producto/productos"

@inject Services.ProductoService ProductoService
@* @inject Services.CategoriaProductoService CategoriaProductoService  *@
@inject IJSRuntime JS

@using LoDeFran.Frontend.Models

<h3 class="mt-4 mb-4">Gestión de Productos</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo"><i class="fas fa-plus"></i> Nuevo Producto</button>

@if (productos == null)
{
    <div class="text-center">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover" id="tablaProductos">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in productos)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Descripcion</td>
                    <td>$@producto.Precio.ToString("N2")</td>
                    <td>@producto.Stock</td>
                    <td>@(producto.CategoriaProductoNombre ?? "Sin categoría")</td>
                    <td>@(producto.EstadoNombre ?? "Sin estado")</td>

                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" title="Editar" @onclick="() => EditarProducto(producto)">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => EliminarProducto(producto.Id)">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        @if (producto.TieneInsumos)
                        {
                            <button class="btn btn-sm btn-outline-success me-2" style="margin-left: 10px;" title="Insumos" @onclick="() => GestionarInsumos(producto)">
                                <i class="fas fa-boxes"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (mostrarModalInsumos)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Insumos de @productoSeleccionado?.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalInsumos"></button>
                </div>
                <div class="modal-body">
                    <h6>Insumos asignados:</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Cantidad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (productoSeleccionado?.InsumosProducto != null && productoSeleccionado.InsumosProducto.Any())
                            {
                                @foreach (var insumo in productoSeleccionado.InsumosProducto)
                                {
                                    <tr>
                                        <td>@insumo.NombreInsumo</td>
                                        <td>@insumo.Cantidad</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarInsumo(insumo)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarInsumo(insumo)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3">Sin insumos asignados</td></tr>

                            }
                        </tbody>
                    </table>

                    <h6 class="mt-3">Agregar nuevo insumo</h6>
                    <div class="row">
                        <div class="col-8">
                            <select class="form-control" @bind="nuevoInsumo.InsumoId">
                                <option value="">-- Seleccionar Insumo --</option>
                                @foreach (var insumo in insumosDisponibles)
                                {
                                    <option value="@insumo.Id">@insumo.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <input type="number" class="form-control" placeholder="Cantidad" @bind="nuevoInsumo.Cantidad" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalInsumos">Cerrar</button>
                    <button class="btn btn-success" @onclick="AgregarInsumo">Agregar Insumo</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((productoEditar.Id == 0) ? "Agregar Producto" : "Editar Producto")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label>Nombre</label>
                        <input class="form-control" @bind="productoEditar.Nombre" />
                    </div>
                    <div class="mb-2">
                        <label>Descripción</label>
                        <textarea class="form-control" @bind="productoEditar.Descripcion"></textarea>
                    </div>
                    <div class="mb-2">
                        <label>Precio</label>
                        <input type="number" class="form-control" @bind="productoEditar.Precio" />
                    </div>
                    <div class="mb-2">
                        <label>Stock</label>
                        <input type="number" class="form-control" @bind="productoEditar.Stock" />
                    </div>
                    <div class="mb-2">
                        <label>Categoría</label>
                        <select class="form-control" @bind="productoEditar.CategoriaProductoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label>Estado</label>
                        <select class="form-control" @bind="productoEditar.EstadoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var estado in estados)
                            {
                                <option value="@estado.Id">@estado.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="tieneInsumosSwitch" @bind="productoEditar.TieneInsumos" />
                        <label class="form-check-label" for="tieneInsumosSwitch">¿Tiene insumos?</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarProducto">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    List<Producto> productos = new();
    Producto productoEditar = new();
    List<CategoriaProducto> categorias = new();
    List<EstadoProducto> estados = new();
    bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
        await CargarEstados();
        await CargarProductos();
    }

    async Task CargarProductos()
    {
        productos = await ProductoService.GetProductosAsync();
        StateHasChanged(); // Fuerza renderizado
        await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos"); // Inicializa DataTable después del render
    }
    async Task CargarCategorias()
    {
        categorias = await ProductoService.GetCategoriasProductosAsync(); // asegurate que ProductoService tenga este método
    }
    async Task CargarEstados()
    {
        estados = await ProductoService.GetEstadosProductosAsync(); // asegurate que esté en el service
    }

    void MostrarModalNuevo()
    {
        productoEditar = new Producto(); // nuevo
        mostrarModal = true;
    }

    void EditarProducto(Producto p)
    {
        productoEditar = new Producto
            {
                Id = p.Id,
                Nombre = p.Nombre,
                Descripcion = p.Descripcion,
                Precio = p.Precio,
                Stock = p.Stock,
                CategoriaProductoId = p.CategoriaProductoId,
                EstadoId = p.EstadoId,
                TieneInsumos = p.TieneInsumos                
            };
        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    async Task GuardarProducto()
    {
        bool ok;

        if (productoEditar.Id == 0)
        {
            productoEditar.FechaCreacion = DateTime.Now;
            productoEditar.EstadoId = 1;
            ok = await ProductoService.CrearProductoAsync(productoEditar);
        }
        else
        {
            ok = await ProductoService.ActualizarProductoAsync(productoEditar);
        }

        if (ok)
        {
            mostrarModal = false;
            await CargarProductos();
        }
    }

    async Task EliminarProducto(int id)
    {
        bool ok = await ProductoService.EliminarProductoAsync(id);
        if (ok)
        {
            await CargarProductos();
        }
    }

    ElementReference tablaProductosRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && productos.Any())
        {
            await InicializarDataTable();
        }
    }

    async Task InicializarDataTable()
    {
        await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos");
    }
    bool mostrarModalInsumos = false;
    Producto productoSeleccionado;
    List<Insumo> insumosDisponibles = new();
    InsumoProducto nuevoInsumo = new();

    async Task GestionarInsumos(Producto producto)
    {
        productoSeleccionado = producto;

        // Insumos disponibles para agregar (lista completa)
        insumosDisponibles = await ProductoService.GetInsumosAsync();

        // Insumos ya asignados al producto
        productoSeleccionado.InsumosProducto = await ProductoService.GetInsumosAsignadosAsync(producto.Id);

        nuevoInsumo = new InsumoProducto();
        mostrarModalInsumos = true;
    }


    void CerrarModalInsumos()
    {
        mostrarModalInsumos = false;
        productoSeleccionado = null;
        nuevoInsumo = new InsumoProducto();
    }

    async Task AgregarInsumo()
    {
        if (nuevoInsumo.InsumoId > 0 && nuevoInsumo.Cantidad > 0)
        {
            var insumo = insumosDisponibles.FirstOrDefault(i => i.Id == nuevoInsumo.InsumoId);
            if (insumo != null)
            {
                productoSeleccionado.InsumosProducto ??= new List<InsumoProducto>();
                var insumoExistente = productoSeleccionado.InsumosProducto
                    .FirstOrDefault(i => i.InsumoId == nuevoInsumo.InsumoId);

                if (insumoExistente != null)
                {
                    // Actualiza cantidad en la lista local
                    insumoExistente.Cantidad = nuevoInsumo.Cantidad;

                    // Llama a PUT en la API con los dos IDs
                    await ProductoService.ActualizarInsumoProductoAsync(
                        productoSeleccionado.Id,
                        nuevoInsumo.InsumoId,
                        nuevoInsumo
                    );
                }
                else
                {
                    // Agrega a la lista local
                    productoSeleccionado.InsumosProducto.Add(new InsumoProducto
                        {
                            InsumoId = nuevoInsumo.InsumoId,
                            NombreInsumo = insumo.Nombre,
                            Cantidad = nuevoInsumo.Cantidad
                        });

                    // Llama a POST en la API
                    await ProductoService.AsociarInsumoAProducto(productoSeleccionado.Id, nuevoInsumo);
                }
                productoSeleccionado = await ProductoService.RecalcularPrecioProductoAsync(productoSeleccionado.Id);
                await CargarProductos();
            }

            // Limpia los campos del formulario
            nuevoInsumo = new InsumoProducto();
            CerrarModalInsumos();
        }
    }



    void EditarInsumo(InsumoProducto insumo)
    {
        nuevoInsumo = new InsumoProducto
        {
            ProductoId = insumo.ProductoId,
            InsumoId = insumo.InsumoId,
            Cantidad = insumo.Cantidad
        };
    }
    async Task EliminarInsumo(InsumoProducto insumo)
    {
        var exito = await ProductoService.EliminarInsumoProductoAsync(productoSeleccionado.Id, insumo.InsumoId);

        if (exito)
        {
            productoSeleccionado.InsumosProducto = await ProductoService.GetInsumosAsignadosAsync(productoSeleccionado.Id);
            StateHasChanged();
        }
        else
        {
            // Manejar el caso en el que no se pudo eliminar
            Console.WriteLine("No se pudo eliminar el insumo.");
        }
    }


}