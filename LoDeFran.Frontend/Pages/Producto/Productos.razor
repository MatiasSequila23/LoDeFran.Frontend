@page "/producto/productos"

@inject Services.ProductoService ProductoService
@* @inject Services.CategoriaProductoService CategoriaProductoService  *@
@inject IJSRuntime JS

@using LoDeFran.Frontend.Models

<h3 class="mt-4 mb-4">Gestión de Productos</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo"><i class="fas fa-plus"> </i>Nuevo Producto</button>

@if (productos == null)
{
    <div class="text-center">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover" id="tablaProductos">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in productos)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Descripcion</td>
                    <td>$@producto.Precio.ToString("N2")</td>
                    <td>@producto.Stock</td>
                    <td>@(producto.CategoriaProductoNombre ?? "Sin categoría")</td>
                    <td>@(producto.EstadoNombre ?? "Sin estado")</td>

                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" title="Editar" @onclick="() => EditarProducto(producto)">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => EliminarProducto(producto.Id)">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modal -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((productoEditar.Id == 0) ? "Agregar Producto" : "Editar Producto")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label>Nombre</label>
                        <input class="form-control" @bind="productoEditar.Nombre" />
                    </div>
                    <div class="mb-2">
                        <label>Descripción</label>
                        <textarea class="form-control" @bind="productoEditar.Descripcion"></textarea>
                    </div>
                    <div class="mb-2">
                        <label>Precio</label>
                        <input type="number" class="form-control" @bind="productoEditar.Precio" />
                    </div>
                    <div class="mb-2">
                        <label>Stock</label>
                        <input type="number" class="form-control" @bind="productoEditar.Stock" />
                    </div>
                    <div class="mb-2">
                        <label>Categoría</label>
                        <select class="form-control" @bind="productoEditar.CategoriaProductoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label>Estado</label>
                        <select class="form-control" @bind="productoEditar.EstadoId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var estado in estados)
                            {
                                <option value="@estado.Id">@estado.Nombre</option>
                            }
                        </select>
                    </div>


                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarProducto">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    List<Producto> productos = new();
    Producto productoEditar = new();
    List<CategoriaProducto> categorias = new();
    List<EstadoProducto> estados = new();
    bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
        await CargarEstados();
        await CargarProductos();
    }

    async Task CargarProductos()
    {
        productos = await ProductoService.GetProductosAsync();
        StateHasChanged(); // Fuerza renderizado
        await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos"); // Inicializa DataTable después del render
    }
    async Task CargarCategorias()
    {
        categorias = await ProductoService.GetCategoriasProductosAsync(); // asegurate que ProductoService tenga este método
    }
    async Task CargarEstados()
    {
        estados = await ProductoService.GetEstadosProductosAsync(); // asegurate que esté en el service
    }

    void MostrarModalNuevo()
    {
        productoEditar = new Producto(); // nuevo
        mostrarModal = true;
    }

    void EditarProducto(Producto p)
    {
        productoEditar = new Producto
            {
                Id = p.Id,
                Nombre = p.Nombre,
                Descripcion = p.Descripcion,
                Precio = p.Precio,
                Stock = p.Stock,
                CategoriaProductoId = p.CategoriaProductoId,
                EstadoId = p.EstadoId
            };
        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    async Task GuardarProducto()
    {
        bool ok;

        if (productoEditar.Id == 0)
        {
            productoEditar.FechaCreacion = DateTime.Now;
            productoEditar.EstadoId = 1;
            ok = await ProductoService.CrearProductoAsync(productoEditar);
        }
        else
        {
            ok = await ProductoService.ActualizarProductoAsync(productoEditar);
        }

        if (ok)
        {
            mostrarModal = false;
            await CargarProductos();
        }
    }

    async Task EliminarProducto(int id)
    {
        bool ok = await ProductoService.EliminarProductoAsync(id);
        if (ok)
        {
            await CargarProductos();
        }
    }

    ElementReference tablaProductosRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && productos.Any())
        {
            await InicializarDataTable();
        }
    }

    async Task InicializarDataTable()
    {
        await JS.InvokeVoidAsync("initializeDataTable", "tablaProductos");
    }
}