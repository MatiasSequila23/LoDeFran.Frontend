@page "/factura/facturas"
@inject Services.FacturaService FacturaService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <!-- Card Facturas -->
    <div class="card shadow-lg mb-4 border-0 rounded-3">
        <!-- Header -->
        <div class="card-header bg-gradient bg-dark text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 text-white"><i class="fas fa-file-invoice me-2"></i> Gestión de Facturas</h4>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary" @onclick="CargarFacturas" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        @:Cargando...
                    }
                    else
                    {
                        @:Buscar
                    }
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="LimpiarFiltros">
                    <i class="fas fa-broom me-1"></i> Limpiar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Filtros -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label>Número de Factura</label>
                    <div class="input-group input-group-outline">
                        <input class="form-control" @bind="Filtro.NumeroFactura" placeholder="Ej: FAC-00000001" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label>Estado</label>
                    <div class="input-group input-group-outline">
                        <select class="form-control" @bind="Filtro.EstadoId">
                            <option value="">-- Todos --</option>
                            @foreach (var estado in Estados)
                            {
                                <option value="@estado.Id">@estado.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <label>Fecha Desde</label>
                    <div class="input-group input-group-outline">
                        <input type="date" class="form-control" @bind="Filtro.FechaDesde" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label>Fecha Hasta</label>
                    <div class="input-group input-group-outline">
                        <input type="date" class="form-control" @bind="Filtro.FechaHasta" />
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="table-responsive">
                <table id="tablaFacturas" class="table table-striped table-hover" @key="claveTabla">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Número</th>
                            <th>Estado</th>
                            <th>Fecha Emisión</th>
                            <th>Total</th>
                            <th>Cliente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in FacturasVM)
                        {
                            <tr>
                                <td>@factura.NumeroFactura</td>
                                <td>@factura.EstadoNombre</td>
                                <td>@factura.FechaEmision?.ToString("dd/MM/yyyy")</td>
                                <td>@factura.Total.ToString("C")</td>
                                <td>@factura.ClienteNombre</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    Guid claveTabla = Guid.NewGuid();
    List<FacturaViewModel> FacturasVM = new();
    List<EstadoDto> Estados = new();
    FacturaFiltroDto Filtro = new();
    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        Estados = await ObtenerEstadosFacturaAsync();
        await CargarFacturas();
    }

    async Task CargarFacturas()
    {
        isLoading = true;
        try
        {
            await JS.InvokeVoidAsync("destroyDataTable", "tablaFacturas");

            var todasFacturas = await FacturaService.GetAllAsync();
            FacturasVM = todasFacturas.Where(f =>
                (string.IsNullOrEmpty(Filtro.NumeroFactura) || (f.NumeroFactura?.Contains(Filtro.NumeroFactura, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (!Filtro.EstadoId.HasValue || f.EstadoId == Filtro.EstadoId) &&
                (!Filtro.FechaDesde.HasValue || (f.FechaEmision.HasValue && f.FechaEmision.Value.Date >= Filtro.FechaDesde.Value.Date)) &&
                (!Filtro.FechaHasta.HasValue || (f.FechaEmision.HasValue && f.FechaEmision.Value.Date <= Filtro.FechaHasta.Value.Date))
            ).ToList();

            claveTabla = Guid.NewGuid();
            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("initializeDataTable", "tablaFacturas");
        }
        finally
        {
            isLoading = false;
        }
    }

    void LimpiarFiltros()
    {
        Filtro = new();
        _ = CargarFacturas();
    }

    Task<List<EstadoDto>> ObtenerEstadosFacturaAsync()
    {
        return Task.FromResult(new List<EstadoDto>
        {
            new() { Id = 1, Nombre = "Emitida" },
            new() { Id = 2, Nombre = "Pagada" },
            new() { Id = 3, Nombre = "Cancelada" },
        });
    }

    public class FacturaFiltroDto
    {
        public string? NumeroFactura { get; set; }
        public int? EstadoId { get; set; }
        public DateTime? FechaDesde { get; set; }
        public DateTime? FechaHasta { get; set; }
    }

    public class EstadoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
    }
}
