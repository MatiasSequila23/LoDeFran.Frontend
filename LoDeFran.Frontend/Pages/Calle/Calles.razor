@page "/calle/calles"
@inject Services.CalleService CalleService
@inject IJSRuntime JS

@using LoDeFran.Frontend.Models

<h3 class="text-center d-flex justify-content-center align-items-center gap-2">
  Gestión de Calles
</h3>

<div class="container-fluid py-2">
    <div class="row">
        <div class="col-12 col-md-12 col-lg-12 mx-auto my-5">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-dark shadow-dark border-radius-lg py-3 pe-1">
                        <h4 class="text-white font-weight-bolder text-center mt-2">Informacion</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="input-group input-group-outline my-3">
                        <input @bind="nombreBusqueda" @bind:event="oninput" placeholder="Buscar calle..." class="form-control mb-2" />
                    </div>
                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-2 mt-3">
                        <button class="btn btn-primary w-100 w-md-auto" @onclick="BuscarCalles" disabled="@isLoading">Buscar en Base</button>
                        <button class="btn btn-secondary w-100 w-md-auto" @onclick="BuscarEnExcel" disabled="@isLoading">Buscar en Excel</button>
                        <button class="btn btn-success w-100 w-md-auto" @onclick="ImportarDesdeExcel" disabled="@isLoading">Importar desde Excel</button>
                        @if (resultados?.Any() == true)
                        {
                            <button class="btn btn-warning w-100 w-md-auto" @onclick="GuardarTodas" disabled="@isLoading">Guardar todas</button>
                        }
                    </div>

                    <!-- Spinner -->
                    @if (isLoading)
                    {
                        <div class="text-center mt-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (resultados?.Any() == true)
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table align-items-center mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Código</th>
                            <th>NomOficial</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var calle in resultados)
                        {
                            <tr>
                                <td>@calle.Id</td>
                                <td>@calle.Codigo</td>
                                <td>@calle.NomOficial.Trim()</td>
                                <td>
                                    <button class="btn btn-success btn-sm" @onclick="() => GuardarCalle(calle)" disabled="@isLoading">Guardar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => EliminarCalle(calle.Id)" disabled="@isLoading">Eliminar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => EliminarSoloDelFront(calle.Id)" disabled="@isLoading">Quitar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private string nombreBusqueda = string.Empty;
    private List<CalleViewModel> resultados = new();
    private bool isLoading = false;

    private async Task RunWithLoading(Func<Task> action)
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            await action();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private Task BuscarCalles() => RunWithLoading(async () =>
    {
        resultados = await CalleService.BuscarDesdeBase(nombreBusqueda);
    });

    private Task BuscarEnExcel() => RunWithLoading(async () =>
    {
        resultados = await CalleService.BuscarDesdeExcel(nombreBusqueda);
    });

    private Task ImportarDesdeExcel() => RunWithLoading(async () =>
    {
        await CalleService.ImportarDesdeExcel();
        await BuscarCalles();
    });

    private Task GuardarCalle(CalleViewModel calle) => RunWithLoading(async () =>
    {
        await CalleService.GuardarDesdeExcel(calle);
        await BuscarCalles();
    });

    private Task EliminarCalle(int id) => RunWithLoading(async () =>
    {
        await CalleService.EliminarCalle(id);
        await BuscarCalles();
    });

    private void EliminarSoloDelFront(int id)
    {
        var item = resultados.FirstOrDefault(c => c.Id == id);
        if (item != null)
        {
            resultados.Remove(item);
        }
    }

    private Task GuardarTodas() => RunWithLoading(async () =>
    {
        foreach (var calle in resultados)
        {
            await CalleService.GuardarDesdeExcel(calle);
        }
        await BuscarCalles();
    });
}
