@page "/Proveedor/Proveedores"
@inject Services.ProveedorService ProveedorService
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models

<div class="container mt-3">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white">📦 Gestión de Proveedores</h4>
            <button class="btn btn-light btn-sm" @onclick="MostrarModalNuevo">
                <i class="fas fa-plus me-1"></i>Nuevo
            </button>
        </div>

        <div class="card-body">
            @if (proveedores == null)
            {
                <div class="text-center my-4">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-2">Cargando proveedores...</p>
                </div>
            }
            else if (!proveedores.Any())
            {
                <div class="alert alert-info text-center text-white">No hay proveedores registrados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped" id="tablaProveedores">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Dirección</th>
                                <th>Email</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in proveedores)

                            {
                                <tr>
                                    <td>@p.Nombre</td>
                                    <td>@p.Telefono</td>
                                    <td>@p.Direccion</td>
                                    <td>@p.Email</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" title="Editar" @onclick="() => EditarProveedor(p)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => EliminarProveedor(p.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarModal)

{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">@((proveedorEditar.Id == 0) ? "Agregar Proveedor" : "Editar Proveedor")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <div class="input-group input-group-static mb-3">

                                <input class="form-control" @bind="proveedorEditar.Nombre" placeholder="" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <div class="input-group input-group-static mb-3">

                                <input class="form-control" @bind="proveedorEditar.Telefono" placeholder="" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Dirección</label>
                            <div class="input-group input-group-static mb-3">

                                <input class="form-control" @bind="proveedorEditar.Direccion" placeholder="" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <div class="input-group input-group-static mb-3">

                                <input class="form-control" @bind="proveedorEditar.Email" placeholder="" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarProveedor">💾 Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<ProveedorViewModel> proveedores = new();

    ProveedorViewModel proveedorEditar = new();

    bool mostrarModal = false;



    protected override async Task OnInitializedAsync()

    {

        await CargarProveedores();

    }



    async Task CargarProveedores()

    {

        await JS.InvokeVoidAsync("destroyDataTable", "tablaProveedores");

        proveedores = await ProveedorService.GetProveedoresAsync();

        StateHasChanged();

        await JS.InvokeVoidAsync("initializeDataTable", "tablaProveedores");

    }



    void MostrarModalNuevo()

    {

        proveedorEditar = new ProveedorViewModel();

        mostrarModal = true;

    }



    void EditarProveedor(ProveedorViewModel p)

    {

        proveedorEditar = new ProveedorViewModel
            {
                Id = p.Id,
                Nombre = p.Nombre,
                Telefono = p.Telefono,
                Direccion = p.Direccion,
                Email = p.Email
            };

        mostrarModal = true;

    }



    void CerrarModal()

    {

        mostrarModal = false;

    }



    async Task GuardarProveedor()

    {

        bool ok;

        if (proveedorEditar.Id == 0)

        {

            ok = await ProveedorService.CrearProveedorAsync(proveedorEditar);

        }

        else

        {

            ok = await ProveedorService.ActualizarProveedorAsync(proveedorEditar);

        }



        if (ok)

        {

            mostrarModal = false;

            await CargarProveedores();

        }

    }



    async Task EliminarProveedor(int id)

    {

        var ok = await ProveedorService.EliminarProveedorAsync(id);

        if (ok)

        {

            await CargarProveedores();

        }

    }
}
