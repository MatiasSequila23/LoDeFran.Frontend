    }

    private void CerrarModal()
    {
        MesaSeleccionada = null;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;
    }

    private async Task IniciarPedido()
    {
        if (MesaSeleccionada == null)
            return;
        if (MozoSeleccionadoId == 0 || MozoSeleccionadoId == null)
        {
            await JS.InvokeVoidAsync("mostrarAlerta",
                "Falta seleccionar mozo",
                "Por favor selecciona un mozo antes de iniciar el pedido.",
                "warning");
            return;
        }
        try
        {
            var pedido = new CrearPedidoRequest
                {
                    ClienteId = ClienteSeleccionadoId,
                    TipoPedidoId = 1, // Mesa
                    MesaId = MesaSeleccionada.Id,
                    UsuarioId = MozoSeleccionadoId
                };

            //PedidoActual = await ServicioDeMesaService.IniciarPedidoAsync(MesaSeleccionada.Id);
            //PedidoActual = await PedidoService.CreateAsync(pedido);
            PedidoActual = await PedidoService.CrearPedidoGenericoAsync(pedido);
            //await MesaService.CambiarEstadoMesaAsync(MesaSeleccionada.Id, Enums.EstadoMesa.Ocupada);



            PedidoIniciado = true;
            ErrorMensaje = null;
            Nav.NavigateTo($"/Pedido/PedidoBuilderMesaAdmin/{PedidoActual.Id}");
        }
        catch (Exception ex)
        {
            ErrorMensaje = $"Error: {ex.Message}";
        }
    }

    private void VerPedido()
    {
        if (PedidoActual != null)
            Nav.NavigateTo($"/Pedido/PedidoBuilderMesaAdmin/{PedidoActual.Id}");
    }

