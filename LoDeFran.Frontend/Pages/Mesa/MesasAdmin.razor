        3 => "svg-rojo",      // Reservada
        _ => "svg-gris"
    };

    private string ObtenerClaseEstadoTexto(int? estadoId) => estadoId switch
    {
        1 => "estado-verde",     // Disponible
        2 => "estado-amarillo",  // Ocupada
        3 => "estado-rojo",      // Reservada
        _ => "estado-gris"
    };




