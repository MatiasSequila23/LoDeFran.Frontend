    private async Task GenererPreCuenta(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
