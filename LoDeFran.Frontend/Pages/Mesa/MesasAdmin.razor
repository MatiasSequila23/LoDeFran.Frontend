    private async Task SeleccionarCliente(int clienteId)
    {
        if (clienteId > 0)
        {
            ClienteSeleccionado = ClientesEncontrados.FirstOrDefault(c => c.Id == clienteId);
            ClienteSeleccionadoId = clienteId; // lo seguís guardando si querés
        }
        else
        {
            ClienteSeleccionado = null;
            ClienteSeleccionadoId = null;
        }

