@if (MesaSeleccionada != null)
{
    <div class="modal-backdrop fade show" @onclick="CerrarModal"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <h5 class="modal-title d-flex align-items-center gap-2 mb-0 flex-grow-1">
                            <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                            Detalle Mesa @MesaSeleccionada.Numero
                        </h5>
                    </div>
                    <button type="button" class="btn-close text-dark" @onclick="CerrarModal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <div class="row g-3">
                        @if (PedidoActual?.ClienteId != null && ClienteSeleccionado != null)
                        {
                            <div class="d-flex align-items-center gap-2 justify-content-center"
                                 style="cursor: pointer;"
                                 @onclick="() => MostrarCliente(PedidoActual.ClienteId)">
                                <div class="avatar avatar-sm">
                                    <img src="../assets/img/bruce-mars.jpg"
                                         alt="profile_image"
                                         class="w-100 border-radius-lg shadow-sm">
                                </div>
                                <div>
                                    <small class="fw-bold d-block">
                                        @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido
                                    </small>
                                    <small class="text-muted" style="font-size: 0.8rem;">
                                        @ClienteSeleccionado.Telefono
                                    </small>
                                </div>
                            </div>
                        }
                        <!-- Estado (fuera del if) -->
                        <div class="d-flex justify-content-center mt-2">
                            <div class="badge bg-info text-white small d-flex align-items-center px-3 py-2">
                                <i class="bi bi-box-seam me-1"></i> Estado:
                                @(
                                    PedidoActual != null && PedidoActual.EstadoId > 0
                                    ? ((Enums.EstadoPedido)PedidoActual.EstadoId).ToString()
                                    : "--"
                                    )
                            </div>
                        </div>
                        <!-- TABS -->
                        <ul class="nav nav-tabs nav-fill w-100 mb-3" id="pedidoTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-mozos"
                                        data-bs-toggle="tab" data-bs-target="#pane-mozos"
                                        type="button" role="tab">
                                    <i class="fas fa-user-tie me-1"></i> Mozos
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-clientes"
                                        data-bs-toggle="tab" data-bs-target="#pane-clientes"
                                        type="button" role="tab">
                                    <i class="fas fa-users me-1"></i> Clientes
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-detalle"
                                        data-bs-toggle="tab" data-bs-target="#pane-detalle"
                                        type="button" role="tab">
                                    <i class="fas fa-info-circle me-1"></i> Detalle Cliente
                                </button>
                            </li>
                        </ul>

                        <!-- CONTENIDO -->
                        <div class="tab-content">
                            <!-- Mozos -->
                            <div class="tab-pane fade show active" id="pane-mozos" role="tabpanel">
                                <div class="row mt-1">
                                    @foreach (var mozo in Mozos)
                                    {
                                        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                            <div class="card card-body shadow-sm @(MozoSeleccionadoId == mozo.Id ? "border-success" : "border")"
                                                 style="cursor:pointer;"
                                                 @onclick="() => SeleccionarMozo(mozo.Id)">
                                                <div class="row gx-4 mb-2">
                                                    <div class="col-auto">
                                                        <div class="avatar avatar-xl position-relative">
                                                            <img src="../assets/img/bruce-mars.jpg"
                                                                 alt="foto mozo"
                                                                 class="w-100 border-radius-lg shadow-sm" />
                                                        </div>
                                                    </div>
                                                    <div class="col my-auto">
                                                        <div class="h-100">
                                                            <p class="mb-1" style="color:@(MozoSeleccionadoId == mozo.Id ? "#28a745" : "inherit")">
                                                                @mozo.Nombre
                                                            </p>
                                                            <p class="mb-0 font-weight-normal text-sm">Mozo</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Clientes -->
                            <div class="tab-pane fade" id="pane-clientes" role="tabpanel">
                                <div class="card blur shadow-blur max-height-vh-70 overflow-auto">
                                    <div class="card-header p-3">
                                        <h6>Clientes</h6>
                                        <label class="form-label">Buscar cliente</label>
                                        <div class="input-group input-group-outline">
                                            <input class="form-control" placeholder="Teléfono, email, calle..."
                                                   @bind="BusquedaCliente" @bind:event="oninput" />
                                        </div>
                                    </div>
                                    <div class="card-body p-2">
                                        @if (ClientesEncontrados.Any())
                                        {
                                            @foreach (var cliente in ClientesEncontrados)
                                            {
                                                <a href="javascript:;" class="d-block p-2 @(ClienteSeleccionadoId == cliente.Id ? "bg-gradient-dark border-radius-lg" : "")"
                                                   @onclick="() => SeleccionarCliente(cliente.Id)">
                                                    <div class="d-flex p-2">
                                                        <img alt="Cliente" src="../../assets/img/team-5.jpg" class="avatar shadow">
                                                        <div class="ms-3">
                                                            <h6 class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0" : "mb-0")">
                                                                @cliente.Nombre @cliente.Apellido
                                                            </h6>
                                                            <p class="@(ClienteSeleccionadoId == cliente.Id ? "text-white mb-0 text-sm" : "text-muted text-xs mb-0")">
                                                                @cliente.Telefono
                                                            </p>
                                                            <span class="text-muted text-sm d-block">@cliente.Calle @cliente.Altura</span>
                                                        </div>
                                                    </div>
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-center text-muted">No se encontraron clientes</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Detalle Cliente -->
                            <div class="tab-pane fade" id="pane-detalle" role="tabpanel">
                                <div class="card blur shadow-blur h-100">
                                    <div class="card-header p-3">
                                        <h6>Información del cliente</h6>
                                    </div>
                                    @if (ClienteSeleccionado != null)
                                    {
                                        <div class="card-body p-3">
                                            <ul class="list-group">
                                                <li class="list-group-item border-0 ps-0 text-sm">
                                                    <strong class="text-dark">Nombre completo:</strong>
                                                    @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido
                                                </li>
                                                <li class="list-group-item border-0 ps-0 text-sm">
                                                    <strong class="text-dark">Teléfono:</strong> @ClienteSeleccionado.Telefono
                                                </li>
                                                <li class="list-group-item border-0 ps-0 text-sm">
                                                    <strong class="text-dark">Email:</strong> @ClienteSeleccionado.Email
                                                </li>
                                                <li class="list-group-item border-0 ps-0 text-sm">
                                                    <strong class="text-dark">Dirección:</strong>
                                                    @ClienteSeleccionado.Calle @ClienteSeleccionado.Altura
                                                    @(string.IsNullOrWhiteSpace(ClienteSeleccionado.Piso) ? "" : $", Piso {ClienteSeleccionado.Piso}")
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="card-body p-3 text-center text-muted">
                                            <p class="mt-2 mb-0">Ningún cliente seleccionado</p>
                                            <small>Usa el buscador para elegir uno</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ErrorMensaje))
                    {
                        <div class="alert alert-danger mt-2">@ErrorMensaje</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    @if (PedidoIniciado)
                    {
                        @* <div class="alert alert-success text-center mt-3"><p><i class="bi bi-check-circle-fill"></i> Pedido ya iniciado</p></div> *@
                        <button class="btn btn-success btn-lg w-100" @onclick='() => Nav.NavigateTo($"/Pedido/PedidoBuilderMesa/{PedidoActual?.Id}")'>
                            <i class="bi bi-eye me-1"></i> Ver Pedido
                        </button>

                        @if (EstadoPedidoActualId == (int)Enums.EstadoPedido.ListoParaEntregar)
                        {
                            <button class="btn btn-info w-100 mb-2" @onclick="() => CambiarEstadoEntregado(PedidoActual.Id, Enums.EstadoPedido.Entregado)">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Pedido Entregado
                            </button>
                        }
                        else if (EstadoPedidoActualId == (int)Enums.EstadoPedido.Entregado)
                        {
                            <button class="btn btn-warning w-100 mb-2" @onclick="() => GenererPreCuenta(PedidoActual.Id, Enums.EstadoPedido.A_Cobrar)">
                                <i class="bi bi-cash-coin me-1"></i> Generar Cuenta
                            </button>
                            <!-- Contenido oculto del ticket -->
                            <div style="display:none">
                                <div id="ticket-precuenta" style="font-family: monospace; width:260px;">

                                    <!-- Nombre / Logo del local -->
                                    <h3 style="text-align:center; margin:0;">🍴 Bar-Pizzería Lo De Fran</h3>
                                    <p style="text-align:center; font-size:11px; margin:0;">
                                        📞 Tel: 011-1234-5678<br />
                                        📍 Potosi 3800
                                    </p>

                                    <h4 style="text-align:center; margin:4px 0;">🧾 Cuenta</h4>

                                    <!-- Datos de pedido -->
                                    <p style="margin:0; font-size:12px;">
                                        @* Solo salón muestra mesa y mozo *@
                                        @if (PedidoActual?.TipoPedidoId == 1 && PedidoActual.Mesa != null)
                                        {
                                            <span><strong>Mesa:</strong> @PedidoActual.Mesa.Numero</span>

                                            <br />
                                            <span><strong>Mozo:</strong> @PedidoActual.NombreMozo</span>

                                            <br />
                                        }

                                        <span><strong>Fecha y hora:</strong> @PedidoActual?.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</span><br />
                                    </p>

                                    <hr />

                                    <!-- Detalle de productos y combos -->
                                    <ul style="list-style-type:none; padding:0; margin:0;">
                                        @foreach (var item in PedidoActual.DetallePedido)
                                        {
                                            <li style="margin-bottom:6px; display:flex; justify-content:space-between;">
                                                <span>@item.Cantidad x @item.Producto.Nombre</span>
                                                <span>$ @((item.PrecioUnitario * item.Cantidad).ToString("N2"))</span>
                                            </li>
                                        }

                                        @if (PedidoActual.PedidoCombos.Any())
                                        {
                                            <li>
                                                <strong>Combos:</strong>
                                                <ul style="list-style-type:none; padding-left:10px; margin-top:4px;">
                                                    @foreach (var combo in PedidoActual.PedidoCombos)
                                                    {
                                                        <li style="display:flex; justify-content:space-between;">
                                                            <span>@combo.Cantidad x @combo.Nombre</span>
                                                            <span>$ @(combo.Precio.ToString("N2"))</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>

                                    <hr />

                                    <!-- Totales -->
                                    @{
                                        var subtotal = PedidoActual.DetallePedido.Sum(x => x.Cantidad * x.PrecioUnitario) +
                                        PedidoActual.PedidoCombos.Sum(c => c.Cantidad * c.Precio);
                                        var descuento = PedidoActual.MontoDescuento;
                                        var total = subtotal - (descuento ?? 0);
                                    }

                                    <p style="display:flex; justify-content:space-between; margin:2px 0;">
                                        <strong>Subtotal:</strong> <span>$ @subtotal.ToString("N2")</span>
                                    </p>
                                    <p style="display:flex; justify-content:space-between; margin:2px 0;">
                                        <strong>Descuento:</strong> <span>$ @(descuento?.ToString("N2") ?? "0,00")</span>
                                    </p>
                                    <p style="display:flex; justify-content:space-between; margin:4px 0; font-size:14px;">
                                        <strong>Total:</strong> <span>$ @total.ToString("N2")</span>
                                    </p>

                                    <hr />

                                    <!-- Leyenda y mensaje de cortesía -->
                                    <p style="text-align:center; font-size:11px; margin-top:4px;">
                                        Propina no incluida, se recomienda dejar 10%<br />
                                        ¡Gracias por elegirnos!<br />
                                        *** Documento no válido como factura ***
                                    </p>
                                </div>
                            </div>
                            <!-- Iframe oculto para impresión -->
                            <div style="display:none">
                                <iframe id="print-frame"></iframe>
                            </div>
                        }
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg w-100 mt-3" @onclick="IniciarPedido">
                            <i class="bi bi-plus-circle me-1"></i> Iniciar Pedido
                        </button>
                    }
                    <button class="btn btn-secondary btn-lg w-100" @onclick="CerrarModal"><i class="bi bi-x-circle me-1"></i> Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

