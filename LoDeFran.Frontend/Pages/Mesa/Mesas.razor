@if (MesaSeleccionada != null)
{
    <div class="modal-backdrop fade show" @onclick="CerrarModal"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <h5 class="modal-title d-flex align-items-center gap-2 mb-0 flex-grow-1">
                            <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                            Detalle Mesa @MesaSeleccionada.Numero
                        </h5>

                       
                    </div>


                   

                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <div class="row g-3">
                        @if (PedidoActual?.ClienteId != null && ClienteSeleccionado != null)
                        {
                            <div class="d-flex align-items-center gap-2 justify-content-center"
                                 style="cursor: pointer;"
                                 @onclick="() => MostrarCliente(PedidoActual.ClienteId)">
                                <div class="avatar avatar-sm">
                                    <img src="../assets/img/bruce-mars.jpg"
                                         alt="profile_image"
                                         class="w-100 border-radius-lg shadow-sm">
                                </div>
                                <div>
                                    <small class="fw-bold d-block">
                                        @ClienteSeleccionado.Nombre @ClienteSeleccionado.Apellido
                                    </small>
                                    <small class="text-muted" style="font-size: 0.8rem;">
                                        @ClienteSeleccionado.Telefono
                                    </small>
                                </div>
                            </div>
                        }

                        <!-- Estado (fuera del if) -->
                        <div class="d-flex justify-content-center mt-2">
                            <div class="badge bg-info text-white small d-flex align-items-center px-3 py-2">
                                <i class="bi bi-box-seam me-1"></i> Estado:
                                @(
                                    PedidoActual != null && PedidoActual.EstadoId > 0
                                    ? ((Enums.EstadoPedido)PedidoActual.EstadoId).ToString()
                                    : "--"
                                    )
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            @foreach (var mozo in Mozos)
                            {
                                <div class="card"
                                     style="width: 250px; cursor: pointer;"
                                     @onclick="() => SeleccionarMozo(mozo.Id)">
                                    <div class="card-header p-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <p class="text-sm mb-0 text-capitalize">Mozo</p>
                                                <h4 class="mb-0" style="color:@(MozoSeleccionadoId == mozo.Id ? "#28a745" : "inherit")">
                                                    @mozo.Nombre
                                                </h4>
                                            </div>
                                            <div class="icon icon-md icon-shape shadow text-center border-radius-lg"
                                                 style="background: @(MozoSeleccionadoId == mozo.Id
                             ? "linear-gradient(195deg, #66bb6a, #43a047)"
                             : "#6c757d");">
                                                <i class="material-symbols-rounded opacity-10" style="font-size: 2rem;">
                                                    person
                                                </i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                       
                        <label>Buscar Cliente (teléfono, email, calle o altura)</label>
                        <div class="input-group input-group-outline" b-t77ijd2y4e="">
                            <input type="text" class="form-control" @bind="BusquedaCliente" @bind:event="oninput" b-t77ijd2y4e="" placeholder="Ej: 123456789 o calle">
                        </div>
                     
                        @if (ClientesEncontrados.Any())
                        {
                            <div class="col-12 mt-3">
                                <label>Seleccionar Cliente</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var cliente in ClientesEncontrados)
                                    {
                                        <div class="card text-center p-2"
                                             style="cursor:pointer; min-width: 140px; flex: 1 0 140px; border: 2px solid @(ClienteSeleccionadoId == cliente.Id ? "#0d6efd" : "#ccc"); background-color: @(ClienteSeleccionadoId == cliente.Id ? "#cfe2ff" : "white");"
                                             @onclick="() => ClienteSeleccionadoId = cliente.Id">
                                            <div class="card-body p-2">
                                                <i class="bi bi-person-circle" style="font-size: 2rem;"></i>
                                                <h6 class="mt-2 mb-1">@cliente.Nombre @cliente.Apellido</h6>
                                                <small class="text-muted d-block">
                                                    @cliente.Telefono <br />
                                                    @cliente.Calle @cliente.Altura, Piso @cliente.Piso
                                                </small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                    </div>

                    

                    @if (!string.IsNullOrWhiteSpace(ErrorMensaje))
                    {
                        <div class="alert alert-danger mt-2">@ErrorMensaje</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    @if (PedidoIniciado)
                    {
                        @* <div class="alert alert-success text-center mt-3"><p><i class="bi bi-check-circle-fill"></i> Pedido ya iniciado</p></div> *@
                        <button class="btn btn-success btn-lg w-100" @onclick='() => Nav.NavigateTo($"/Pedido/PedidoBuilderMesa/{PedidoActual?.Id}")'>
                            <i class="bi bi-eye me-1"></i> Ver Pedido
                        </button>

                        @if (EstadoPedidoActualId == (int)Enums.EstadoPedido.ListoParaEntregar)
                        {
                            <button class="btn btn-info w-100 mb-2" @onclick="() => CambiarEstadoEntregado(PedidoActual.Id, Enums.EstadoPedido.Entregado)">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Pedido Entregado
                            </button>
                        }
                        else if (EstadoPedidoActualId == (int)Enums.EstadoPedido.Entregado)
                        {
                            <button class="btn btn-warning w-100 mb-2" @onclick="() => GenererPreCuenta(PedidoActual.Id, Enums.EstadoPedido.A_Cobrar)">
                                <i class="bi bi-cash-coin me-1"></i> Generar Cuenta
                            </button>


                            <!-- Contenido oculto del ticket -->
                            <div style="display:none">
                                <div id="ticket-precuenta">
                                    <h3>🧾 Cuenta</h3>
                                    <p>
                                        <strong>Pedido:</strong> #@PedidoActual.Id <br />

                                        @* Solo salón muestra mesa y mozo *@
                                        @if (PedidoActual.TipoPedidoId == 1 && PedidoActual.Mesa != null)
                                        {
                                            <span><strong>Mesa:</strong> @PedidoActual.Mesa.Numero</span>

                                            <br />
                                            <span><strong>Mozo:</strong> @PedidoActual.NombreMozo</span>

                                            <br />
                                        }

                                        <span><strong>Hora:</strong> @PedidoActual.FechaPedido?.ToString("HH:mm")</span><br />
                                    </p>

                                    <hr />

                                    <ul style="list-style-type:none; padding:0; margin:0;">
                                        @foreach (var item in PedidoActual.DetallePedido)
                                        {
                                            <li style="margin-bottom:6px;">
                                                <span>@item.Cantidad x @item.Producto.Nombre</span>
                                                <span>$ @((item.PrecioUnitario * item.Cantidad).ToString("N2"))</span>
                                            </li>
                                        }

                                        @if (PedidoActual.PedidoCombos.Any())
                                        {
                                            <li>
                                                <strong>Combos:</strong>
                                                <ul style="list-style-type:circle; padding-left:15px;">
                                                    @foreach (var combo in PedidoActual.PedidoCombos)
                                                    {
                                                        <li>@combo.Nombre (x@combo.Cantidad) - 💲 @(combo.Precio.ToString("N2"))</li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>

                                    <hr />
                                    <h4>Total: $ @PedidoActual.Total</h4>
                                </div>
                            </div>

                            <!-- Iframe oculto para impresión -->
                            <div style="display:none">
                                <iframe id="print-frame"></iframe>
                            </div>
                        }
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg w-100 mt-3" @onclick="IniciarPedido">
                            <i class="bi bi-plus-circle me-1"></i> Iniciar Pedido
                        </button>
                    }
                    <button class="btn btn-secondary btn-lg w-100" @onclick="CerrarModal"><i class="bi bi-x-circle me-1"></i> Cerrar</button>
                </div>
            </div>
        </div>
    </div>

 
}




@code {
    private List<PisoViewModel> Pisos = new();
    private PisoViewModel? PisoSeleccionado;
    private List<MesaViewModel> MesasVM = new();
    private List<UsuarioViewModel> Mozos = new();
    private MesaViewModel? MesaSeleccionada;
    private PedidoViewModel? PedidoActual;
    private bool PedidoIniciado = false;
    private string? ErrorMensaje;
    private int? EstadoPedidoActualId => PedidoActual?.EstadoId;



    private string _busquedaCliente = "";

    private string BusquedaCliente
    {
        get => _busquedaCliente;
        set
        {
            if (_busquedaCliente != value)
            {
                _busquedaCliente = value;
                _ = BuscarClienteAutomaticamente();
            }
        }
    }
    private bool BuscoCliente = false;
    private List<ClienteViewModel> ClientesEncontrados = new();
    private int? ClienteSeleccionadoId;
    private int? MozoSeleccionadoId;
    private ClienteViewModel NuevoCliente = new();
    private ClienteViewModel? ClienteSeleccionado;

    private bool PuedeCrear =>
        ClienteSeleccionadoId.HasValue ||
        (!string.IsNullOrWhiteSpace(NuevoCliente.Nombre) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Telefono) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Calle) &&
         !string.IsNullOrWhiteSpace(NuevoCliente.Altura));




    protected override async Task OnInitializedAsync()
    {
        await clearDataTable();
        Pisos = await ServicioDeMesaService.GetPisosAsync();
        PisoSeleccionado = null;
        MesasVM.Clear();
        MesasVM = await ServicioDeMesaService.GetMesasAsync();
        Mozos = await UsuarioService.GetMozosAsync();

    }
    private async Task clearDataTable()
    {
        await JS.InvokeVoidAsync("destroyDataTable", "tablaPedidos");
        await JS.InvokeVoidAsync("destroyDataTable", "tablaCaja");
    }
    private async Task CambiarPiso(PisoViewModel piso)
    {
        PisoSeleccionado = piso;
        MesasVM = await ServicioDeMesaService.GetMesasPorPisoAsync(piso.IdPiso);

    }
    private void SeleccionarMozo(int id)
    {
        MozoSeleccionadoId = id;

        if (PedidoActual != null)
        {
            PedidoActual.UsuarioId = id; // Asignar el mozo al pedido
        }
    }
    private async Task VerTodasLasMesas()
    {
        PisoSeleccionado = null;
        MesasVM.Clear();
        MesasVM = await ServicioDeMesaService.GetMesasAsync();
    }

    private async Task MostrarDetalleMesa(MesaViewModel mesa)
    {
        MesaSeleccionada = mesa;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;
        ClienteSeleccionado = null;
        ClienteSeleccionadoId = null;

        try
        {
            PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorMesaIdAsync(mesa.Id);
            PedidoIniciado = true;
            MozoSeleccionadoId = PedidoActual.UsuarioId;

            if (PedidoActual?.ClienteId != null)
            {
                ClienteSeleccionado = await ClienteService.GetClienteAsync(Convert.ToInt32(PedidoActual.ClienteId));
            }


            ClienteSeleccionadoId = PedidoActual.ClienteId;
        }
        catch
        {
            PedidoIniciado = false;
            PedidoActual = null;
        }
    }

    private async Task CambiarEstadoEntregado(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        foreach (var det in PedidoActual.DetallePedido)
        {
            if (det.EstadoCocinaId == (int)Enums.EstadoDetallePedidoCocina.Preparado) // O según el nombre real en BD
            {
                await DetallePedidoServicie.ActualizarEstadoCocinaAsync(det.Id, (int)Enums.EstadoDetallePedidoCocina.Entregado);
            }
        }
        CerrarModal(); // opcional
    }
    private async Task CambiarEstado(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        CerrarModal(); // opcional
    }
    private async Task GenererPreCuenta(int idPedido, Enums.EstadoPedido nuevoEstado)
    {
        await ServicioDeMesaService.CambiarEstadoPedidoAsync(idPedido, nuevoEstado);
        PedidoActual = await ServicioDeMesaService.ObtenerPedidoPorIdAsync(PedidoActual.Id);
        CerrarModal(); // opcional

        var html = await JS.InvokeAsync<string>("eval", "document.getElementById('ticket-precuenta').outerHTML");
        await JS.InvokeVoidAsync("printIframe", html);
    }

    private void CerrarModal()
    {
        MesaSeleccionada = null;
        ErrorMensaje = null;
        PedidoIniciado = false;
        PedidoActual = null;
    }

    private async Task IniciarPedido()
    {
        if (MesaSeleccionada == null)
            return;

        try
        {
            var pedido = new CrearPedidoRequest
                {
                    ClienteId = ClienteSeleccionadoId,
                    TipoPedidoId = 1, // Mesa
                    MesaId = MesaSeleccionada.Id,
                    UsuarioId = MozoSeleccionadoId
                };

            //PedidoActual = await ServicioDeMesaService.IniciarPedidoAsync(MesaSeleccionada.Id);
            //PedidoActual = await PedidoService.CreateAsync(pedido);
            PedidoActual = await PedidoService.CrearPedidoGenericoAsync(pedido);
            //await MesaService.CambiarEstadoMesaAsync(MesaSeleccionada.Id, Enums.EstadoMesa.Ocupada);



            PedidoIniciado = true;
            ErrorMensaje = null;
            Nav.NavigateTo($"/Pedido/PedidoBuilderMesa/{PedidoActual.Id}");
        }
        catch (Exception ex)
        {
            ErrorMensaje = $"Error: {ex.Message}";
        }
    }

    private void VerPedido()
    {
        if (PedidoActual != null)
            Nav.NavigateTo($"/Pedido/PedidoBuilderMesa/{PedidoActual.Id}");
    }

    private string ObtenerClaseBadge(int? estadoId) => estadoId switch
    {
        1 => "success",
        2 => "warning",
        3 => "danger",
        _ => "secondary"
    };

    private string ObtenerClaseColorSvg(int? estadoId) => estadoId switch
    {
        1 => "svg-verde",     // Disponible
        2 => "svg-amarillo",  // Ocupada
        3 => "svg-rojo",      // Reservada
        _ => "svg-gris"
    };

    private string ObtenerClaseEstadoTexto(int? estadoId) => estadoId switch
    {
        1 => "estado-verde",     // Disponible
        2 => "estado-amarillo",  // Ocupada
        3 => "estado-rojo",      // Reservada
        _ => "estado-gris"
    };




    [JSInvokable]
    public Task SetCalleDesdeJS(string calle)
    {
        NuevoCliente.Calle = calle;
        StateHasChanged();
        return Task.CompletedTask;
    }


    private async Task BuscarClienteAutomaticamente()
    {
        if (BusquedaCliente.Trim().Length >= 3)
        {
            ClientesEncontrados = await ServicioDeMesaService.BuscarClientesAsync(BusquedaCliente.Trim());
            BuscoCliente = true;
            StateHasChanged();
        }
        else
        {
            ClientesEncontrados.Clear();
            BuscoCliente = false;
        }
    }

    private async Task GuardarNuevoCliente()
    {
        if (string.IsNullOrWhiteSpace(NuevoCliente.Nombre) || string.IsNullOrWhiteSpace(NuevoCliente.Telefono))
            return;

        var clienteCreado = await ClienteService.CrearClienteAsync(NuevoCliente);
        ClienteSeleccionadoId = clienteCreado.Id;
        await JS.InvokeVoidAsync("cerrarModal", "#modalNuevoCliente");

        BusquedaCliente = $"{clienteCreado.Nombre} {clienteCreado.Apellido}";
        ClientesEncontrados = new List<ClienteViewModel> { clienteCreado };

        LimpiarNuevoCliente();
    }

    private async Task MostrarCliente(int? clienteId)
    {
        if (clienteId == null) return;
        ClienteSeleccionado = await ClienteService.GetClienteAsync(clienteId.Value);
        await JS.InvokeVoidAsync("mostrarModal", "#modalCliente");
    }

