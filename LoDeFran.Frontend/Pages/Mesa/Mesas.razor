    {
        NuevoCliente.Calle = calle;
        StateHasChanged();
        return Task.CompletedTask;
    }


    private async Task BuscarClienteAutomaticamente()
    {
        if (BusquedaCliente.Trim().Length >= 3)
        {
            ClientesEncontrados = await ServicioDeMesaService.BuscarClientesAsync(BusquedaCliente.Trim());
            BuscoCliente = true;
            StateHasChanged();
