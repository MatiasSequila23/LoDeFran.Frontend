    private async Task IniciarPedido()
    {
        if (MesaSeleccionada == null)
            return;
        if (MozoSeleccionadoId == 0 || MozoSeleccionadoId == null)
        {
            await JS.InvokeVoidAsync("mostrarAlerta",
                "Falta seleccionar mozo",
                "Por favor selecciona un mozo antes de iniciar el pedido.",
                "warning");
            return;
        }
        try
        {
            var pedido = new CrearPedidoRequest
                {
                    ClienteId = ClienteSeleccionadoId,
                    TipoPedidoId = 1, // Mesa
                    MesaId = MesaSeleccionada.Id,
                    UsuarioId = MozoSeleccionadoId
                };

