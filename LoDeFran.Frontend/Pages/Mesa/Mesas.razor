@page "/mesa/mesas"
@layout LayoutMesasSalon
@inject Services.ServicioDeMesaService ServicioDeMesaService
@inject Services.ClienteService ClienteService
@inject Services.MesaService MesaService
@inject Services.PedidoService PedidoService
@inject Services.UsuarioService UsuarioService
@inject Services.DetallePedidoServicie DetallePedidoServicie
@inject NavigationManager Nav
@inject IJSRuntime JS
@using LoDeFran.Frontend.Models
@using LoDeFran.Frontend.Services
@using LoDeFran.Frontend.Utlis.ClassAux
@using LoDeFran.Frontend.Utlis

<style>
   /* Círculo leyenda más grande */
.color-circulo {
    width: 20px;
    height: 20px;
    border-radius: 50%;
}

/* Botones mesas */
.mesa-icon {
    border-radius: 0.5rem;
    border: 1px solid #ccc;
    background-color: #fff;
    cursor: pointer;
    font-size: 1.25rem;
    min-width: 90px;
    min-height: 90px;
    transition: background-color 0.3s ease;
}

.mesa-icon:active {
    background-color: #e2e6ea;
}

/* SVG colores */
.mesa-svg.svg-verde {
    fill: #28a745;
}

.mesa-svg.svg-amarillo {
    fill: #ffc107;
}

.mesa-svg.svg-rojo {
    fill: #dc3545;
}

.mesa-svg.svg-gris {
    fill: #6c757d;
}

/* Más espacio en botones de piso */
.btn-group > button {
    min-width: 80px;
    min-height: 48px;
    font-size: 1.2rem;
}

    .btn-mesa-libre {
        background-color: #28a745; /* verde */
        color: white;
        border: none;
    }

    .btn-mesa-ocupada {
        background-color: #ffc107; /* amarillo */
        color: black;
        border: none;
    }

    .btn-mesa-reservada {
        background-color: #dc3545; /* rojo */
        color: white;
        border: none;
    }

    .mesa-svg path {
        fill: currentColor; /* para que tome el color de texto del botón */
    }

/* Evitar hover innecesario */


</style>
