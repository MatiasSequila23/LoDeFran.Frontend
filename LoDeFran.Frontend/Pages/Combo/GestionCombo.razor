@page "/combo/gestioncombo/{ComboId:int}"
@inject Services.ComboService ComboService
@inject Services.ProductoService ProductoService
@inject Services.CategoriaProductoService CategoriaProducto
@inject NavigationManager Nav
@using LoDeFran.Frontend.Models
@using System.Globalization


<h3>Gestión de Combo</h3>

<EditForm Model="@Combo" OnValidSubmit="GuardarCambios">
    <div class="row">
        <div class="col-md-6">
            <label>Nombre</label>
            <InputText class="form-control" @bind-Value="Combo.Nombre" />
        </div>
        <div class="col-md-6">
            <label>Precio</label>
            <InputNumber class="form-control" @bind-Value="Combo.Precio" />
        </div>
    </div>

    <div class="mt-3">
        <label>Descripción</label>
        <InputTextArea class="form-control" @bind-Value="Combo.Descripcion" />
    </div>

    <button class="btn btn-primary mt-3" type="submit">Guardar Cambios</button>
</EditForm>

<hr />

<h5>Items del Combo</h5>

<ul class="nav nav-tabs mt-4" role="tablist">
    @foreach (var categoriaId in ProductosPorCategoria.Keys)
    {
        var nombreCategoria = CategoriasDisponibles.FirstOrDefault(c => c.Id == categoriaId)?.Nombre ?? "Sin nombre";
        <li class="nav-item">
            <a class="nav-link @(CategoriaSeleccionada == categoriaId ? "active" : "")"
               @onclick="() => CategoriaSeleccionada = categoriaId"
               href="javascript:void(0)">
                @nombreCategoria
            </a>
        </li>
    }
</ul>

@if (CategoriaSeleccionada.HasValue && ProductosPorCategoria.TryGetValue(CategoriaSeleccionada.Value, out var productos))
{
    <div class="row mt-3">
        @foreach (var producto in productos)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="card-title">@producto.Nombre</h6>
                        <p class="card-text">@producto.Precio.ToString("C", new CultureInfo("es-AR"))</p>
                        <button class="btn btn-sm btn-primary" @onclick="() => AgregarProducto(producto)">
                            Agregar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

  
}

<table class="table table-sm mt-4">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Combo.Items)
        {
            var prod = ProductosDisponibles.FirstOrDefault(p => p.Id == item.ProductoId);
            <tr>
                <td>@prod?.Nombre</td>
                <td>
                    <input type="number" class="form-control form-control-sm"
                           @bind="item.Cantidad" min="1" />
                </td>
                <td>
                    <button class="btn btn-sm btn-danger" @onclick="() => QuitarProducto(item.ProductoId)">Quitar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public int ComboId { get; set; }

    private ComboViewModel Combo = new();
    private List<ProductoViewModel> ProductosDisponibles = new();
    private List<CategoriaProductoViewModel> CategoriasDisponibles = new();
    private int? CategoriaSeleccionada;

    
    protected override async Task OnInitializedAsync()
    {
        Combo = await ComboService.GetByIdAsync(ComboId);
        ProductosDisponibles = await ProductoService.GetProductosAsync();
        CategoriasDisponibles = await CategoriaProducto.GetCategoriasProductosAsync();

        CategoriaSeleccionada = CategoriasDisponibles.FirstOrDefault()?.Id;
    }

    private async Task GuardarCambios()
    {
        await ComboService.UpdateAsync(Combo);
    }

    private void AgregarProducto(ProductoViewModel producto)
    {
        if (!Combo.Items.Any(i => i.ProductoId == producto.Id))
        {
            Combo.Items.Add(new ComboItemViewModel
                {
                    ProductoId = producto.Id,
                    Cantidad = 1
                });
        }
    }

    private void QuitarProducto(int productoId)
    {
        Combo.Items.RemoveAll(i => i.ProductoId == productoId);
    }

    private Dictionary<int, List<ProductoViewModel>> ProductosPorCategoria =>
        ProductosDisponibles
            .Where(p => p.CategoriaProductoId.HasValue)
            .GroupBy(p => p.CategoriaProductoId.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());
}
